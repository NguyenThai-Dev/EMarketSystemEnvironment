<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating Chat Panel — nằm trong WindowManager overlay,
  slide-up khi mở, slide-down khi đóng.
  Fixed width/height, bo góc đẹp, có drag handle ở header.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatPanelCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="24dp"
    app:cardBackgroundColor="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatPopupRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <!-- ─── Header with drag handle ─── -->
        <LinearLayout
            android:id="@+id/layoutChatHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Drag handle pill -->
            <View
                android:id="@+id/dragHandle"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_drag_handle"
                android:clickable="false" />

            <!-- Header content row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <!-- Bot avatar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:cardCornerRadius="50dp"
                    app:cardBackgroundColor="@color/primary_container"
                    app:strokeWidth="0dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/primary" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trợ lý AI EMarket"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View
                            android:id="@+id/dotStatus"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/shape_circle_white"
                            android:backgroundTint="@color/success"
                            android:layout_marginEnd="5dp" />
                        <TextView
                            android:id="@+id/tvStatusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang hoạt động"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Nút mở AI Advisor Hub -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAdvisorHub"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Cố vấn"
                    android:textSize="11sp"
                    android:textColor="@color/primary"
                    android:layout_marginEnd="4dp"
                    app:backgroundTint="@color/primary_container" />

                <!-- Nút đóng popup -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseChat"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:icon="@drawable/ic_close"
                    app:iconTint="@color/text_secondary"
                    android:contentDescription="Đóng chat" />

            </LinearLayout>
        </LinearLayout>

        <!-- ─── Messages RecyclerView ─── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/layoutChatHeader"
            app:layout_constraintBottom_toTopOf="@id/layoutThinking"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_chat_message" />

        <!-- ─── Thinking/typing indicator ─── -->
        <LinearLayout
            android:id="@+id/layoutThinking"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/layoutChatInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:cardCornerRadius="50dp"
                app:cardBackgroundColor="@color/primary_container"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/primary" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/chat_bot_bg"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/primary"
                    app:trackColor="@color/primary_container"
                    app:trackCornerRadius="4dp" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ─── Input toolbar ─── -->
        <LinearLayout
            android:id="@+id/layoutChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Quick Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="2dp">
                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPromptStock"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hàng sắp hết kho" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPromptTopSales"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top 5 bán chạy" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPromptExpiry"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rủi ro cận hạn" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Input row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="16dp">

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_input"
                    android:hint="Hỏi trợ lý AI..."
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:imeOptions="actionSend"
                    android:singleLine="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSend"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    app:icon="@drawable/ic_send"
                    app:iconTint="@color/white"
                    app:backgroundTint="@color/primary"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Large"
                    android:contentDescription="Gửi tin nhắn" />

            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
