                window.sendMessage = function () {
                    var txt = $('#ai-user-input').val().trim();
                    if (!txt) return;

                    appendMessage(txt, 'user');
                    $('#ai-user-input').val('');
                    showLoading();

                    $.ajax({
                        url: EXTERNAL_AI_URL,
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ prompt: txt, userName: window.CURRENTUSERNAME }),
                        timeout: 10000,
                        success: function (res) {
                            removeLoading();
                            let rawContent = res.answer || res.response || res;
                            let htmlContent = window.marked ? marked.parse(rawContent) : rawContent;
                            appendMessage(htmlContent, 'bot');
                        },
                        error: function () {
                            removeLoading();
                            if (xhr.status === 429) {
                                appendMessage("Mình sống chậm lại chút nhé.", 'bot');
                            } else {
                                appendMessage("Lỗi kết nối AI.", 'bot');
                            }
                        }
                    });
                };



                window.loadChart = function (productId = null) {
                    var pId = productId || $('#selectProduct').val();
                    var endDate = new Date($('#startDate').val());
                    endDate.setMonth(endDate.getMonth() - 2);
                    if (!pId) return;
                    if ($('#selectProduct').length) $('#selectProduct').val(pId).trigger('change');
                    $('#chart-loading').show();
                    $('#salesChart').css('opacity', 0.3);
                    if ($('#ai-insights').length) $('#ai-insights').hide();
                    // 1. Khai báo 2 Request gọi song song
                    var historyReq = $.get('/Admin/AIAnalysis/GetProductHistory', {
                        productId: pId,
                        branchId: $("#ddlBranch").val() || 1,
                        startDate: endDate.toISOString().split('T')[0],
                        endDate: $('#startDate').val(),
                    });

                    // Lấy dự báo bán hàng (AI Forecast)
                    var forecastReq = $.get('/Admin/AIAnalysis/GetSalesForecast', {
                        productId: pId,
                        branchId: $("#ddlBranch").val() || 1,
                    });

                    $.when(historyReq, forecastReq)
                        .done(function (resHistory, resForecast) {
                            $('#chart-loading').hide();
                            $('#salesChart').css('opacity', 1);
                            var history = resHistory[0];
                            var forecast = resForecast[0];
                            if (!history.success) return;

                            // --- Xử lý dữ liệu Lịch sử ---
                            var historyPoints = (history.data || [])
                                .map((item) => {
                                    var timestamp = parseInt(item.Date.replace(/\/Date\((-?\d+)\)\//, '$1'));
                                    return [timestamp, item.Qty];
                                })
                                .sort((a, b) => a[0] - b[0]);

                            var forecastPoints = [];

                            if (forecast.success && forecast.data) {
                                forecastPoints = forecast.data
                                    .map((item) => {

                                        var timestamp = item.ForecastDate
                                            ? new Date(parseInt(item.ForecastDate.replace(/\/Date\((-?\d+)\)\//, '$1'))).getTime()
                                            : 0;

                                        return [timestamp, item.PredictedQty];
                                    })
                                    .sort((a, b) => a[0] - b[0]);

                                // Mẹo nối điểm cuối lịch sử vào đầu dự báo để biểu đồ không bị "đứt gãy"

                                if (historyPoints.length > 0 && forecastPoints.length > 0) {
                                    forecastPoints.unshift(historyPoints[historyPoints.length - 1]);
                                }
                            }

                            if (window.updateInsights) updateInsights(historyPoints);

                            renderDualApexChart(historyPoints, forecastPoints);
                        })
                        .fail(function () {
                            $('#chart-loading').hide();
                            $('#salesChart').css('opacity', 1);
                            console.error('Lỗi khi tải dữ liệu phân tích AI');
                        });
                };

                function renderDualApexChart(historyData, forecastData) {
                    var options = {
                        // 1. Cấu hình 2 Series riêng biệt

                        series: [
                            {
                                name: 'Thực tế (Quá khứ)',
                                data: historyData,
                            },
                            {
                                name: 'Dự báo (AI)',
                                data: forecastData,
                            },
                        ],

                        chart: {
                            type: 'area',
                            height: 420,
                            fontFamily: 'Nunito, sans-serif',
                            animations: { enabled: false }, // Tắt hiệu ứng để render nhanh
                            toolbar: { show: true },
                        },
                        dataLabels: { enabled: false },
                        // 2. Kỹ thuật tạo nét đứt (Dash)
                        stroke: {
                            curve: 'smooth',
                            width: 3,
                            // [0] = nét liền cho series 1 (History)
                            // [5] = nét đứt 5px cho series 2 (Forecast)
                            dashArray: [0, 5],
                        },
                        // 3. Màu sắc phân biệt
                        colors: ['#6f42c1', '#2ecc71'], // Tím (Lịch sử) - Xanh lá (Dự báo)
                        // 4. Hiệu ứng tô màu nền (Fill)
                        fill: {
                            type: ['gradient', 'solid'], // Series 1 dùng Gradient, Series 2 dùng Solid
                            gradient: {
                                shadeIntensity: 1,
                                opacityFrom: 0.6,
                                opacityTo: 0.1,
                                stops: [0, 100],
                            },
                            solid: {
                                opacity: 0.1, // Để dự báo mờ mờ thôi cho đỡ rối
                            },
                        },

                        xaxis: {
                            type: 'datetime',
                            tooltip: { enabled: false },
                        },

                        yaxis: {
                            labels: {
                                formatter: function (val) {
                                    return val.toFixed(0); // Làm tròn số lượng
                                },
                            },
                        },

                        tooltip: {
                            x: { format: 'dd MMM yyyy' },
                            shared: true, // QUAN TRỌNG: Di chuột vào 1 điểm hiện cả 2 giá trị để so sánh
                            intersect: false,
                        },

                        grid: { borderColor: '#f1f1f1' },
                        legend: { position: 'top', horizontalAlign: 'right' },
                    };

                    // Render lại Chart
                    if (chartInstance) {
                        chartInstance.destroy();
                    }
                    chartInstance = new ApexCharts(document.querySelector('#salesChart'), options);
                    chartInstance.render();
                }


