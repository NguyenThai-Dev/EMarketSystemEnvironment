                function appendMessage(html, sender) {
                    var msgClass = sender === 'bot' ? 'ai-bot' : 'ai-user';
                    var ava = sender === 'bot' ? '<div class="ai-avatar"><i class="fas fa-robot"></i></div>' : '<div class="ai-avatar"><i class="fas fa-user"></i></div>';
                    $('#ai-chat-body').append(`<div class="ai-message ${msgClass}">${ava}<div class="ai-bubble">${html}</div></div>`);

                    var $body = $('#ai-chat-body');
                    $body.animate({ scrollTop: $body.prop("scrollHeight") }, 300, 'swing');
                }

                function showLoading() {
                    $('#ai-chat-body').append('<div id="loading" class="ai-message ai-bot"><div class="ai-avatar"><i class="fas fa-robot"></i></div><div class="ai-bubble"><div class="loading-dots"><div></div><div></div><div></div></div></div></div>');
                    var $body = $('#ai-chat-body');
                    $body.animate({ scrollTop: $body.prop("scrollHeight") }, 300, 'swing');
                }

                function removeLoading() {
                    $('#loading').remove();
                }

                // === POPUP RỦI RO TÀI CHÍNH CHUYÊN DỤNG ===
                window.openLotRiskPopup = function () {
                    var data = window.tempLotRiskData || [];
                    var s = window.tempLotRiskSummary || {};
                    var fmtMoney = function(v) { return (v || 0).toLocaleString('vi-VN') + ' ₫'; };

                    if ($('#aiLotRiskModal').length === 0) {
                        $('body').append(`
                            <div class="modal fade" id="aiLotRiskModal" tabindex="-1">
                                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                    <div class="modal-content">
                                        <div class="modal-header" style="background:linear-gradient(135deg,#1a202c,#2d3748);border:none;">
                                            <h5 class="modal-title" style="color:#fff;font-weight:700;">💰 Báo cáo Rủi ro Tài chính (FEFO)</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body" style="background:#f8f9fa;" id="lotRiskModalBody"></div>
                                        <div class="modal-footer" style="border-top:1px solid #e2e8f0;">
                                            <small class="text-muted me-auto" id="lotRiskTimestamp"></small>
                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                                        </div>
                                    </div>
                                </div>
                            </div>`);
                    }

                    // Build KPI cards
                    var kpiHtml = `
                        <div class="provision-total">
                            <div class="label">Tổng trích lập dự phòng</div>
                            <div class="amount">${fmtMoney(s.TotalProvisionValue)}</div>
                        </div>
                        <div class="risk-kpi-grid">
                            <div class="risk-kpi-card danger">
                                <div class="kpi-value">${s.DangerCount || 0}</div>
                                <div class="kpi-label">Nguy hiểm</div>
                            </div>
                            <div class="risk-kpi-card warning">
                                <div class="kpi-value">${s.WarningCount || 0}</div>
                                <div class="kpi-label">Cảnh báo</div>
                            </div>
                            <div class="risk-kpi-card safe">
                                <div class="kpi-value">${s.SafeCount || 0}</div>
                                <div class="kpi-label">An toàn</div>
                            </div>
                        </div>`;

                    // Build detail table
                    var tableHtml = `<table class="table table-striped table-hover mb-0" style="font-size:13px;">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm / Lô</th>
                                <th style="text-align:center;">Tồn</th>
                                <th style="text-align:center;">Rủi ro</th>
                                <th style="text-align:center;">Còn (ngày)</th>
                                <th style="text-align:right;">Thiệt hại (₫)</th>
                                <th style="text-align:center;">Trạng thái</th>
                            </tr>
                        </thead><tbody>`;

                    data.forEach(x => {
                        var statusBadge = x.LotStatus === 'DANGER' || x.LotStatus === 'EXPIRED'
                            ? `<span class="badge badge-critical"> ${x.LotStatus}</span>`
                            : (x.LotStatus === 'WARNING'
                                ? `<span class="badge badge-high">${x.LotStatus}</span>`
                                : `<span class="badge badge-normal">${x.LotStatus}</span>`);

                        var rowStyle = x.ProvisionValue > 0 ? 'style="background:rgba(245,101,101,0.04);"' : '';

                        tableHtml += `<tr ${rowStyle}>
                            <td><b>${x.ProductName}</b><br><small class="text-muted">${x.LotId}</small><br><small>${x.Recommendation}</small></td>
                            <td style="text-align:center;">${x.Quantity}</td>
                            <td style="text-align:center;" class="${x.RiskQty > 0 ? 'text-danger' : ''}">${x.RiskQty}</td>
                            <td style="text-align:center;" class="${x.DaysToExpiry < 15 ? 'text-danger' : ''}">${x.DaysToExpiry}</td>
                            <td style="text-align:right;font-weight:600;" class="${x.ProvisionValue > 0 ? 'text-danger' : 'text-success'}">${fmtMoney(x.ProvisionValue)}</td>
                            <td style="text-align:center;">${statusBadge}</td>
                        </tr>`;
                    });
                    tableHtml += `</tbody></table>`;

                    $('#lotRiskModalBody').html(kpiHtml + tableHtml);
                    $('#lotRiskTimestamp').text('Dữ liệu lúc: ' + (window.tempLotRiskSummary.generatedAt || new Date().toLocaleString('vi-VN')));

                    var modal = new bootstrap.Modal(document.getElementById('aiLotRiskModal'));
                    modal.show();
                };

                $('#ai-user-input').off('keypress').on('keypress', function (e) {
                    if (e.which == 13) {
                        e.preventDefault();
                        sendMessage();
                    }
                });
            });
        });
    })();
</script>