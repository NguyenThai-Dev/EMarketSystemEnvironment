@{
    ViewBag.Title = "PurchaseOrderList";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content">
        <div class="page-header">
            <div class="page-title">
                <h4>DANH SÁCH NHẬP HÀNG</h4>
                <h6>Quản lý danh sách nhập hàng của bạn</h6>
            </div>
            <div class="page-btn">
                <a href="javascript:void(0);" onclick="openAddModal()" class="btn btn-added">
                    <img src="~/assets/img/icons/plus.svg" alt="img" />Tạo phiếu nhập hàng
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-top">
