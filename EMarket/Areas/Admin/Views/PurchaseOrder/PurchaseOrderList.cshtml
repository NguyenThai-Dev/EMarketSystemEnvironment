                    <div class="card-body pb-0">
                        <div class="row">

                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    <select id="ddlSupplier" class="select form-control">
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    <select id="ddlBranch" class="select form-control">
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg col-sm-6 col-12">
