@{
    ViewBag.Title = "People & Customer Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content container-fluid">

        <div class="page-header mb-4 mt-3">
            <div class="row align-items-center">
                <div class="col">
                    <h3 class="fw-bold text-dark display-6 fs-3">Trung Tâm Người Dùng</h3>
                    <p class="text-muted mb-0">Tổng quan dữ liệu Khách hàng & Nhân sự</p>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6 col-12">
                <div class="card h-100 gradient-1 card-hover shadow-sm">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-white-50 text-uppercase fw-bold mb-1 fs-7">Tổng Khách Hàng</h6>
                                <h3 id="kpiTotalCust" class="text-white mb-0 fw-bold display-6 fs-2">0</h3>
                            </div>
                            <div class="icon-circle bg-white bg-opacity-25">
                                <i class="fas fa-users text-white"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <span class="badge bg-white text-primary rounded-pill px-3 py-2">
                                <i class="fas fa-arrow-up me-1"></i> <span id="kpiCustGrowth">0%</span> tháng này
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 col-12">
                <div class="card h-100 gradient-2 card-hover shadow-sm">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-white-50 text-uppercase fw-bold mb-1 fs-7">Thành viên VIP</h6>
                                <h3 id="kpiVipCust" class="text-white mb-0 fw-bold display-6 fs-2">0</h3>
                            </div>
                            <div class="icon-circle bg-white bg-opacity-25">
                                <i class="fas fa-crown text-white"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-white-50"><i class="fas fa-star me-1"></i>Điểm tích lũy cao</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 col-12">
                <div class="card h-100 bg-white border-0 shadow-sm card-hover">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-muted text-uppercase fw-bold mb-1 fs-7">Đăng ký mới (7 ngày)</h6>
                                <h3 id="kpiNewUsers" class="text-dark mb-0 fw-bold display-6 fs-2">0</h3>
                            </div>
                            <div class="kpi-chart-container">
                                <div id="newUsersSparkline"></div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-muted"><i class="fas fa-info-circle me-1"></i>Cả khách & nhân viên</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 col-12">
                <div class="card h-100 gradient-3 card-hover shadow-sm">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="text-white-50 text-uppercase fw-bold mb-1 fs-7">Nhân sự</h6>
                                <h3 id="kpiTotalEmp" class="text-white mb-0 fw-bold display-6 fs-2">0</h3>
                            </div>
                            <div class="icon-circle bg-white bg-opacity-25">
                                <i class="fas fa-user-tie text-white"></i>
                            </div>
                        </div>
                        <div class="mt-3 d-flex align-items-center">
                            <div class="user-stack" id="activeUserAvatars">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-xl-4 col-lg-5 d-flex">
                <div class="card flex-fill w-100 shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-0 pt-4 pb-2">
                        <h5 class="card-title fw-bold mb-0">Phân khúc</h5>
                        <small class="text-muted">Tỷ lệ hạng thành viên</small>
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center" style="min-height: 300px;">
                        <div id="customerSegmentChart" class="w-100"></div>
                    </div>
                </div>
            </div>

            <div class="col-xl-8 col-lg-7 d-flex">
                <div class="card flex-fill w-100 shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title fw-bold mb-0">Tăng trưởng</h5>
                            <small class="text-muted">Người dùng mới trong năm</small>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-light btn-sm rounded-circle"><i class="fas fa-ellipsis-h"></i></button>
                        </div>
                    </div>
                    <div class="card-body" style="min-height: 300px;">
                        <div id="userGrowthChart" class="h-100"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8 d-flex">
                <div class="card h-100 flex-fill w-100 shadow-sm border-0">
                    <div class="card-header bg-white border-0 pt-4 pb-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title fw-bold mb-0">Top Khách Thân Thiết</h5>
                        <a href="@Url.Action("CustomerList", "Customer", new { area = "Admin" })" class="btn btn-sm btn-soft-primary fw-bold rounded-pill">
                            Xem tất cả <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive h-100">
                            <table class="table table-hover align-middle mb-0" id="tblTopCustomers">
                                <thead class="bg-light text-muted">
                                    <tr>
                                        <th class="ps-4 py-3">Khách hàng</th>
                                        <th class="py-3">Hạng</th>
                                        <th class="py-3">Liên hệ</th>
                                        <th class="text-end pe-4 py-3">Điểm tích lũy</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 d-flex">
                <div class="card h-100 flex-fill w-100 shadow-sm border-0">
                    <div class="card-header bg-white border-0 pt-4 pb-3">
                        <h5 class="card-title fw-bold mb-0">Vai trò Nhân sự</h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div id="roleDistributionList" class="flex-grow-1 overflow-auto" style="max-height: 300px;">
                        </div>
                        <div class="mt-auto pt-3 text-center border-top">
                            <a href="@Url.Action("UserList", "User", new { area = "Admin" })" class="btn btn-primary w-100 rounded-pill">
                                <i class="fas fa-user-cog me-1"></i> Quản lý phân quyền
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Styles {
    <style>
        /* === GLOBAL UTILS === */
        .fs-7 {
            font-size: 0.75rem;
        }

        .fs-2 {
            font-size: 2rem;
        }

        .fw-bold {
            font-weight: 600 !important;
        }

        .btn-soft-primary {
            background: rgba(64, 153, 255, 0.1);
            color: #4099ff;
        }

            .btn-soft-primary:hover {
                background: #4099ff;
                color: #fff;
            }

        /* === CARDS & GRADIENTS === */
        .card {
            border-radius: 12px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .card-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

        .gradient-1 {
            background: linear-gradient(135deg, #4099ff 0%, #73b4ff 100%);
            border: none;
        }

        .gradient-2 {
            background: linear-gradient(135deg, #FF5370 0%, #ff869a 100%);
            border: none;
        }

        .gradient-3 {
            background: linear-gradient(135deg, #2ed8b6 0%, #59e0c5 100%);
            border: none;
        }

        /* === KPI ICONS === */
        .icon-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .kpi-chart-container {
            width: 80px;
            height: 40px;
            display: flex;
            align-items: center;
        }

        /* === AVATAR STACK === */
        .user-stack {
            display: flex;
            padding-left: 10px;
        }

            .user-stack img {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                border: 2px solid #fff;
                margin-left: -12px;
                object-fit: cover;
                transition: transform 0.2s;
            }

                .user-stack img:hover {
                    transform: translateY(-3px) scale(1.1);
                    z-index: 10;
                    cursor: pointer;
                }

        /* === TABLE & LISTS === */
        .table thead th {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-weight: 700;
        }

        /* Badges */
        .badge-vip {
            background: #FF5370;
            color: #fff;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .badge-member {
            background: #4099ff;
            color: #fff;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .badge-normal {
            background: #e9ecef;
            color: #495057;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        /* Role Progress */
        .role-item {
            margin-bottom: 18px;
        }

        .role-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.9rem;
            margin-bottom: 6px;
            font-weight: 600;
            color: #555;
        }

        .progress {
            height: 8px;
            border-radius: 10px;
            background-color: #f1f3f5;
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        // ... (Giữ nguyên toàn bộ phần Script JS của bro, chỉ lưu ý ID các element vẫn giữ nguyên)
        // ... Code JS cũ ...

        let customerSegmentChart = null;
        let userGrowthChart = null;
        let usersSparkline = null;
        const DEFAULT_AVATAR = '/assets/img/logo-black.png';

        $(document).ready(function () {
            loadDashboardData();
        });

        async function loadDashboardData() {
            try {
                const res = await $.ajax({
                    url: '/Admin/Admin/GetPeopleDashboardData',
                    type: 'GET'
                });

                if (!res || !res.success) return;

                renderKpi(res.data.Kpi);
                renderCharts(res.data.Charts);
                renderTopCustomers(res.data.Lists.TopCustomers);
                renderRoleStats(res.data.Lists.RoleStats);

            } catch (err) {
                console.error('Load dashboard failed', err);
            }
        }

        // ... (Copy lại toàn bộ các hàm render phía dưới của bro vào đây) ...
        // Lưu ý hàm renderKpi, renderCharts, renderTopCustomers, renderRoleStats giữ nguyên logic

        function renderKpi(kpi) {
            $('#kpiTotalCust').text(kpi.TotalCustomers);
            $('#kpiCustGrowth').text(kpi.CustomerGrowth + '%');
            $('#kpiVipCust').text(kpi.VipCount);
            $('#kpiTotalEmp').text(kpi.ActiveEmployees);
            $('#kpiNewUsers').text(kpi.NewRegistrations);

            const $avatarBox = $('#activeUserAvatars');
            $avatarBox.empty();

            if (!kpi.RecentUserAvatars || !kpi.RecentUserAvatars.length) return;

            kpi.RecentUserAvatars.forEach(img => {
                const src = img && img.trim() !== '' ? img : DEFAULT_AVATAR;
                $avatarBox.append(`<img src="${src}" title="Nhân viên mới" />`);
            });
        }

        function renderTopCustomers(customers) {
            const $tbody = $('#tblTopCustomers tbody');
            $tbody.empty();
            if (!customers || !customers.length) {
                $tbody.append('<tr><td colspan="4" class="text-center py-4 text-muted">Chưa có dữ liệu</td></tr>');
                return;
            }
            customers.forEach(c => {
                const avatar = c.Avatar ? c.Avatar : DEFAULT_AVATAR;
                const badge = c.Type === 'VIP' ? 'badge-vip' : c.Type === 'Member' ? 'badge-member' : 'badge-normal';

                $tbody.append(`
                    <tr>
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="${avatar}" class="rounded-circle shadow-sm" width="40" height="40">
                                <div>
                                    <div class="fw-bold text-dark">${c.Name}</div>
                                    <small class="text-muted" style="font-size:0.75rem">${c.Email}</small>
                                </div>
                            </div>
                        </td>
                        <td class="py-3"><span class="${badge}">${c.Type}</span></td>
                        <td class="py-3 text-muted">${c.Phone}</td>
                        <td class="text-end pe-4 py-3"><span class="fw-bold text-primary">${c.Points}</span></td>
                    </tr>
                `);
            });
        }

        function renderRoleStats(roles) {
            const $box = $('#roleDistributionList');
            $box.empty();
            if (!roles || !roles.length) {
                $box.append('<p class="text-center text-muted py-3">Chưa có dữ liệu</p>');
                return;
            }
            // Màu sắc ngẫu nhiên cho progress bar sinh động hơn
            const colors = ['bg-primary', 'bg-success', 'bg-warning', 'bg-info', 'bg-danger'];

            roles.forEach((r, idx) => {
                const percent = Math.round((r.Count / r.TotalUsers) * 100);
                const colorClass = colors[idx % colors.length];

                $box.append(`
                    <div class="role-item">
                        <div class="role-label">
                            <span>${r.RoleName}</span>
                            <span class="text-muted small">${r.Count} (${percent}%)</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar ${colorClass}" style="width:${percent}%"></div>
                        </div>
                    </div>
                `);
            });
        }

        function renderCharts(charts) {
            // ... (Giữ nguyên logic render charts của bro) ...
            if (!charts) return;

            const segmentEl = document.querySelector('#customerSegmentChart');
            const growthEl = document.querySelector('#userGrowthChart');
            const usersSparkEl = document.querySelector('#newUsersSparkline');

            if (!segmentEl || !growthEl || !usersSparkEl) return;

            if (customerSegmentChart) customerSegmentChart.destroy();
            if (userGrowthChart) userGrowthChart.destroy();
            if (usersSparkline) usersSparkline.destroy();

            // 1. CUSTOMER SEGMENT (DONUT)
            customerSegmentChart = new ApexCharts(segmentEl, {
                chart: { type: 'donut', height: 260, fontFamily: 'inherit' },
                series: charts.CustomerSegments.map(x => x.Count),
                labels: charts.CustomerSegments.map(x => x.Label),
                legend: { position: 'bottom', fontSize: '13px' },
                dataLabels: { enabled: false },
                plotOptions: { pie: { donut: { size: '65%' } } },
                colors: ['#e9ecef', '#FF5370', '#4099ff'] // Normal, VIP, Member
            });
            customerSegmentChart.render();

            // 2. USER GROWTH (AREA)
            userGrowthChart = new ApexCharts(growthEl, {
                chart: { type: 'area', height: 300, toolbar: { show: false }, fontFamily: 'inherit' },
                series: [
                    { name: 'Khách hàng', data: charts.Growth.Customers },
                    { name: 'Nhân viên', data: charts.Growth.Employees }
                ],
                stroke: { curve: 'smooth', width: 2 },
                dataLabels: { enabled: false },
                xaxis: { categories: charts.Growth.Labels, axisBorder: { show: false }, axisTicks: { show: false } },
                yaxis: { show: false }, // Ẩn trục Y cho gọn
                grid: { strokeDashArray: 4, padding: { left: 10, right: 0 } },
                colors: ['#4099ff', '#2ed8b6'],
                fill: { type: 'gradient', gradient: { opacityFrom: 0.4, opacityTo: 0.05 } }
            });
            userGrowthChart.render();

            // 3. KPI SPARKLINE
            const sparklineData = charts.Growth.Customers.map((val, idx) => val + (charts.Growth.Employees[idx] || 0));
            usersSparkline = new ApexCharts(usersSparkEl, {
                series: [{ data: sparklineData }],
                chart: { type: 'bar', height: 40, width: 80, sparkline: { enabled: true } },
                plotOptions: { bar: { borderRadius: 2, columnWidth: '60%' } },
                colors: ['#fd7e14'],
                tooltip: { fixed: { enabled: false }, x: { show: false }, y: { title: { formatter: () => '' } } }
            });
            usersSparkline.render();
        }

    </script>
}