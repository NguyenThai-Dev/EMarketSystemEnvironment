@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content container-fluid">

        <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4 mt-3">
            <div class="mb-2">
                <h3 class="fw-bold text-dark">Dashboard Quản Trị Trung Tâm</h3>
                <span class="text-muted">Báo cáo hiệu quả kinh doanh & kiểm soát rủi ro toàn chuỗi.</span>
            </div>

            <div style="min-width: 250px;">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-0"><i class="fas fa-store text-primary"></i></span>
                    <select id="BranchFilter" class="form-select border-0 bg-white" style="cursor: pointer;">
                        <option value="">Đang tải chi nhánh...</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-3 col-md-6">
                <div class="card card-hover">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-label">Tổng doanh thu</span>
                                <h3 id="spTotalSales" class="h3-counter mt-2 text-dark">0</h3>
                            </div>
                            <div class="icon-shape bg-light-primary">
                                <i class="fas fa-wallet"></i>
                            </div>
                        </div>
                        <div class="mt-3 text-muted small">
                            <span class="fw-bold">Tiền hàng nhập:</span> <span id="spTotalPurchase" class="text-dark">0</span> đ
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card card-hover border-start border-4 border-success">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-label text-success">Lợi nhuận thực tế</span>
                                <h3 id="spActualProfit" class="h3-counter mt-2 text-success">0</h3>
                            </div>
                            <div class="icon-shape bg-light-success">
                                <i class="fas fa-hand-holding-usd"></i>
                            </div>
                        </div>
                        <div class="mt-3 text-muted small">
                            <span class="fw-bold">Lãi gộp:</span> <span id="spGrossProfit" class="text-dark">0</span> đ
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card card-hover border-start border-4 border-danger">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-label text-danger">Thất thoát (Hết hạn)</span>
                                <h3 id="spInventoryLoss" class="h3-counter mt-2 text-danger">0</h3>
                            </div>
                            <div class="icon-shape bg-light-danger">
                                <i class="fas fa-trash-alt"></i>
                            </div>
                        </div>
                        <div class="mt-3 text-muted small">
                            <span class="fw-bold">Chiếm:</span> <span id="spLossRate" class="text-danger fw-bold">0</span>% Lãi gộp
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="card card-hover border-start border-4 border-warning">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-label text-warning">Mã sắp hết hàng</span>
                                <h3 id="spLowStock" class="h3-counter mt-2 text-warning">0</h3>
                            </div>
                            <div class="icon-shape" style="background-color: rgba(255, 193, 7, 0.15); color: #ffc107;">
                                <i class="fas fa-boxes"></i>
                            </div>
                        </div>
                        <div class="mt-3 text-muted small">
                            <span class="fw-bold">Tổng tồn:</span> <span id="spTotalInventory" class="text-dark">0</span> đ/vị
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8 d-flex">
                <div class="card flex-fill w-100">
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pt-4 pb-2">
                        <h5 class="card-title fw-bold mb-0">Phân bố tồn kho</h5>
                    </div>
                    <div class="card-body">
                        <div id="stockChart" height="120"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 d-flex">
                <div class="card flex-fill w-100">
                    <div class="card-header bg-white border-0 pt-4 pb-2">
                        <h5 class="card-title fw-bold mb-0">Top Chi Nhánh</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table id="tblBranchDashboard" class="table table-hover table-borderless mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Chi nhánh</th>
                                        <th class="text-end">Doanh thu</th>
                                        <th class="text-end">Nhập hàng</th>
                                        <th class="text-center">Cảnh báo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <div class="d-flex flex-wrap justify-content-between align-items-center">
                            <h5 class="card-title fw-bold mb-2">Biểu đồ Doanh thu & Nhập hàng</h5>

                            <div class="d-flex gap-2 align-items-center flex-wrap">
                                <div style="width: 200px;">
                                    <select id="TimeRange" class="form-select form-select-sm shadow-none bg-light border-0">
                                        <option value="today">Hôm nay</option>
                                        <option value="yesterday">Hôm qua</option>
                                        <option value="7days">7 ngày qua</option>
                                        <option value="30days" selected>30 ngày qua</option>
                                        <option value="this_month">Tháng này</option>
                                        <option value="this_year">Năm nay</option>
                                        <option value="custom">Tuỳ chọn ngày...</option>
                                    </select>
                                </div>

                                <button class="btn btn-primary btn-sm px-4 shadow-sm" onclick="refreshAllData()">
                                    <i class="fas fa-sync-alt me-1"></i> Làm mới
                                </button>
                            </div>
                        </div>

                        <div id="CustomDateRange" class="row mt-3 d-none bg-light p-2 rounded mx-0">
                            <div class="col-md-5">
                                <label class="small text-muted">Từ ngày</label>
                                <input type="date" id="FromDate" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-5">
                                <label class="small text-muted">Đến ngày</label>
                                <input type="date" id="ToDate" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div id="salesChart" height="80"></div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="https://cdn.jsdelivr.net/npm/dayjs@1/dayjs.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/countup.js@2.6.0/dist/countUp.umd.js"></script>
    <script>
        let tblBranch;
        let stockChartInstance;
        let salesChartInstance;
        let requestController;
        let currentUserBranchId = 0;

        $(async function () {
            await getCurrentUserBranch();
            await loadBranches();
            initEmptyTable();
            refreshAllData();

            // --- EVENTS ---
            $('#BranchFilter, #TimeRange').on('change', function () {
                $('#CustomDateRange').toggleClass('d-none', $('#TimeRange').val() !== 'custom');
                if ($('#TimeRange').val() !== 'custom') {
                    refreshAllData();
                }
            });

            $('#FromDate, #ToDate').on('change', function () {
                if ($('#TimeRange').val() === 'custom' && $('#FromDate').val() && $('#ToDate').val()) {
                    refreshAllData();
                }
            });
        });

        async function getCurrentUserBranch() {
            try {
                const resp = await $.ajax({ url: '/Admin/Login/GetCurrentUser', type: 'GET' });
                if (resp.success) { currentUserBranchId = resp.data.BranchId; }
            } catch (error) { console.error("Lỗi khi lấy thông tin user:", error); }
        }

        // --- MAIN FUNCTION: GỘP REQUEST ---
        async function refreshAllData() {
            const branchId = $('#BranchFilter').val();
            const range = resolveDateRange();

            toggleLoadingState(true);

            try {
                const [overviewData, stockData, branchData] = await Promise.all([
                    $.get('/Admin/Admin/Overview', { branchId, fromDate: range.fromDate, toDate: range.toDate, groupBy: range.groupBy }),
                    $.get('/Admin/Admin/GetStockChart', { branchId }),
                    $.get('/Admin/Admin/GetBranchPerformance', { branchId, fromDate: range.fromDate, toDate: range.toDate })
                ]);

                renderKPI(overviewData.Summary);
                renderSalesChart(overviewData.Trend);
                renderStockChart(stockData);
                renderBranchTable(branchData);

            } catch (err) {
                console.error("Lỗi tải dashboard:", err);
            } finally {
                toggleLoadingState(false);
            }
        }

        // --- RENDER FUNCTIONS ---
        function toggleLoadingState(isLoading) {
            if (isLoading) {
                $('#spTotalSales, #spActualProfit, #spInventoryLoss, #spLowStock').addClass('skeleton').text('');
                $('canvas').addClass('chart-loading');
            } else {
                $('#spTotalSales, #spActualProfit, #spInventoryLoss, #spLowStock').removeClass('skeleton');
                $('canvas').removeClass('chart-loading');
            }
        }

        function renderKPI(summary) {
            // Animation cho các số lớn
            animateValue("spTotalSales", summary.TotalSales);
            animateValue("spActualProfit", summary.ActualProfit);
            animateValue("spInventoryLoss", summary.InventoryLossValue);
            animateValue("spLowStock", summary.LowStockProducts);

            // Set text cho các chỉ số phụ (Sub-metrics)
            $('#spTotalPurchase').text(summary.TotalPurchase.toLocaleString());
            $('#spGrossProfit').text(summary.GrossProfit.toLocaleString());
            $('#spTotalInventory').text(summary.TotalInventoryQuantity.toLocaleString());

            // Tính % thất thoát so với lãi gộp
            const lossRate = summary.GrossProfit > 0
                ? ((summary.InventoryLossValue / summary.GrossProfit) * 100).toFixed(1)
                : 0;
            $('#spLossRate').text(lossRate);
        }

        function animateValue(id, value) {
            const element = document.getElementById(id);
            if (!element) return;

            const options = { startVal: 0, duration: 1.5, separator: ',', decimal: '.' };
            let demo = new countUp.CountUp(id, value, options);

            if (!demo.error) {
                demo.start();
            } else {
                $(element).text(value.toLocaleString());
            }
        }

        // [Các hàm renderSalesChart, renderStockChart, initEmptyTable, renderBranchTable, loadBranches, resolveDateRange
        // ĐƯỢC GIỮ NGUYÊN HOÀN TOÀN NHƯ CODE CŨ CỦA BRO]

        function renderSalesChart(trendData) {
            const options = {
                series: [
                    { name: 'Doanh thu', data: trendData.Sales },
                    { name: 'Nhập hàng', data: trendData.Purchases }
                ],
                chart: { height: 350, type: 'area', toolbar: { show: true }, zoom: { enabled: true } },
                colors: ['#28c76f', '#7367f0'],
                dataLabels: { enabled: false },
                stroke: { curve: 'smooth', width: [3, 3], dashArray: [0, 5] },
                fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.1, stops: [0, 90, 100] } },
                xaxis: { categories: trendData.Labels, axisBorder: { show: false }, axisTicks: { show: false } },
                yaxis: { labels: { formatter: function (val) { return val.toLocaleString() + ' đ'; } } },
                tooltip: { shared: true, intersect: false, y: { formatter: function (val) { return val.toLocaleString() + ' VNĐ'; } } },
                legend: { position: 'top', horizontalAlign: 'right' }
            };

            if (salesChartInstance) { salesChartInstance.destroy(); }
            salesChartInstance = new ApexCharts(document.querySelector("#salesChart"), options);
            salesChartInstance.render();
        }

        function renderStockChart(data) {
            const options = {
                series: [
                    { name: 'Số lượng tồn', type: 'column', data: data.map(x => x.Value) },
                    { name: 'Giá trị tồn kho', type: 'line', data: data.map(x => x.ExtraValue) }
                ],
                chart: { height: 340, type: 'line', stacked: false, toolbar: { show: false }, zoom: { enabled: false }, animations: { enabled: true, easing: 'easeinout', speed: 700 } },
                colors: ['#0dcaf0', '#fd7e14'],
                stroke: { width: [0, 5], curve: 'smooth', lineCap: 'round' },
                plotOptions: { bar: { columnWidth: '42%', borderRadius: 6 } },
                fill: { type: ['solid', 'gradient'], gradient: { shade: 'light', type: 'vertical', opacityFrom: 0.7, opacityTo: 0.2, stops: [0, 100] } },
                markers: { size: 4, strokeWidth: 2, strokeColors: '#fff', hover: { size: 6 } },
                xaxis: { categories: data.map(x => x.Label), labels: { rotate: -30, style: { fontSize: '12px', colors: '#6c757d' } }, axisBorder: { show: false }, axisTicks: { show: false } },
                yaxis: [
                    { title: { text: 'Số lượng (cái)', style: { color: '#74c0fc', fontWeight: 600 } }, labels: { formatter: v => v.toLocaleString(), style: { colors: '#6c757d' } } },
                    { opposite: true, title: { text: 'Giá trị tồn kho', style: { color: '#ff922b', fontWeight: 600 } }, labels: { formatter: v => (v / 1_000_000).toFixed(1) + ' M', style: { colors: '#6c757d' } } }
                ],
                tooltip: { shared: true, intersect: false, x: { show: true }, y: [{ formatter: v => v.toLocaleString() + ' cái' }, { formatter: v => v.toLocaleString() + ' VNĐ' }] },
                legend: { position: 'top', horizontalAlign: 'right', fontSize: '13px', markers: { width: 10, height: 10, radius: 3 } },
                grid: { borderColor: '#f1f3f5', strokeDashArray: 4, padding: { left: 10, right: 10 } }
            };

            if (stockChartInstance) { stockChartInstance.destroy(); }
            stockChartInstance = new ApexCharts(document.querySelector("#stockChart"), options);
            stockChartInstance.render();
        }

        function initEmptyTable() {
            tblBranch = $('#tblBranchDashboard').DataTable({
                paging: false, searching: false, info: false,
                columns: [
                    { data: 'Name' },
                    { data: 'SalesAmount', render: $.fn.dataTable.render.number(',', '.', 0) },
                    { data: 'PurchaseAmount', render: $.fn.dataTable.render.number(',', '.', 0) },
                    {
                        data: 'LowStockCount', className: 'text-center',
                        render: function (d) {
                            return d > 0 ? `<span class="badge badge-soft-danger"><i class="fas fa-exclamation-circle"></i> ${d}</span>` : `<span class="badge badge-soft-success">OK</span>`;
                        }
                    }
                ]
            });
        }

        function renderBranchTable(data) {
            tblBranch.clear();
            const list = Array.isArray(data) ? data : (data.data || []);
            tblBranch.rows.add(list).draw();
        }

        async function loadBranches() {
            try {
                const res = await $.get('/Branch/GetAllBranch');
                const branches = Array.isArray(res) ? res : (res.data || []);
                let html = '<option value="">-- Tất cả chi nhánh --</option>';
                branches.forEach(b => html += `<option value="${b.BranchId}">${b.Name}</option>`);
                $('#BranchFilter').html(html);
                if (currentUserBranchId != 0) { $('#BranchFilter').val(currentUserBranchId); }
            } catch (e) { console.error(e); }
        }

        function resolveDateRange() {
            const range = $('#TimeRange').val();
            const today = dayjs();
            let fromDate, toDate;

            if (range === 'custom') {
                fromDate = dayjs($('#FromDate').val()); toDate = dayjs($('#ToDate').val());
            } else {
                switch (range) {
                    case 'today': fromDate = today; toDate = today; break;
                    case 'yesterday': fromDate = today.subtract(1, 'day'); toDate = fromDate; break;
                    case '7days': fromDate = today.subtract(6, 'day'); toDate = today; break;
                    case '30days': fromDate = today.subtract(29, 'day'); toDate = today; break;
                    case 'this_month': fromDate = today.startOf('month'); toDate = today.endOf('month'); break;
                    case 'last_month': fromDate = today.subtract(1, 'month').startOf('month'); toDate = today.subtract(1, 'month').endOf('month'); break;
                    case 'this_year': fromDate = today.startOf('year'); toDate = today.endOf('year'); break;
                    default: fromDate = today; toDate = today;
                }
            }

            const diffDays = toDate.diff(fromDate, 'day') + 1;
            return {
                fromDate: fromDate.format('YYYY-MM-DD'),
                toDate: toDate.format('YYYY-MM-DD'),
                groupBy: diffDays <= 31 ? 'day' : 'month'
            };
        }
    </script>
}

@section Styles {
    <style>
        body { background-color: #f8f9fa; }
        .card { border: none; border-radius: 12px; box-shadow: 0 4px 20px 0 rgba(0,0,0,0.05); transition: all 0.3s ease; margin-bottom: 24px; }
        .card-hover:hover { transform: translateY(-5px); box-shadow: 0 8px 25px 0 rgba(0,0,0,0.1); }
        .icon-shape { width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
        .bg-light-success { background-color: rgba(40, 199, 111, 0.15); color: #28c76f; }
        .bg-light-primary { background-color: rgba(115, 103, 240, 0.15); color: #7367f0; }
        .bg-light-info { background-color: rgba(0, 207, 232, 0.15); color: #00cfe8; }
        .bg-light-danger { background-color: rgba(234, 84, 85, 0.15); color: #ea5455; }
        .text-label { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #6c757d; }
        .h3-counter { font-size: 1.75rem; font-weight: 700; margin-bottom: 0; }
        .table thead th { border-top: none; border-bottom: 2px solid #e9ecef; font-size: 0.85rem; text-transform: uppercase; color: #6c757d; font-weight: 600; }
        .table td { vertical-align: middle; }
        .badge-soft-success { background-color: rgba(40, 199, 111, 0.12) !important; color: #28c76f !important; }
        .badge-soft-danger { background-color: rgba(234, 84, 85, 0.12) !important; color: #ea5455 !important; }
        .badge-pill { padding: 0.35em 0.8em; border-radius: 50rem; font-weight: 600; font-size: 0.8rem; }
        .skeleton { background: #e1e4e8; color: transparent !important; border-radius: 4px; position: relative; overflow: hidden; display: inline-block; width: 100%; min-height: 20px; }
        .skeleton::after { position: absolute; top: 0; right: 0; bottom: 0; left: 0; transform: translateX(-100%); background-image: linear-gradient( 90deg, rgba(255, 255, 255, 0) 0, rgba(255, 255, 255, 0.2) 20%, rgba(255, 255, 255, 0.5) 60%, rgba(255, 255, 255, 0) ); animation: shimmer 2s infinite; content: ''; }
        @@keyframes shimmer { 100% { transform: translateX(100%); } }
        .chart-loading { opacity: 0.5; pointer-events: none; filter: blur(2px); transition: all 0.3s; }
    </style>
}