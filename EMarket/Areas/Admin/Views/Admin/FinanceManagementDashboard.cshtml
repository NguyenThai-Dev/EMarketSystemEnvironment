@{
    ViewBag.Title = "Finance Command Center";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content">

        <div class="page-header mb-4 mt-2">
            <div class="row align-items-center w-100">
                <div class="col">
                    <h3 class="page-title fw-bold text-dark" style="letter-spacing: -0.5px;">
                        <span class="bg-primary-light p-2 rounded-3 me-2">
                            <i class="fas fa-chart-line text-primary"></i>
                        </span>
                        Trung Tâm Tài Chính
                    </h3>
                    <ul class="breadcrumb border-0 mb-0 ps-0 bg-transparent">
                        <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item active">Báo cáo Thu Chi & Hiệu quả</li>
                    </ul>
                </div>

                <div class="col-auto">
                    <div class="d-flex align-items-center bg-white px-3 py-2 rounded-pill shadow-sm border">
                        <div class="d-flex align-items-center pe-3 me-3 border-end">
                            <span class="d-flex align-items-center justify-content-center rounded-circle bg-light me-2"
                                  style="width:28px;height:28px;">
                                <i class="fas fa-store text-muted small"></i>
                            </span>
                            <select id="branchSelect"
                                    class="form-select form-select-sm border-0 shadow-none fw-bold text-dark"
                                    style="min-width:180px; background-color:transparent;">
                                <option value="">Tất cả Chi Nhánh</option>
                            </select>
                        </div>

                        <div class="d-flex align-items-center">
                            <span class="d-flex align-items-center justify-content-center rounded-circle bg-light me-2"
                                  style="width:28px;height:28px;">
                                <i class="far fa-calendar-alt text-muted small"></i>
                            </span>
                            <select id="timeRangeSelect"
                                    class="form-select form-select-sm border-0 shadow-none fw-bold text-primary"
                                    style="min-width:140px; background-color:transparent;">
                                <option value="7">7 ngày qua</option>
                                <option value="30" selected>30 ngày qua</option>
                                <option value="90">Quý này</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-3 col-sm-6 col-12 d-flex">
                <div class="card flex-fill finance-card card-revenue">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="finance-info">
                                <h6 class="text-white-50">Doanh thu thuần</h6>
                                <h3 id="kpiRevenue" class="text-white fw-bold mb-0">0 ₫</h3>
                            </div>
                            <div class="finance-icon bg-white-10">
                                <i class="fas fa-coins"></i>
                            </div>
                        </div>
                        <div class="progress mt-3 bg-white-10" style="height: 4px;">
                            <div class="progress-bar bg-white" style="width: 100%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-sm-6 col-12 d-flex">
                <div class="card flex-fill finance-card card-expense">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="finance-info">
                                <h6 class="text-white-50">Tổng tiền nhập hàng</h6>
                                <h3 id="kpiExpense" class="text-white fw-bold mb-0">0 ₫</h3>
                            </div>
                            <div class="finance-icon bg-white-10">
                                <i class="fas fa-boxes"></i>
                            </div>
                        </div>
                        <div class="mt-3 small text-white-50">
                            <i class="fas fa-info-circle me-1"></i> Giá trị vốn nhập trong kỳ
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-sm-6 col-12 d-flex">
                <div class="card flex-fill finance-card card-profit">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="finance-info">
                                <h6 class="text-white-50">Lợi nhuận thực tế (Net)</h6>
                                <h3 id="kpiActualProfit" class="text-white fw-bold mb-0">0 ₫</h3>
                            </div>
                            <div class="finance-icon bg-white-10">
                                <i class="fas fa-hand-holding-usd"></i>
                            </div>
                        </div>
                        <div class="w-100 rounded bg-black bg-opacity-10 p-2 mt-auto">
                            <div class="d-flex justify-content-between text-white-50 fs-7 mb-1">
                                <span>Lãi gộp:</span>
                                <span id="kpiGrossProfit" class="fw-bold text-white">0 ₫</span>
                            </div>
                            <div class="d-flex justify-content-between text-white-50 fs-7">
                                <span>Thất thoát kho:</span>
                                <span class="fw-bold text-warning" title="Giá trị hàng hóa hết hạn/hỏng">
                                    -<span id="kpiLossValue">0 ₫</span> (<span id="kpiLossRate">0</span>%)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-sm-6 col-12 d-flex">
                <div class="card flex-fill finance-card card-debt">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="finance-info">
                                <h6 class="text-white-50">Nợ cần trả NCC</h6>
                                <h3 id="kpiDebt" class="text-white fw-bold mb-0">0 ₫</h3>
                            </div>
                            <div class="finance-icon bg-white-10">
                                <i class="fas fa-file-invoice-dollar"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <a href="@Url.Action("SupplierDebtAndPayment", "Supplier", new { area = "Admin" })" class="text-white small fw-bold text-decoration-underline">Thanh toán ngay →</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8 d-flex">
                <div class="card flex-fill shadow-sm border-0">
                    <div class="card-header bg-white border-0 pb-0 pt-4">
                        <h5 class="card-title fw-bold">Dòng tiền kinh doanh (Thu vs Chi)</h5>
                    </div>
                    <div class="card-body">
                        <div id="cashFlowChart" style="min-height: 300px;"></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 d-flex">
                <div class="card flex-fill shadow-sm border-0">
                    <div class="card-header bg-white border-0 pb-0 pt-4">
                        <h5 class="card-title fw-bold">Cơ cấu Chi phí & Thất thoát</h5>
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <div id="expensePieChart" class="w-100"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-top mb-3">
                    <div class="search-set">
                        <div class="search-path">
                            <h5 class="card-title fw-bold mb-0">Giao dịch thu chi gần đây</h5>
                        </div>
                    </div>
                    <div class="wordset">
                        <ul>
                            <li>
                                <a data-bs-toggle="tooltip" data-bs-placement="top" title="Xuất Excel" style="cursor:pointer">
                                    <img src="~/assets/img/icons/excel.svg" alt="img">
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tblTransactions">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Mã giao dịch</th>
                                <th>Phân loại</th>
                                <th>Nghiệp vụ</th>
                                <th class="text-end">Số tiền</th>
                                <th class="text-end pe-4">Thời gian</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        let cashFlowChart, expensePieChart;
        let currentUserBranchId = 0;
        const formatter = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });

        $(document).ready(function () {
            initFinanceDashboard();
            $('#branchSelect, #timeRangeSelect').change(loadFinanceData);
        });

        async function initFinanceDashboard() {
            await getCurrentUserBranch();
            await loadDropdowns(currentUserBranchId);
            await loadFinanceData();
        }

        async function loadFinanceData() {
            const branchId = $('#branchSelect').val();
            const daysBack = $('#timeRangeSelect').val();

            try {
                const res = await $.get('/Admin/Admin/GetFinanceDashboardData', { branchId, daysBack });

                if (!res.success || !res.data) return;

                renderKpi(res.data.Kpi);
                renderMainChart(res.data.Trends);
                renderPieChart(res.data.ExpensePie);
                renderTransactions(res.data.RecentOrders);

            } catch (e) {
                console.error('Finance dashboard load failed', e);
            }
        }

        /* ================= KPI (Đã map DTO mới) ================= */
        function renderKpi(kpi) {
            const revenue = kpi.TotalRevenue || 0;
            const purchase = kpi.TotalPurchase || 0;
            const grossProfit = kpi.GrossProfit || 0;
            const debt = kpi.SupplierDebt || 0;

            // Dữ liệu mới
            const lossValue = kpi.InventoryLossValue || 0;
            const actualProfit = kpi.ActualProfit || 0;
            const lossRate = kpi.LossRate || 0;

            $('#kpiRevenue').text(formatter.format(revenue));
            $('#kpiExpense').text(formatter.format(purchase));
            $('#kpiDebt').text(formatter.format(debt));

            // Bóc tách lợi nhuận
            $('#kpiActualProfit').text(formatter.format(actualProfit));
            $('#kpiGrossProfit').text(formatter.format(grossProfit));
            $('#kpiLossValue').text(formatter.format(lossValue));
            $('#kpiLossRate').text(lossRate.toFixed(1));
        }

        /* ================= MAIN CHART ================= */
        function renderMainChart(data) {
            if (!data || !data.length) return;

            const labels = data.map(x => x.DateLabel);
            const revenue = data.map(x => x.Revenue);
            const expense = data.map(x => x.PurchaseCost);

            const options = {
                series: [
                    { name: 'Doanh thu', data: revenue },
                    { name: 'Chi phí nhập', data: expense }
                ],
                chart: { type: 'area', height: 350, toolbar: { show: false } },
                dataLabels: { enabled: false },
                stroke: { curve: 'smooth', width: 2 },
                colors: ['#38a169', '#ff6b6b'], // Xanh lá cho thu, Đỏ cho chi
                xaxis: { categories: labels },
                tooltip: { y: { formatter: val => formatter.format(val) } }
            };

            if (cashFlowChart) cashFlowChart.destroy();
            cashFlowChart = new ApexCharts(document.querySelector("#cashFlowChart"), options);
            cashFlowChart.render();
        }

        /* ================= PIE CHART ================= */
        function renderPieChart(data) {
            if (!data || !data.length) {
                $('#expensePieChart').html('<div class="text-muted py-5 text-center">Chưa có dữ liệu chi phí</div>');
                return;
            }

            // 1. Tạo một bảng màu đẹp mắt cho các loại chi phí thông thường
            const defaultColors = ['#0d6efd', '#fd7e14', '#20c997', '#6f42c1', '#0dcaf0', '#ffc107', '#343a40'];
            let colorIndex = 0;

            // 2. Map qua data để tạo mảng màu tương ứng
            const dynamicColors = data.map(x => {
                if (x.Label.includes('Thất thoát')) {
                    return '#dc3545';
                } else {
                    const color = defaultColors[colorIndex % defaultColors.length];
                    colorIndex++;
                    return color;
                }
            });

            const options = {
                series: data.map(x => x.Value),
                labels: data.map(x => x.Label),
                chart: { type: 'donut', height: 320 },
                legend: { position: 'bottom' },
                dataLabels: { enabled: false },
                tooltip: { y: { formatter: val => formatter.format(val) } },
                colors: dynamicColors // Áp dụng mảng màu đã custom
            };

            if (expensePieChart) expensePieChart.destroy();
            expensePieChart = new ApexCharts(document.querySelector("#expensePieChart"), options);
            expensePieChart.render();
        }

        /* ================= TRANSACTIONS ================= */
        function renderTransactions(list) {
            const $tbody = $('#tblTransactions tbody').empty();

            if (!list || !list.length) {
                $tbody.append(`<tr><td colspan="5" class="text-center py-4 text-muted">Không có giao dịch gần đây</td></tr>`);
                return;
            }

            list.forEach(x => {
                const isIn = x.Status === 'IN' || x.Status === 'Completed'; // Tùy logic DB của bro
                const badgeClass = isIn ? 'bg-success bg-opacity-10 text-success border border-success border-opacity-25'
                    : 'bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25';
                const sign = isIn ? '+' : '-';

                $tbody.append(`
                        <tr>
                            <td class="ps-4 fw-bold text-dark">${x.OrderId}</td>
                            <td><span class="badge ${badgeClass}">${isIn ? 'Phiếu Thu' : 'Phiếu Chi'}</span></td>
                            <td class="small text-muted">${isIn ? 'Bán hàng' : 'Nhập hàng/Chi phí'}</td>
                            <td class="text-end fw-bold ${isIn ? 'text-success' : 'text-danger'}">${sign}${formatter.format(x.TotalAmount)}</td>
                            <td class="text-end pe-4 small text-muted">${formatDateTime(x.OrderDate)}</td>
                        </tr>
                    `);
            });
        }

        /* ================= HELPERS ================= */
        async function getCurrentUserBranch() {
            try {
                const res = await $.get('/Admin/Login/GetCurrentUser');
                if (res.success) currentUserBranchId = res.data.BranchId || 0;
            } catch { }
        }

        function formatDateTime(dateStr) {
            if (!dateStr) return '__';
            var d = null;
            if (typeof dateStr === 'string' && dateStr.indexOf('/Date(') === 0) {
                var ticks = parseInt(dateStr.replace(/[^0-9]/g, ''), 10);
                if (!isNaN(ticks)) d = new Date(ticks);
            } else { d = new Date(dateStr); }

            if (!d || isNaN(d.getTime())) return '__';
            var dd = ('0' + d.getDate()).slice(-2);
            var mm = ('0' + (d.getMonth() + 1)).slice(-2);
            var yyyy = d.getFullYear();
            var hh = ('0' + d.getHours()).slice(-2);
            var mi = ('0' + d.getMinutes()).slice(-2);

            return `${dd}/${mm}/${yyyy} ${hh}:${mi}`;
        }

        async function loadDropdowns(branchId) {
            try {
                const res = await $.get('/Admin/Admin/LoadDropdowns', { branchId });
                const $select = $('#branchSelect').empty().append('<option value="">-- Tất cả Chi Nhánh --</option>');
                (res.branches || []).forEach(b => $select.append(`<option value="${b.BranchId}">${b.Name}</option>`));
                if (currentUserBranchId) $select.val(currentUserBranchId);
            } catch (e) { console.error('Load dropdown failed', e); }
        }
    </script>
}

@section Styles {
    <style>
        /* Nâng cấp Card KPI */
        .finance-card {
            border: none;
            border-radius: 20px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

            .finance-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 25px rgba(0,0,0,0.15);
            }

        /* Các bộ màu Gradient sang trọng */
        .card-revenue {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }
        /* Xanh dương sáng */
        .card-expense {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5253 100%);
        }
        /* Đỏ san hô */
        .card-profit {
            background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
        }
        /* Xanh lục bảo */
        .card-debt {
            background: linear-gradient(135deg, #f6ad55 0%, #ed8936 100%);
        }
        /* Cam hoàng hôn */

        .finance-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .bg-white-10 {
            background: rgba(255, 255, 255, 0.2);
        }

        .finance-info h6 {
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        /* Tinh chỉnh Header & Breadcrumb */
        .breadcrumb-item + .breadcrumb-item::before {
            content: "•";
            color: #adb5bd;
        }

        .page-title h3 {
            margin-bottom: 2px;
        }

        .select2-container--default .select2-selection--single {
            border: none !important;
            background-color: transparent !important;
        }
    </style>
}