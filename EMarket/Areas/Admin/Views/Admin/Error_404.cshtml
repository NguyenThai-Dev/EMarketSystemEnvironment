@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        /* --- CẤU HÌNH CƠ BẢN (Giữ nguyên theme tối) --- */
        :root {
            --color-bg: #0b0d10; /* Đen xanh nhẹ */
            --color-primary: #00f3ff; /* Xanh Cyan Neon */
            --color-secondary: #005f63;
            --color-text: #e0e0e0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--color-bg);
            font-family: 'Share Tech Mono', monospace;
            color: var(--color-text);
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        /* Hiệu ứng lưới nền (Grid Background) */
        body::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background:
                linear-gradient(rgba(0, 243, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 243, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: -1;
            box-shadow: inset 0 0 150px #000; /* Tối dần ở góc */
        }

        /* --- RADAR SCANNER (PURE CSS) --- */
        .radar-container {
            width: 150px;
            height: 150px;
            position: relative;
            margin-bottom: 30px;
        }

        .radar-ring {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            border: 2px solid var(--color-secondary);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--color-secondary);
            opacity: 0.6;
        }

        .radar-ring::before {
            content: '';
            position: absolute;
            top: 50%; left: 0; width: 100%; height: 2px;
            background: var(--color-secondary);
            transform: translateY(-50%);
        }

        .radar-ring::after {
            content: '';
            position: absolute;
            left: 50%; top: 0; height: 100%; width: 2px;
            background: var(--color-secondary);
            transform: translateX(-50%);
        }

        .scanner-beam {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            border-radius: 50%;
            background: conic-gradient(from 0deg, transparent 0deg, rgba(0, 243, 255, 0.1) 60deg, rgba(0, 243, 255, 0.6) 90deg, transparent 91deg);
            animation: scan 2s infinite linear;
            z-index: 2;
        }

        .not-found-dot {
            position: absolute;
            top: 30px;
            right: 40px;
            width: 8px;
            height: 8px;
            background-color: var(--color-primary);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--color-primary);
            animation: blink 1s infinite;
        }

        /* --- TEXT 404 --- */
        .error-code {
            font-size: 7rem;
            font-weight: bold;
            color: transparent;
            -webkit-text-stroke: 2px var(--color-primary);
            position: relative;
            letter-spacing: 5px;
        }

        /* Hiệu ứng bóng đổ Neon */
        .error-code::before {
            content: "404";
            position: absolute;
            left: 0; top: 0;
            color: var(--color-primary);
            opacity: 0.3;
            filter: blur(5px);
            animation: pulse-glow 2s infinite alternate;
        }

        .message-title {
            font-size: 1.8rem;
            text-transform: uppercase;
            margin-top: 10px;
            margin-bottom: 10px;
            color: var(--color-primary);
            letter-spacing: 2px;
        }

        .message-desc {
            font-size: 1rem;
            color: #888;
            margin-bottom: 40px;
            text-align: center;
            max-width: 450px;
            line-height: 1.6;
        }

        .terminal-text::after {
            content: "_";
            animation: blink 1s infinite step-end;
        }

        /* --- BUTTON --- */
        .btn-home {
            text-decoration: none;
            color: var(--color-bg);
            background-color: var(--color-primary);
            padding: 12px 35px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 2px; /* Góc vuông kiểu máy móc */
            text-transform: uppercase;
            transition: all 0.3s ease;
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.4);
            border: 1px solid var(--color-primary);
            position: relative;
            z-index: 10;
        }

        .btn-home:hover {
            background-color: transparent;
            color: var(--color-primary);
            box-shadow: 0 0 25px rgba(0, 243, 255, 0.8);
        }

        /* --- ANIMATIONS --- */
        @@keyframes scan {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        @@keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        @@keyframes pulse-glow {
            from { filter: blur(5px); opacity: 0.3; }
            to { filter: blur(8px); opacity: 0.6; }
        }

    </style>
</head>
<body>

    <div class="radar-container">
        <div class="radar-ring"></div>
        <div class="scanner-beam"></div>
        <div class="not-found-dot"></div>
    </div>

    <div class="error-code">404</div>

    <div class="message-title">FILE NOT FOUND</div>

    <p class="message-desc terminal-text">
        Hệ thống quét không tìm thấy dữ liệu yêu cầu. <br>
        URL có thể bị hỏng hoặc tài nguyên đã bị xóa.
    </p>

    <a href="@Url.Action("Index", "Admin", new { area = "Admin" })" class="btn-home">
        TRỞ VỀ DASHBOARD
    </a>

</body>
</html>