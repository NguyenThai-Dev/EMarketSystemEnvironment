@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>500 - Internal Server Error</title>
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        :root {
            --color-bg: #0d0202;
            --color-warning: #ffaa00;
            --color-text: #e0e0e0;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--color-bg);
            font-family: 'Share Tech Mono', monospace;
            color: var(--color-text);
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }
        body::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(rgba(255, 170, 0, 0.02) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(255, 170, 0, 0.02) 1px, transparent 1px);
            background-size: 50px 50px;
            z-index: -1;
        }
        .warning-icon {
            font-size: 5rem;
            color: var(--color-warning);
            margin-bottom: 20px;
            animation: pulse 1s infinite alternate;
        }
        .error-code {
            font-size: 8rem;
            font-weight: bold;
            color: var(--color-warning);
            text-shadow: 0 0 20px rgba(255, 170, 0, 0.5);
            position: relative;
        }
        .error-code::after {
            content: "CRITICAL_FAILURE";
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.8rem;
            letter-spacing: 5px;
            opacity: 0.7;
        }
        .message-title {
            font-size: 2rem;
            margin-top: 20px;
            color: var(--color-warning);
        }
        .message-desc {
            font-size: 1.1rem;
            color: #777;
            margin: 20px 0 40px;
            text-align: center;
            max-width: 600px;
            line-height: 1.6;
        }
        .btn-retry {
            text-decoration: none;
            color: var(--color-bg);
            background-color: var(--color-warning);
            padding: 12px 40px;
            font-weight: bold;
            border-radius: 2px;
            transition: all 0.3s;
            box-shadow: 0 0 15px rgba(255, 170, 0, 0.3);
        }
        .btn-retry:hover {
            background-color: transparent;
            color: var(--color-warning);
            box-shadow: 0 0 30px rgba(255, 170, 0, 0.6);
            border: 1px solid var(--color-warning);
        }
        @@keyframes pulse {
            from { transform: scale(1); opacity: 1; }
            to { transform: scale(1.1); opacity: 0.7; }
        }
    </style>
</head>
<body>
    <div class="warning-icon">⚠</div>
    <div class="error-code">500</div>
    <div class="message-title">SERVER ERROR</div>
    <p class="message-desc">
        Hệ thống đang gặp sự cố logic ngoài dự kiến.<br>
        Dữ liệu của bạn vẫn an toàn, vui lòng thử lại sau vài phút.
    </p>
    <a href="javascript:location.reload()" class="btn-retry">TẢI LẠI TRANG</a>
</body>
</html>