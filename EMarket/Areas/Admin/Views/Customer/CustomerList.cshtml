@{
    ViewBag.Title = "Quản lý Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content">

        <div class="page-header">
            <div class="page-title">
                <h4>Danh sách Khách hàng</h4>
                <h6>Quản lý hồ sơ và địa chỉ giao hàng</h6>
            </div>
            <div class="page-btn">
                <button class="btn btn-added" id="btnAddCustomer">
                    <img src="~/assets/img/icons/plus.svg" class="me-1" alt="add" />
                    Thêm Khách hàng
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-top">
                    <div class="search-set">
                        <div class="search-input">
                            <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img" /></a>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="tblCustomers" class="table datanew w-100">
                        <thead>
                            <tr>
                                <th>
                                    <label class="checkboxs">
                                        <input type="checkbox" id="select-all" />
                                        <span class="checkmarks"></span>
                                    </label>
                                </th>
                                <th>Khách hàng</th>
                                <th>Liên hệ</th>
                                <th>Hạng</th>
                                <th>Điểm tích lũy</th>
                                <th class="text-end" style="width:140px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCustomerInput" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thông tin Khách hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="CustomerId" value="0" />
                <input type="hidden" id="AddressId" value="0" /> <div class="row">
                    <div class="col-lg-4 border-end">
                        <h6 class="text-primary mb-3 fw-bold">1. Hồ sơ cá nhân</h6>

                        <div class="form-group text-center mb-3">
                            <div class="image-upload image-upload-new mb-0">
                                <input type="file" id="UserImgFile" accept="image/*">
                                <div class="image-uploads">
                                    <img src="~/assets/img/icons/upload.svg" alt="img" id="previewImg">
                                    <div class="mt-2 small text-muted">Avatar</div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="FullName" />
                        </div>
                        <div class="form-group">
                            <label>Số điện thoại <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Phone" />
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="text" class="form-control" id="Email" />
                        </div>
                        <div class="form-group">
                            <label>Loại khách</label>
                            <select class="form-control select" id="CustomerType">
                                <option value="Standard">Standard</option>
                                <option value="Normal">Normal</option>
                                <option value="Member">Member</option>
                                <option value="VIP">VIP</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-8 ps-lg-4">
                        <h6 class="text-warning mb-3 fw-bold">2. Địa chỉ mặc định</h6>

                        <div class="alert alert-light border small">
                            <i class="fas fa-info-circle me-1"></i> Hệ thống sẽ tự động tạo/cập nhật địa chỉ mặc định cho khách hàng này.
                        </div>

                        <div class="form-group">
                            <label>Địa chỉ chi tiết <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="FullAddress" rows="3" placeholder="Số nhà, đường, phường/xã, quận/huyện..."></textarea>
                        </div>

                        <div class="form-group">
                            <label>Google Map Embed URL (Iframe src)</label>
                            <input type="text" class="form-control" id="AddressUrl" placeholder="https://www.google.com/maps/embed?..." />
                            <small class="text-muted d-block mt-1">Copy link embed từ Google Maps để hiển thị bản đồ.</small>
                        </div>

                        <div id="previewMapContainer" class="rounded overflow-hidden border mt-2" style="height: 150px; display:none; background:#eee;">
                            <iframe id="inputMapPreview" style="border:0; width: 100%; height: 100%;" loading="lazy"></iframe>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button class="btn btn-primary" id="btnSaveCustomer">
                    <i class="fas fa-save me-1"></i> Lưu dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCustomerView" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-0">
                <div class="card bg-white border-0 mb-0">
                    <div class="card-header bg-primary text-white p-4">
                        <div class="d-flex align-items-center">
                            <img id="vUserImg" src="" class="rounded-circle border border-3 border-white me-3" width="70" height="70" style="object-fit:cover; background:#fff;">
                            <div>
                                <h4 id="vFullName" class="text-white mb-0 fw-bold">...</h4>
                                <span id="vCustomerType" class="badge-type bg-warning text-dark mt-1">...</span>
                            </div>
                            <div class="ms-auto text-end">
                                <div class="text-white-50 small">Điểm tích lũy</div>
                                <h3 id="vPoints" class="text-white fw-bold mb-0">0</h3>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-md-5 border-end">
                                <h6 class="fw-bold mb-3">Thông tin liên hệ</h6>
                                <p class="mb-2"><i class="fas fa-phone-alt text-muted me-2" style="width:20px"></i> <span id="vPhone"></span></p>
                                <p class="mb-2"><i class="fas fa-envelope text-muted me-2" style="width:20px"></i> <span id="vEmail"></span></p>
                                <p class="mb-2"><i class="fas fa-calendar-alt text-muted me-2" style="width:20px"></i> Tham gia: <span id="vCreatedAt"></span></p>
                            </div>

                            <div class="col-md-7 ps-md-4">
                                <h6 class="fw-bold mb-3">Địa chỉ giao hàng (Mặc định)</h6>
                                <p id="vFullAddress" class="fw-medium mb-2">Đang tải...</p>

                                <div id="viewMapContainer" class="rounded overflow-hidden border bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <iframe id="vMapFrame" style="border:0; width: 100%; height: 100%" loading="lazy"></iframe>
                                    <span class="text-muted small" id="noMapText" style="display:none">Không có bản đồ</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer text-end bg-light">
                        <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let tblCustomers;

        $(document).ready(function () {
            initDataTable();

            $('#btnAddCustomer').click(openAddModal);
            $('#btnSaveCustomer').click(handleSaveCustomer);
            $('#UserImgFile').change(function () { readURL(this); });

            $('#AddressUrl').on('input', function () {
                const url = $(this).val();
                if (url && url.includes('http')) {
                    $('#inputMapPreview').attr('src', url);
                    $('#previewMapContainer').slideDown();
                } else {
                    $('#previewMapContainer').slideUp();
                }
            });
        });

        $(document).on("keyup", "#txtSearch", function () {
            clearTimeout(window.searchTimer);
            window.searchTimer = setTimeout(() => tblCustomers.ajax.reload(), 400);
        });

        // --- DATATABLE ---
        function initDataTable() {
            if ($.fn.DataTable.isDataTable('#tblCustomers')) {
                $('#tblCustomers').DataTable().clear().destroy();
            }

            $.extend(true, $.fn.dataTable.defaults, {
                dom: 't<"bottom_controls"lp>',
                language: {
                    search: "",
                    searchPlaceholder: "Search...",
                    info: "",
                    infoEmpty: "",
                    infoFiltered: "",
                },
            });

            tblCustomers = $('#tblCustomers').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: '/Customer/GetAllCustomerFiltered',
                    data: function (d) {
                        d.keyword = $("#txtSearch").val() ?? "";
                    },
                    type: 'GET'
                },
                columns: [
                    {
                        data: null, className: 'text-center',
                        render: () => `<label class="checkboxs"><input type="checkbox"/><span class="checkmarks"></span></label>`
                    },
                    {
                        data: 'FullName',
                        render: (data, type, row) => {
                            const img = row.UserImg || '/assets/img/EMarket_Logo_Icon.png'; 
                            const emailHtml = row.Email ? `<small class="text-muted d-block mt-1"><i class="far fa-envelope me-1"></i>${row.Email}</small>` : '';
                            return `
                                <div class="d-flex align-items-center">
                                    <div class="avatar-md me-3 rounded-circle shadow-sm overflow-hidden border border-white border-2" style="width: 45px; height: 45px;">
                                        <img src="${img}" alt="img" class="w-100 h-100" style="object-fit:cover;">
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-semibold text-dark">${data}</h6>
                                        ${emailHtml}
                                    </div>
                                </div>
                            `;
                        }
                    },
                    { 
                        data: 'Phone', 
                        render: d => d ? `<span class="badge bg-light text-dark border border-secondary border-opacity-25 px-2 py-1"><i class="fas fa-phone-alt text-muted me-2" style="font-size: 0.8rem;"></i>${d}</span>` : '<span class="text-muted fst-italic">Trống</span>' 
                    },
                    {
                        data: 'CustomerType',
                        className: 'text-center align-middle', 
                        render: function (d) {
                            let cls = '';
                            let label = d || 'Standard';

                            switch (d) {
                                case 'VIP':
                                    cls = 'badge-soft-vip';
                                    break;
                                case 'Member':
                                    cls = 'badge-soft-member';
                                    break;
                                case 'Normal':
                                    cls = 'badge-soft-normal';
                                    break;
                                default:
                                    cls = 'badge-soft-standard';
                                    label = 'Standard';
                                    break;
                            }
                            // Bọc trong một div để control flexbox nếu cần
                            return `<span class="badge-type ${cls}">${label}</span>`;
                        }
                    },
                    { 
                        data: 'PointBalance', 
                        className: 'text-center',
                        render: d => `<div class="d-inline-flex align-items-center"><i class="fas fa-star text-warning me-1"></i><span class="fw-bold">${d}</span></div>` 
                    },
                    {
                        data: null, className: 'text-end',
                        render: (data, type, row) => `
                            <a href="javascript:void(0)" class="btn btn-icon btn-sm btn-soft-info me-1" title="Chi tiết" onclick='openViewModal(${JSON.stringify(row)})'>
                                <img src="/assets/img/icons/eye.svg" alt="view" style="width:14px; filter: brightness(0) saturate(100%) invert(48%) sepia(97%) saturate(1412%) hue-rotate(161deg) brightness(97%) contrast(98%);" />
                            </a>
                            <a href="javascript:void(0)" class="btn btn-icon btn-sm btn-soft-primary me-1" title="Chỉnh sửa" onclick='openEditModal(${JSON.stringify(row)})'>
                                <img src="/assets/img/icons/edit.svg" alt="edit" style="width:14px; filter: brightness(0) saturate(100%) invert(26%) sepia(90%) saturate(1914%) hue-rotate(203deg) brightness(98%) contrast(106%);" />
                            </a>
                            <a href="javascript:void(0)" class="btn btn-icon btn-sm btn-soft-danger" title="Xóa" onclick="deleteCustomer(${row.CustomerId})">
                                <img src="/assets/img/icons/delete.svg" alt="delete" style="width:14px; filter: brightness(0) saturate(100%) invert(35%) sepia(58%) saturate(3015%) hue-rotate(338deg) brightness(95%) contrast(92%);" />
                            </a>
                        `
                    }
                ],
                order: [[1, 'asc']],
                drawCallback: function () {
                    $('#tblCustomers_filter input').attr('id', 'txtSearch');
                },
                error: function (xhr) {
                    console.log("DataTable Error:", xhr);
                }
            });
        }

        // --- 1. LOGIC XEM CHI TIẾT (VIEW) ---
        async function openViewModal(customer) {
            // Fill Basic Info
            $('#vUserImg').attr('src', customer.UserImg || '/assets/img/customer/user-01.jpg');
            $('#vFullName').text(customer.FullName);
            $('#vCustomerType').text(customer.CustomerType || 'Standard');
            $('#vPoints').text(customer.PointBalance);
            $('#vPhone').text(customer.Phone || 'N/A');
            $('#vEmail').text(customer.Email || 'N/A');
            $('#vCreatedAt').text(formatDate(customer.CreatedAt));

            // Reset Address area
            $('#vFullAddress').html('<i class="fas fa-spinner fa-spin"></i> Đang tải...');
            $('#vMapFrame').hide();
            $('#noMapText').hide();

            $('#modalCustomerView').modal('show');

            // CALL API: Lấy địa chỉ
            try {
                const res = await $.get('/Customer/GetCustomerAddress', { customerId: customer.CustomerId });
                if (res.addresses && res.addresses.length > 0) {
                    // Ưu tiên lấy mặc định, không thì lấy cái đầu tiên
                    const addr = res.addresses.find(x => x.IsDefault) || res.addresses[0];

                    $('#vFullAddress').text(addr.FullAddress);

                    if (addr.AddressUrl) {
                        $('#vMapFrame').attr('src', addr.AddressUrl).show();
                    } else {
                        $('#noMapText').show();
                    }
                } else {
                    $('#vFullAddress').text('Khách hàng chưa có địa chỉ.');
                    $('#noMapText').text('Chưa cập nhật bản đồ').show();
                }
            } catch (e) {
                $('#vFullAddress').text('Lỗi khi tải địa chỉ.');
            }
        }

        // --- 2. LOGIC THÊM / SỬA (ADD / EDIT) ---
        async function openEditModal(customer) {
            resetForm();
            $('#modalTitle').text('Cập nhật Khách hàng');

            // 1. Fill Customer Info
            $('#CustomerId').val(customer.CustomerId);
            $('#FullName').val(customer.FullName);
            $('#Phone').val(customer.Phone);
            $('#Email').val(customer.Email);
            $('#CustomerType').val(customer.CustomerType).trigger('change');
            if (customer.UserImg) $('#previewImg').attr('src', customer.UserImg);

            // 2. Fetch Address để fill vào form
            try {
                const res = await $.get('/Customer/GetCustomerAddress', { customerId: customer.CustomerId });
                if (res.addresses && res.addresses.length > 0) {
                    const addr = res.addresses.find(x => x.IsDefault) || res.addresses[0];
                    $('#AddressId').val(addr.AddressId); // Lưu ID để update
                    $('#FullAddress').val(addr.FullAddress);
                    $('#AddressUrl').val(addr.AddressUrl).trigger('input');
                }
            } catch (e) { console.error(e); }

            $('#modalCustomerInput').modal('show');
        }

        function openAddModal() {
            resetForm();
            $('#modalTitle').text('Thêm Khách hàng mới');
            $('#modalCustomerInput').modal('show');
        }

        // --- 3. LOGIC LƯU (SAVE - ORCHESTRATION) ---
        async function handleSaveCustomer() {
            const customerId = Number($('#CustomerId').val()) || 0;
            const addressId = Number($('#AddressId').val()) || 0;
            const isEdit = customerId > 0;

            if (!$('#FullName').val() || !$('#Phone').val()) {
                Swal.fire('Thiếu thông tin', 'Vui lòng nhập Tên và Số điện thoại', 'warning');
                return;
            }

            // Dùng FormData để upload file
            const formData = new FormData();
            formData.append('CustomerId', customerId);
            formData.append('FullName', $('#FullName').val());
            formData.append('Phone', $('#Phone').val());
            formData.append('Email', $('#Email').val());
            formData.append('CustomerType', $('#CustomerType').val());

            const fileInput = $('#UserImgFile')[0];
            if (fileInput.files && fileInput.files[0]) {
                formData.append('file', fileInput.files[0]);
            }

            try {
                const saveCusUrl = isEdit ? '/Customer/UpdateCustomer' : '/Customer/CreateCustomer';

                const cusRes = await $.ajax({
                    url: saveCusUrl,
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false
                });

                if (!cusRes.success) throw new Error('Lỗi hệ thống khi lưu khách hàng');

                const finalCustomerId = isEdit ? customerId : cusRes.newId;
                if (!finalCustomerId || finalCustomerId <= 0)
                    throw new Error('Không lấy được ID khách hàng để lưu địa chỉ.');

                // --- SAVE ADDRESS ---
                if ($('#FullAddress').val().trim() !== "") {
                    const addressDto = {
                        AddressId: addressId,
                        CustomerId: finalCustomerId,
                        FullAddress: $('#FullAddress').val(),
                        AddressUrl: $('#AddressUrl').val(),
                        IsDefault: true
                    };
                    const saveAddrUrl = addressId > 0 ? '/Customer/UpdateCustomerAddress' : '/Customer/CreateCustomerAddress';
                    const addrRes = await $.post(saveAddrUrl, addressDto);
                    if (!addrRes.success) Swal.fire('Cảnh báo', 'Lưu địa chỉ thất bại', 'warning');
                }

                $('#modalCustomerInput').modal('hide');
                tblCustomers.ajax.reload(null, false);

                Swal.fire({ title: 'Thành công!', text: isEdit ? 'Đã cập nhật dữ liệu.' : 'Đã thêm khách hàng mới.', icon: 'success', timer: 1500, showConfirmButton: false });
            } catch (err) {
                console.error(err);
                Swal.fire('Thất bại', err.message || 'Có lỗi xảy ra', 'error');
            }
        }

        // --- 4. DELETE ---
        function deleteCustomer(id) {
            Swal.fire({
                title: 'Xóa khách hàng?',
                text: "Dữ liệu địa chỉ liên quan cũng sẽ bị ảnh hưởng (nếu có cascade)",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Xóa ngay'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Customer/DeleteCustomer', { id: id }, function (res) {
                        if (res.success) {
                            tblCustomers.ajax.reload();
                            Swal.fire('Đã xóa', 'Khách hàng đã bị xóa.', 'success');
                        } else {
                            Swal.fire('Lỗi', 'Không thể xóa khách hàng này', 'error');
                        }
                    });
                }
            });
        }

        // Helpers
        function resetForm() {
            $('#CustomerId').val(0);
            $('#AddressId').val(0);
            $('#FullName').val('');
            $('#Phone').val('');
            $('#Email').val('');
            $('#FullAddress').val('');
            $('#AddressUrl').val('');
            $('#CustomerType').val('Standard');
            $('#previewImg').attr('src', '/assets/img/icons/upload.svg');
            $('#previewMapContainer').hide();
        }

        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#previewImg').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            // Xử lý format date /Date(...)/ hoặc ISO
            return new Date(parseInt(dateStr.replace(/[^0-9]/g, ''))).toLocaleDateString('vi-VN');
        }
    </script>
}

@section Styles {
    <style>
        /* CSS cho cột gộp Avatar + Tên */
        .productimgname {
            display: flex;
            align-items: center;
        }

            .productimgname .product-img {
                width: 40px;
                height: 40px;
                margin-right: 10px;
                border-radius: 50px;
                overflow: hidden;
            }

                .productimgname .product-img img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }
        /* Reset và căn giữa cho ô DataTable */
        table.dataTable td.text-center {
            text-align: center !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        /* Định dạng Badge chung */
        .badge-type {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 85px; /* Độ rộng cố định giúp các badge thẳng hàng dọc */
            padding: 6px 12px;
            font-weight: 700;
            font-size: 11px;
            text-transform: uppercase;
            border-radius: 6px;
            border: none;
        }

        /* 1. VIP - Màu Cam Gold (Sang trọng) */
        .badge-soft-vip {
            background-color: #fff4e5 !important;
            color: #ff9f43 !important;
        }

        /* 2. Member - Màu Xanh Dương (Tin cậy) */
        .badge-soft-member {
            background-color: #e5f3ff !important;
            color: #0088ff !important;
        }

        /* 3. Normal - Màu Xanh Lá (Thân thiện) */
        .badge-soft-normal {
            background-color: #e2fbd7 !important;
            color: #28c76f !important;
        }

        /* 4. Standard - Màu Xám (Trung tính) */
        .badge-soft-standard {
            background-color: #f3f6f9 !important;
            color: #7e8299 !important;
        }

        /* Căn giữa icon sắp xếp của DataTables ở Header để không bị lệch */
        table.dataTable thead th.text-center {
            text-align: center !important;
            padding-right: 12px !important; /* Đè lại padding-right của sorting icon */
        }
        
        /* --- DIRECTORY STYLES --- */
        .btn-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            padding: 0;
            border-radius: 6px;
            transition: all 0.2s ease;
        }
        
        .btn-soft-primary { background-color: rgba(13, 110, 253, 0.1); border: 1px solid transparent; }
        .btn-soft-primary:hover { background-color: rgba(13, 110, 253, 0.2); border-color: rgba(13, 110, 253, 0.3); transform: translateY(-1px); }
        
        .btn-soft-info { background-color: rgba(13, 202, 240, 0.1); border: 1px solid transparent; }
        .btn-soft-info:hover { background-color: rgba(13, 202, 240, 0.2); border-color: rgba(13, 202, 240, 0.3); transform: translateY(-1px); }
        
        .btn-soft-danger { background-color: rgba(220, 53, 69, 0.1); border: 1px solid transparent; }
        .btn-soft-danger:hover { background-color: rgba(220, 53, 69, 0.2); border-color: rgba(220, 53, 69, 0.3); transform: translateY(-1px); }
        
        table.dataTable tbody tr {
            transition: all 0.2s;
        }
        table.dataTable tbody tr:hover {
