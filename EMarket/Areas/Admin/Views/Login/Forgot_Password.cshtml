
@{
    ViewBag.Title = "Forgot_Password";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutLogin.cshtml";
}
@section Style {
    <style>
        .inactive{
            opacity: 0;
            display: none;
        }
    </style>    
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="logo">
                <img class="logo-img" src="~/assets/img/EMarket_Logo.png" alt="Logo DLT" style="width: 50%;height: 50%" />
            </div>
            <h1>Thay đổi mật khẩu</h1>
            <p>Hãy nhập Email để nhận mã OTP thay đổi mật khẩu</p>
        </div>

        <!-- Form gửi email lấy OTP -->
        <form class="login-form" id="forgotForm" novalidate>
            <div class="input-group">
                <input type="email" id="fpEmail" name="fpEmail" required placeholder=" ">
                <label for="fpEmail">Email</label>
                <span class="input-border"></span>
                <span class="error-message" id="fpEmailError"></span>
            </div>

            <button type="submit" class="submit-btn">
                <span class="btn-text">Nhận OTP</span>
            </button>
            @Html.AntiForgeryToken()
        </form>

        <!-- Form nhập OTP + mật khẩu mới -->
        <form class="login-form inactive" id="resetForm" novalidate>
            <div class="input-group">
                <input type="text" id="otp" name="otp" required placeholder=" ">
                <label for="otp">OTP</label>
                <span class="input-border"></span>
                <span class="error-message" id="otpError"></span>
            </div>

            <div class="input-group">
                <input type="password" id="newPassword" name="newPassword" required placeholder=" ">
                <label for="newPassword">Mật khẩu mới</label>
                <span class="input-border"></span>
                <span class="error-message" id="newPasswordError"></span>
            </div>

            <button type="submit" class="submit-btn">
                <span class="btn-text">Thay đổi mật khẩu</span>
            </button>
            @Html.AntiForgeryToken()
        </form>

        <div class="success-message inactive" id="successMessage">
            <div class="success-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="12" fill="#635BFF" />
                    <path d="M8 12l3 3 5-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <h3>Success!</h3>
            <p id="successText">Check your email or login now.</p>
        </div>
    </div>
</div>


@section Scripts{
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(function () {

            function getToken(form) {
                return $(form).find("input[name='__RequestVerificationToken']").val();
            }

            // --- GỬI OTP ---
            $('#forgotForm').on('submit', function (e) {
                e.preventDefault();

                const $form = $(this);
                const email = $('#fpEmail').val().trim();
                const token = getToken(this);

                if (!email) {
                    Swal.fire('Thất bại', 'Email không được để trống', 'error');
                    return;
                }

                $.ajax({
                    url: '/Admin/Login/RequestOtp',
                    type: 'POST',
                    data: {
                        email: email,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res.success) {
                            $form.addClass('inactive');
                            $('#resetForm').removeClass('inactive');
                            $('#otp').focus();
                            $('#successText').text(res.message);
                            $('#successMessage').removeClass('inactive');
                        } else {
                            Swal.fire('Thất bại', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Thất bại', 'Có lỗi xảy ra khi gửi OTP', 'error');
                    }
                });
            });

            // --- RESET PASSWORD ---
            $('#resetForm').on('submit', function (e) {
                e.preventDefault();

                const email = $('#fpEmail').val().trim();
                const otp = $('#otp').val().trim();
                const newPassword = $('#newPassword').val().trim();
                const token = getToken(this);

                if (!otp || !newPassword) {
                    Swal.fire('Thất bại', 'Vui lòng nhập đầy đủ OTP và mật khẩu mới', 'error');
                    return;
                }

                $.ajax({
                    url: '/Admin/Login/ResetPassword',
                    type: 'POST',
                    data: {
                        email: email,
                        otp: otp,
                        newPassword: newPassword,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res.success) {
                            $('#resetForm').addClass('inactive');
                            $('#successText').text(res.message);
                            $('#successMessage').removeClass('inactive');

                            Swal.fire('Thành công', 'Đang chuyển về trang đăng nhập...', 'success')
                                .then(() => window.location.href = '/Admin/Login/Login');
                        } else {
                            Swal.fire('Thất bại', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Thất bại', 'Lỗi hệ thống', 'error');
                    }
                });
            });
        });

    </script>
}



