@{
    ViewBag.Title = "Quản lý Nhân viên";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content">

        <div class="page-header">
            <div class="page-title">
                <h4>Danh sách Nhân viên</h4>
                <h6>Quản lý tài khoản, phân quyền và trạng thái hoạt động</h6>
            </div>
            <div class="page-btn">
                <button class="btn btn-added" id="btnAddUser">
                    <img src="~/assets/img/icons/plus.svg" class="me-1" alt="add" />
                    Thêm Nhân viên
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-top">
                    <div class="search-set">
                        <div class="search-input">
                            <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img" /></a>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="tblUsers" class="table datanew w-100">
                        <thead>
                            <tr>
                                <th><label class="checkboxs"><input type="checkbox" id="select-all" /><span class="checkmarks"></span></label></th>
                                <th>Nhân viên</th>
                                <th>Email</th>
                                <th>Điện thoại</th>
                                <th>Vai trò</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-end" style="width:140px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalUserInput" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thông tin Nhân viên</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="UserId" value="0" />

                <div class="row">
                    <div class="col-lg-4 border-end">
                        <div class="form-group text-center mb-3">
                            <label class="fw-bold mb-2">Ảnh đại diện</label>
                            <div class="image-upload image-upload-new mb-0">
                                <input type="file" id="UserImgFile" accept="image/*">
                                <div class="image-uploads">
                                    <img src="~/assets/img/icons/upload.svg" alt="img" id="previewImg" style="max-height:100%;">
                                    <div class="mt-2 small text-muted">Click để tải ảnh</div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Trạng thái</label>
                            <select class="form-control select" id="Status">
                                <option value="Active">Hoạt động</option>
                                <option value="Inactive">Ngừng hoạt động</option>
                                <option value="Locked">Đang khóa</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-8 ps-lg-4">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Họ và tên <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="FullName" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Số điện thoại</label>
                                    <input type="text" class="form-control" id="Phone" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Tên đăng nhập <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="Username" autocomplete="off" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Email</label>
                                    <input type="text" class="form-control" id="Email" />
                                </div>
                            </div>

                            <div class="col-12"><hr class="my-2"></div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Vai trò (Role) <span class="text-danger">*</span></label>
                                    <select class="form-control select" id="RoleId">
                                        <option value="">-- Chọn vai trò --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Chi nhánh làm việc</label>
                                    <select class="form-control select" id="BranchId">
                                        <option value="0">-- Toàn hệ thống --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-12" id="divSupplierWrapper" style="display:none;">
                                <div class="form-group bg-light p-3 rounded border border-warning">
                                    <label class="text-warning fw-bold mb-1"><i class="fas fa-box-open me-1"></i> Liên kết Nhà cung cấp</label>
                                    <p class="small text-muted mb-2">Tài khoản này sẽ đại diện cho NCC nào?</p>
                                    <select class="form-control select" id="SupplierId">
                                        <option value="">-- Chọn Nhà cung cấp --</option>
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button class="btn btn-primary" id="btnSaveUser">Lưu dữ liệu</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalUserView" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content user-profile-modal">
            <div class="modal-body p-0">

                <div class="user-profile-grid">

                    <!-- LEFT: IDENTITY -->
                    <div class="profile-identity">
                        <img id="vUserImg" src="" />

                        <h3 id="vFullName">—</h3>

                        <div id="vRoleBadge"></div>

                        <div class="profile-status">
                            <span id="vStatus"></span>
                        </div>
                    </div>

                    <!-- RIGHT: DETAILS -->
                    <div class="profile-details">
                        <div class="detail-item">
                            <span class="label">Tài khoản</span>
                            <span id="vUsername" class="value"></span>
                        </div>

                        <div class="detail-item">
                            <span class="label">Email</span>
                            <span id="vEmail" class="value"></span>
                        </div>

                        <div class="detail-item">
                            <span class="label">Số điện thoại</span>
                            <span id="vPhone" class="value"></span>
                        </div>

                        <div class="detail-item">
                            <span class="label">Chi nhánh</span>
                            <span id="vBranch" class="value"></span>
                        </div>

                        <!-- Supplier -->
                        <div id="vSupplierWrapper" class="supplier-block" style="display:none;">
                            <span class="label"></span>
                            <span id="vSupplierName" class="value"></span>
                        </div>
                    </div>

                </div>

                <div class="profile-footer">
                    <button class="btn btn-light btn-sm" data-bs-dismiss="modal">Đóng</button>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let tblUsers, branchList, supplierList;

        $(document).ready(function () {
            // 1. Init Data & Table
            loadMasterData();
            initDataTable();

            // 2. Event Listeners
            $('#btnAddUser').click(openAddModal);
            $('#btnSaveUser').click(handleSaveUser);
            $('#UserImgFile').change(function () { readURL(this); });

            // Toggle Password View
            $('.toggle-password').click(function () {
                $(this).toggleClass("fa-eye fa-eye-slash");
                let input = $($(this).attr("toggle"));
                // Logic toggle đơn giản cho input cùng cấp
                let passInput = $(this).siblings('input');
                if (passInput.attr("type") === "password") {
                    passInput.attr("type", "text");
                } else {
                    passInput.attr("type", "password");
                }
            });

            // 3. LOGIC QUAN TRỌNG: Role Change
            $('#RoleId').on('change', function () {
                const roleId = $(this).val();

                // Giả sử Role ID 6 là Supplier (cần đồng bộ với DB thực tế)
                if (roleId == "6") {
                    $('#divSupplierWrapper').slideDown();
                } else {
                    $('#divSupplierWrapper').slideUp();
                    $('#SupplierId').val('').trigger('change'); // Reset nếu chọn role khác
                }
            });

            let searchTimer = null;
            $('#txtSearch').on('keyup', function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(() => {
                    tblUsers.ajax.reload();
                }, 400);
            });

            $('#RoleId').on('change', function () {
                if ($(this).val() == '6') {
                    $('#BranchId').val('').prop('disabled', true);
                } else {
                    $('#BranchId').prop('disabled', false);
                }
            });

        });

        // --- DATATABLE ---
        function initDataTable() {
            // -- 1. INIT DATATABLE --
            if ($.fn.DataTable.isDataTable('#tblUsers')) {
                $('#tblUsers').DataTable().clear().destroy();
            }

            $.extend(true, $.fn.dataTable.defaults, {
                dom: 't<"bottom_controls"lp>',
                language: {
                    search: "",
                    searchPlaceholder: "Search...",
                    info: "",
                    infoEmpty: "",
                    infoFiltered: "",
                },
            });

            tblUsers = $('#tblUsers').DataTable({
                processing: true,
                serverSide: false,
                searching: false,
                ordering: false,
                pageLength: 10,
                ajax: {
                    url: '/Admin/User/GetFilteredUsers',
                    type: 'GET',
                    data: function (d) {
                        d.keyword = $('#txtSearch').val();
                    }
                },
                columns: [
                    {
                        data: null,
                        className: 'text-center dt-checkbox-col',
                        render: function (data, type, row) {
                            return `
                                            <label class="checkboxs">
                                                <input type="checkbox" class="row-select" data-id="${row.UserId}" />
                                                <span class="checkmarks"></span>
                                            </label>`;
                        }
                    },
                    // ===== USER =====
                    {
                        data: null,
                        render: function (d) {
                            const img = d.Image || '/assets/img/EMarket_Logo_Icon.png';
                            return `
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-md me-3 rounded-circle shadow-sm overflow-hidden border border-white border-2" style="width: 45px; height: 45px;">
                                            <img src="${img}" class="w-100 h-100" style="object-fit:cover;">
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">${d.FullName}</div>
                                            <div class="text-muted small"><i class="far fa-id-badge me-1"></i>${d.Username}</div>
                                        </div>
                                    </div>`;
                        }
                    },

                    // ===== EMAIL =====
                    {
                        data: 'Email',
                        render: d => d ? `<small class="text-muted"><i class="far fa-envelope me-1"></i>${d}</small>` : '<span class="text-muted fst-italic small">N/A</span>'
                    },

                    // ===== PHONE =====
                    {
                        data: 'Phone',
                        render: d => d ? `<span class="badge bg-light text-dark border border-secondary border-opacity-25 px-2 py-1"><i class="fas fa-phone-alt text-muted me-2" style="font-size: 0.8rem;"></i>${d}</span>` : '<span class="text-muted fst-italic">N/A</span>'
                    },

                    // ===== ROLE =====
                    {
                        data: 'Roles',
                        className: 'text-center',
                        render: function (roles) {

                            if (!roles || roles.length === 0)
                                return `<span class="badge badge-soft badge-soft-na">N/A</span>`;

                            const role = roles[0];
                            const roleName = role.Name || '';

                            const roleClassMap = {
                                'System Admin': 'badge-soft-admin',
                                'Quản lý Nhân sự': 'badge-soft-hr',
                                'Quản lý Kho': 'badge-soft-warehouse',
                                'Quản lý Bán hàng': 'badge-soft-sales',
                                'Quản lý Công nợ': 'badge-soft-finance',
                                'Nhà cung cấp': 'badge-soft-partner'
                            };

                            let badgeClass = 'badge-soft-default';

                            Object.keys(roleClassMap).some(key => {
                                if (roleName.includes(key)) {
                                    badgeClass = roleClassMap[key];
                                    return true;
                                }
                                return false;
                            });

                            return `<span class="badge badge-soft ${badgeClass}">${roleName}</span>`;
                        }
                    },

                    // ===== STATUS =====
                    {
                        data: 'Status',
                        className: 'text-center align-middle',
                        render: function (d) {
                            const isChecked = d === 'Active' ? 'checked' : '';
                            return `
                                <div class="form-check form-switch form-switch-md d-flex justify-content-center mb-0" title="${d}">
                                    <input class="form-check-input" type="checkbox" disabled ${isChecked} style="cursor: not-allowed; opacity: 1;">
                                </div>
                            `;
                        }
                    },

                    // ===== ACTION =====
                    {
                        data: null,
                        orderable: false,
                        className: 'text-end',
                        render: function (d) {

                            const safeJson = JSON.stringify(d).replace(/'/g, "&apos;");

                            return `
                                <a href="javascript:void(0)" class="btn btn-icon btn-sm btn-soft-info me-1" title="Chi tiết" onclick='openViewModal(${safeJson})'>
                                    <img src="/assets/img/icons/eye.svg" alt="view" style="width:14px; filter: brightness(0) saturate(100%) invert(48%) sepia(97%) saturate(1412%) hue-rotate(161deg) brightness(97%) contrast(98%);" />
                                </a>
                                <a href="javascript:void(0)" class="btn btn-icon btn-sm btn-soft-primary me-1" title="Chỉnh sửa" onclick='openEditModal(${safeJson})'>
                                    <img src="/assets/img/icons/edit.svg" alt="edit" style="width:14px; filter: brightness(0) saturate(100%) invert(26%) sepia(90%) saturate(1914%) hue-rotate(203deg) brightness(98%) contrast(106%);" />
                                </a>
                                <a href="javascript:void(0)" class="btn btn-icon btn-sm btn-soft-danger" title="Xóa" onclick="deleteUser(${d.UserId})">
                                    <img src="/assets/img/icons/delete.svg" alt="delete" style="width:14px; filter: brightness(0) saturate(100%) invert(35%) sepia(58%) saturate(3015%) hue-rotate(338deg) brightness(95%) contrast(92%);" />
                                </a>`;
                        }
                    }
                ],
                order: [[1, 'asc']],
                drawCallback: function () {
                    $('#tblUsers_filter input').attr('id', 'txtSearch');
                },
                error: function (xhr) {
                    console.log("DataTable Error:", xhr);
                }
            });
        }

        // --- MODAL LOGIC ---
        function openAddModal() {
            resetForm();
            $('#modalTitle').text('Thêm Nhân viên mới');
            $('#UserId').val(0);
            $('#BranchId').val("").trigger('change');

            // Logic Password cho Create
            $('#reqPass').show();
            $('#notePass').hide();

            $('#modalUserInput').modal('show');
        }

        function openEditModal(user) {

            $('#UserId').val(user.UserId);
            $('#Username').val(user.Username);
            $('#FullName').val(user.FullName);
            $('#Email').val(user.Email);
            $('#Phone').val(user.Phone);
            $('#Status').val(user.Status).trigger('change');
            $('#BranchId').val(user.BranchId).trigger('change');

            if (user.SupplierId) $('#SupplierId').val(user.SupplierId).trigger('change');

            if (user.Roles && user.Roles.length > 0) {
                $('#RoleId').val(user.Roles[0].RoleId).trigger('change');
            } else {
                $('#RoleId').val('').trigger('change');
            }

            $('#modalUserInput').modal('show');
        }

        async function handleSaveUser() {
            const userId = Number($('#UserId').val());
            const isEdit = userId > 0;

            const formData = new FormData();

            // =========================
            // DTO fields
            // =========================
            formData.append('UserId', userId);
            formData.append('Username', $('#Username').val());
            formData.append('FullName', $('#FullName').val());
            formData.append('Email', $('#Email').val());
            formData.append('Phone', $('#Phone').val());
            formData.append('Status', $('#Status').val());

            formData.append('RoleId', $('#RoleId').val());
            formData.append('BranchId', $('#BranchId').val());
            formData.append('SupplierId', $('#SupplierId').val());

            // =========================
            // File
            // =========================
            const fileInput = document.getElementById('UserImgFile');
            if (fileInput && fileInput.files.length > 0) {
                formData.append('file', fileInput.files[0]); // TÊN PHẢI LÀ "file"
            }

            // =========================
            // Validate
            // =========================
            if (!$('#Username').val() || !$('#FullName').val() || !$('#RoleId').val()) {
                Swal.fire('Thiếu thông tin', 'Vui lòng nhập Username, Tên và Vai trò', 'warning');
                return;
            }

            try {
                const url = isEdit ? '/User/UpdateUser' : '/User/CreateUser';

                const res = await $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,           
                    processData: false,       
                    contentType: false        
                });

                if (res.success) {
                    $('#modalUserInput').modal('hide');
                    tblUsers.ajax.reload(null, false);
                    Swal.fire('Thành công', 'Đã lưu thông tin nhân viên', 'success');
                } else {
                    Swal.fire('Lỗi', res.message || 'Không thể lưu dữ liệu', 'error');
                }
            } catch (e) {
                console.error(e);
                Swal.fire('Lỗi', 'Lỗi kết nối server', 'error');
            }
        }


        // --- HELPERS ---
        async function loadMasterData() {
            // Load Roles
            const roles = await $.get('/Admin/Role/GetAllRole');
            let roleOpt = '<option value="">-- Chọn vai trò --</option>';
            roles.data.forEach(r => roleOpt += `<option value="${r.RoleId}">${r.Name}</option>`);
            $('#RoleId').html(roleOpt);

            const dropdowns = await $.get('/Admin/Product/LoadDropdowns');

            // Load Branches
            const branches = dropdowns.branches;
            branchList = branches;
            let brOpt = '<option value="">-- Toàn hệ thống --</option>';
            if (branches) branches.forEach(b => brOpt += `<option value="${b.BranchId}">${b.Name}</option>`);
            $('#BranchId').html(brOpt);

            // Load Suppliers
            const suppliers = dropdowns.suppliers;
            supplierList = suppliers;
            let supOpt = '<option value="">-- Chọn Nhà cung cấp --</option>';
            if (suppliers) suppliers.forEach(s => supOpt += `<option value="${s.SupplierId}">${s.Name}</option>`);
            $('#SupplierId').html(supOpt);
        }

        function resetForm() {
            $('#UserId').val(0);
            $('#Username').val('').prop('disabled', false);
            $('#FullName').val('');
            $('#Email').val('');
            $('#Phone').val('');
            $('#RoleId').val('').trigger('change');
            $('#BranchId').val(0).trigger('change');
            $('#SupplierId').val('').trigger('change');
            $('#Status').val('Active');
            $('#previewImg').attr('src', '/assets/img/icons/upload.svg');
            $('#divSupplierWrapper').hide();
        }

        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) { $('#previewImg').attr('src', e.target.result); }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function getRoleBadgeClass(roleName) {
            if (!roleName) return 'bg-secondary text-white';

            const roleMap = [
                { key: 'System Admin', cls: 'bg-warning text-dark' },
                { key: 'Quản lý Nhân sự', cls: 'bg-info text-white' },
                { key: 'Quản lý Kho', cls: 'bg-success text-white' },
                { key: 'Quản lý Bán hàng', cls: 'bg-primary text-white' },
                { key: 'Quản lý Công nợ', cls: 'bg-danger text-white' },
                { key: 'Nhà cung cấp', cls: 'bg-dark text-white' }
            ];

            const matched = roleMap.find(r => roleName.includes(r.key));
            return matched ? matched.cls : 'bg-secondary text-white';
        }


        function openViewModal(user) {

            // =========================
            // 1. Avatar
            // =========================
            $('#vUserImg').attr(
                'src',
                user.Image || '/assets/img/EMarket_Logo_Icon.png'
            );

            // =========================
            // 2. Identity
            // =========================
            $('#vFullName').text(user.FullName || '—');
            $('#vUsername').text(user.Username || '—');
            $('#vEmail').text(user.Email || '—');
            $('#vPhone').text(user.Phone || '—');

            // =========================
            // 3. Status
            // =========================
            $('#vStatus')
                .text(user.Status === 'Active' ? 'Đang hoạt động' : 'Ngừng hoạt động')
                .removeClass()
                .addClass(user.Status === 'Active'
                    ? 'status-active'
                    : 'status-inactive'
                );

            // =========================
            // 4. Role
            // =========================
            let roleHtml = `<span class="badge badge-soft-standard">N/A</span>`;

            if (user.Roles && user.Roles.length > 0) {
                roleHtml = renderRoleBadge(user.Roles[0].Name);
            }

            $('#vRoleBadge').html(roleHtml);

            // =========================
            // 5. Branch
            // =========================
            $('#vBranch').text(
                getBranchNameById(branchList, user.BranchId)
            );
           
            // =========================
            // 6. Supplier
            // =========================
            $('#vSupplierWrapper').show();
            if (user.IsSupplier && user.SupplierId) {

                $('#vSupplierName').text( 'Nhà cung cấp ' +
                    getSupplierNameById(supplierList, user.SupplierId)
                );
            } else if (user.IsSupplier) {
                $('#vSupplierName').text('Chưa liên kết nhà cung cấp');
            } else {
                $('#vSupplierName').text('Nhân viên hệ thống');
            }


            // =========================
            // 7. Show modal
            // =========================
            $('#modalUserView').modal('show');
        }

        function renderRoleBadge(roleName) {
            let cls = 'badge-soft-standard';

            if (roleName === 'System Admin')
                cls = 'badge-soft-vip';
            else if (roleName.includes('Nhân sự'))
                cls = 'badge-soft-member';
            else if (roleName.includes('Kho'))
                cls = 'badge-soft-success';
            else if (roleName.includes('Bán hàng'))
                cls = 'badge-soft-sales';
            else if (roleName.includes('Công nợ'))
                cls = 'badge-soft-debt';
            else if (roleName.includes('Nhà cung cấp'))
                cls = 'badge-soft-partner';

            return `<span class="badge ${cls}">${roleName}</span>`;
        }


        function deleteUser(userId) {
            // Thay vì dùng confirm(), ta dùng Swal.fire
            Swal.fire({
                title: 'Bạn chắc chắn muốn xoá?',
                text: "Dữ liệu sau khi xoá sẽ không thể khôi phục!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                // Nếu người dùng nhấn "Đồng ý"
                if (result.isConfirmed) {

                    // Gọi AJAX
                    $.ajax({
                        url: '/Admin/User/DeleteUser',
                        type: 'POST',
                        data: { id: userId },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire(
                                    'Đã xoá!',
                                    'User đã được gỡ khỏi hệ thống.',
                                    'success'
                                );
                                tblUsers.ajax.reload();
                            } else {
                                Swal.fire(
                                    'Lỗi!',
                                    res.message || 'Xoá thất bại',
                                    'error'
                                );
                            }
                        },
                        error: function () {
                            Swal.fire('Lỗi!', 'Không thể kết nối đến server', 'error');
                        }
                    });
                }
            });
        }
        function getBranchNameById(branchList, branchId) {
            if (!branchId || !branchList) return 'Đối tác';

            for (var i = 0; i < branchList.length; i++) {
                if (branchList[i].BranchId === branchId) {
                    return branchList[i].Name;
                }
            }
            return '';
        }

        function getSupplierNameById(supplierList, supplierId) {
            if (!supplierId || !supplierList) return 'Không xác định';

            for (var i = 0; i < supplierList.length; i++) {
                if (supplierList[i].SupplierId === supplierId) {
                    return supplierList[i].Name;
                }
            }
            return '';
        }
    </script>
}

