@{
    ViewBag.Title = "ProductCategoryList";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content">

        <!-- PAGE HEADER -->
        <div class="page-header">
            <div class="page-title">
                <h4>Danh sách loại sản phẩm</h4>
                <h6>Quản lý danh sách loại sản phẩm</h6>
            </div>
            <div class="page-btn">
                <button class="btn btn-added" id="btnAddCategory">
                    <img src="~/assets/img/icons/plus.svg" class="me-1" alt="add" />
                    Thêm loại mới
                </button>
            </div>
        </div>

        <!-- TABLE -->
        <div class="card">
            <div class="card-body">

                <div class="table-top">
                    <div class="search-set">
                        <div class="search-input">
                            <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img" /></a>
                        </div>
                    </div>
                    @Html.Partial("~/Areas/Admin/Views/Partial/_ExportButtons.cshtml", "tblProductCategories")
                </div>

                <div class="table-responsive">
                    <table id="tblProductCategories" class="table datanew w-100">
                        <thead>
                            <tr>
                                <th><label class="checkboxs"><input type="checkbox" id="select-all" /><span class="checkmarks"></span></label></th>
                                <th>Loại</th>
                                <th>Mô tả</th>
                                <th style="width:120px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CATEGORY MODAL -->
<div class="modal fade" id="modalCategory" tabindex="-1" data-bs-backdrop="static" 
     data-bs-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="CategoryId" />

                <div class="form-group mb-3">
                    <label>Category Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="CategoryName" />
                </div>

                <div class="form-group">
                    <label>Description</label>
                    <textarea class="form-control" id="Description" rows="3"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" id="btnSaveCategory">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let tblCategories;

        $(function () {

            if ($.fn.DataTable.isDataTable('#tblProductCategories')) {
                $('#tblProductCategories').DataTable().clear().destroy();
            }

            $.extend(true, $.fn.dataTable.defaults, {
                dom: 't<"bottom_controls"lp>',

                language: {
                    search: "",
                    searchPlaceholder: "Tìm kiếm...",
                    info: "",
                    infoEmpty: "",
                    infoFiltered: "",
                },
            });

            tblCategories = $('#tblProductCategories').DataTable({
                processing: true,
                serverSide: false,
                responsive: true,
                searching: false,
                ajax: {
                    url: '/Product/GetFilteredProductCategory',
                    data: function (d) {
                        d.categoryName = $("#txtSearch").val() ?? "";
                    },
                    type: 'GET'
                },
                columns: [
                    {
                        data: null,
                        orderable: false,
                        className: 'text-center dt-checkbox-col',
                        render: function (data, type, row) {
                            return `
                                <label class="checkboxs">
                                    <input type="checkbox" class="row-select" data-id="${row.CategoryId}" />
                                    <span class="checkmarks"></span>
                                </label>`;
                        }
                    },
                    { data: 'Name' },
                    {
                        data: 'Description',
                        render: function (data, type, row) {
                            const MAX_LENGTH = 100; // Đặt giới hạn ký tự, ví dụ 100

                            // Kiểm tra xem DataTables đang yêu cầu dữ liệu cho kiểu 'display' (hiển thị) hay không
                            if (type === 'display' && data && data.length > MAX_LENGTH) {
                                return data.substr(0, MAX_LENGTH) + '...';
                            }

                            // Trả về dữ liệu gốc cho kiểu 'sort', 'filter', 'type'
                            return data;
                        }
                    },
                    {
                        data: null,
                        orderable: false,
                        render: d => {
                            const canDelete = d.CanBeDeleted; 

                            const editButton = `
                            <a href="javascript:void(0)" class="me-2 btn-edit"
                                 data-id="${d.CategoryId}"
                                 data-name="${d.Name}"
                                 data-desc="${d.Description || ''}">
                                  <img src="/assets/img/icons/edit.svg" />
                            </a>`;

                            const deleteButton = canDelete
                                ? `<a href="javascript:void(0)" class="btn-delete" data-id="${d.CategoryId}">
                                  <img src="/assets/img/icons/delete.svg" />
                              </a>`
                                : `<a href="javascript:void(0)" class="btn-delete btn-delete-disabled" data-id="${d.CategoryId}">
                                  <img src="/assets/img/icons/delete.svg" />
                              </a>`;

                            return editButton + deleteButton;
                        }
                    },
                ],
                order: [[1, 'asc']],
                drawCallback: function () {
                    $('#tblProductCategories_filter input').attr('id', 'txtSearch');
                },

                error: function (xhr) {
                    console.log("DataTable Error:", xhr);
                }
            });

            // ADD
            $('#btnAddCategory').click(() => {
                resetModal();
                $('#modalTitle').text('Thêm Danh Mục'); // Cập nhật tiêu đề
                $('#modalCategory').modal('show');
            });

            // EDIT
            $(document).on('click', '.btn-edit', function () {
                $('#CategoryId').val($(this).data('id'));
                $('#CategoryName').val($(this).data('name'));
                $('#Description').val($(this).data('desc'));

                $('#modalTitle').text('Chỉnh Sửa Danh Mục'); // Cập nhật tiêu đề
                $('#modalCategory').modal('show');
            });

            // SAVE
            $('#btnSaveCategory').click(async function () {
                const isEdit = Number($('#CategoryId').val() || 0) !== 0; // Xác định đang là Edit hay Add
                const dto = {
                    CategoryId: Number($('#CategoryId').val() || 0),
                    Name: $('#CategoryName').val(),
                    Description: $('#Description').val()
                };

                if (!dto.Name) {
                    // *** 1. Lỗi Validation (Tên Danh mục Bị thiếu) ***
                    Swal.fire({
                        title: 'Lỗi Validation!',
                        text: 'Tên danh mục là bắt buộc. Vui lòng nhập tên.',
                        icon: 'warning',
                        confirmButtonText: 'Đã hiểu',
                        confirmButtonColor: '#ffc107',
                    });
                    return;
                }

                const url = dto.CategoryId === 0
                    ? '/Product/CreateProductCategory'
                    : '/Product/UpdateProductCategory';

                const res = await $.post(url, dto);

                if (res.success) {
                    $('#modalCategory').modal('hide');
                    $('#tblProductCategories').DataTable().ajax.reload(null, false);

                    // *** 2. Lưu Thành Công ***
                    Swal.fire({
                        title: 'Thành công!',
                        text: isEdit ? 'Thông tin danh mục đã được cập nhật.' : 'Danh mục mới đã được tạo.',
                        icon: 'success',
                        confirmButtonText: 'Hoàn tất',
                        confirmButtonColor: '#28a745',
                        timer: 2000,
                        timerProgressBar: true,
                    });
                } else {
                    // *** 3. Xử lý Lỗi Server (nếu cần) ***
                    Swal.fire({
                        title: 'Lỗi Server!',
                        text: res.message || 'Đã xảy ra lỗi trong quá trình lưu dữ liệu.',
                        icon: 'error',
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#dc3545',
                    });
                }
            });

            $(document).on('click', '.btn-delete', function () {
                // KIỂM TRA: Nếu nút bị làm mờ, không làm gì cả
                if ($(this).hasClass('btn-delete-disabled')) {
                    return;
                }

                const id = $(this).data('id');

                Swal.fire({
                    title: 'Bạn có chắc chắn?',
                    text: 'Dữ liệu danh mục này sẽ bị xóa vĩnh viễn và không thể phục hồi!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ',
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                }).then(r => {
                    if (!r.isConfirmed) return;

                    $.post('/Product/DeleteProductCategory', { id }, res => {
                        if (res.success) {
                            $('#tblProductCategories').DataTable().ajax.reload(null, false);

                            Swal.fire({
                                title: 'Đã Xóa!',
                                text: 'Danh mục đã được xóa thành công.',
                                icon: 'info',
                                confirmButtonText: 'Hoàn tất',
                                confirmButtonColor: '#17a2b8',
                                timer: 1500,
                                timerProgressBar: true,
                            });
                        } else {
                            Swal.fire({
                                title: 'Xóa Thất Bại!',
                                text: res.message || 'Không thể xóa danh mục. Vui lòng kiểm tra các liên kết.',
                                icon: 'error',
                                confirmButtonText: 'Đóng',
                                confirmButtonColor: '#dc3545',
                            });
                        }
                    });
                });
            });

            // NÚT SEARCH
            $('#btnSearch').on('click', function () {
                tblCategories.ajax.reload();
            });

            $(document).on("keyup",
                "#tblProductCategories_filter input",
                function () {
                    clearTimeout(window.searchTimer);
                    window.searchTimer = setTimeout(function () {
                        if (tblCategories) {
                            tblCategories.ajax.reload();
                        }
                    }, 400);
                }
            );

        });

        function resetModal() {
            $('#CategoryId').val(0);
            $('#CategoryName').val('');
            $('#Description').val('');
        }
    </script>
}

@section Styles{
    <style>
        table.dataTable td {
            white-space: normal !important;
        }

        .btn-delete-disabled {
            /* Làm mờ */
            opacity: 0.4;
            /* Thay đổi con trỏ chuột thành 'not-allowed' */
            cursor: not-allowed !important;
            /* Tùy chọn: ngăn chặn mọi sự kiện chuột (pointer) */
            pointer-events: none;
        }
    </style>
}