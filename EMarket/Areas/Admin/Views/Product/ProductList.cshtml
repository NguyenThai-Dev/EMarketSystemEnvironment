</button>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script>
        var tblProducts;
        var showInactive = false;
        const moneyFormatter = new Intl.NumberFormat('vi-VN');

        function formatCurrency(v) {
            if (v == null || v === "") return "";
            return new Intl.NumberFormat("vi-VN", { style: "currency", currency: "VND" }).format(v);
        }

        function formatBonusInformation(d) {
            // 'd' chính là row data (object trả về từ API)
            if (!d.Details || d.Details.length === 0) {
                return '<div class="p-3 text-muted">Sản phẩm này chưa có tồn kho trong phạm vi tìm kiếm.</div>';
            }

            // Tạo bảng chi tiết
            var rows = '';
            d.Details.forEach(function (item) {
                // Format ngày tháng (Giả sử bạn có hàm formatDate)
                var expiry = item.ExpiryDate ? new Date(item.ExpiryDate).toLocaleDateString('vi-VN') : 'N/A';

                rows += `
                        <tr>
                            <td>${item.WarehouseName}</td>
                            <td>${expiry}</td>
                           <td>${item.BatchCode ?? "__"}</td>
                            <td class="text-end fw-bold">${item.Quantity}</td>
                        </tr>
                    `;
            });

            return `
                    <div class="p-3 bg-light" style="border-left: 4px solid #ff9f43;">
                        <h6 class="mb-2 text-primary">Chi tiết Tồn kho:</h6>
                        <table class="table table-sm table-bordered mb-0" style="background: #fff; max-width: 600px;">
                            <thead class="table-secondary">
                                <tr>
                                    <th>Kho hàng</th>
                                    <th>Hạn sử dụng</th>
                                    <th class="text-end">Số lượng</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${rows}
                            </tbody>
                        </table>
                    </div>
                `;
        }

        function formatDate(d) {
            if (!d) return '';

            // 1. Trích xuất số mili giây
            var matches = d.match(/\d+/);
            if (!matches) return d;

            var ms = parseInt(matches[0]);
            var d = new Date(ms);

            // 2. Định dạng theo chuẩn địa phương (Việt Nam)
            return d.toLocaleString('vi-VN', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit'
            });
        }

        function defaultImage(img) {
            return img ? img : '/assets/img/EMarket_Logo_Icon.png'; 
        }

        function formatChildRow(row) {
            var inventoryRows = "";

            if (row.Details && row.Details.length > 0) {
                row.Details.forEach(function (d) {
                    var expiry = d.ExpiryDate ? moment(d.ExpiryDate).format("DD/MM/YYYY") : "—";
                    inventoryRows += `
                            <tr>
                                <td class="fw-medium text-primary">${d.WarehouseName}</td>
                                <td>${d.BranchName ?? "—"}</td>
                                 <td class="text-center">${d.BatchCode ?? "-"}</td>
                                <td class="text-center">${expiry}</td>
                                <td class="text-end fw-bold text-success">${d.Quantity.toLocaleString('vi-VN')}</td>
                            </tr>`;
                });
            } else {
                inventoryRows = `<tr><td colspan="4" class="text-center text-muted fst-italic">Chưa có thông tin tồn kho chi tiết</td></tr>`;
            }

            // Giao diện chi tiết (Left: Info, Right: Stock Limits, Bottom: Inventory Table)
            return `
                    <div class="child-row-container">
                        <div class="p-3">
                            <div class="row mb-3">
                                <div class="col-md-7">
                                    <h6 class="text-success mb-2"><i class="fa fa-info-circle"></i> Thông tin bổ sung</h6>
                                    <div class="row text-muted small">
                                        <div class="col-6">
                                            <p class="mb-1"><strong>Mã vạch:</strong> ${row.Barcode || "—"}</p>
                                            <p class="mb-1"><strong>Đơn vị:</strong> ${row.Unit || "—"}</p>
                                            <p class="mb-1"><strong>NCC:</strong> ${row.SupplierName || "—"}</p>
                                        </div>
                                        <div class="col-6">
                                            <p class="mb-1"><strong>Loại:</strong> ${row.CategoryName || "—"}</p>
                                            <p class="mb-1"><strong>Ghi chú:</strong> ${row.Description || "—"}</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-5 border-start">
                                    <h6 class="text-success mb-2"><i class="fa fa-boxes"></i> Cảnh báo tồn kho</h6>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>Tối thiểu (Min):</span>
                                        <span class="fw-bold">${(row.MinStock || 0).toLocaleString('vi-VN')}</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>Tối đa (Max):</span>
                                        <span class="fw-bold">${(row.MaxStock || 0).toLocaleString('vi-VN')}</span>
                                    </div>
                                    <div class="d-flex justify-content-between border-top pt-1 mt-1">
                                        <span class="text-primary fw-bold">Tổng tồn hiện tại:</span>
                                        <span class="text-primary fw-bold fs-6">${(row.Quantity || 0).toLocaleString('vi-VN')}</span>
                                    </div>
                                </div>
                            </div>

                            <h6 class="text-secondary mb-2">Chi tiết tồn kho theo chi nhánh</h6>
                            <div class="table-responsive bg-white border rounded">
                                <table class="table table-sm table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Kho hàng</th>
                                            <th>Chi nhánh</th>
                                             <th class="text-center">Số lô</th>
                                            <th class="text-center">Hạn sử dụng</th>
                                            <th class="text-end">Số lượng</th>
                                        </tr>
                                    </thead>
                                    <tbody>${inventoryRows}</tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                `;
        }

        function formatFileSize(kb, decimals = 1) {
            if (!kb || isNaN(kb)) return "0 KB";

            const dm = decimals < 0 ? 0 : decimals;

            // Danh sách đơn vị
            const sizes = ["KB", "MB", "GB", "TB"];

            let i = 0; // index của đơn vị
            let value = kb;

            while (value >= 1024 && i < sizes.length - 1) {
                value = value / 1024;
                i++;
            }

            return `${parseFloat(value.toFixed(dm))} ${sizes[i]}`;
        }

        async function getFileInfo(url) {
            return new Promise(resolve => {
                $.ajax({
                    type: "HEAD",
                    url: url,
                    success: function (_, __, xhr) {
                        const size = xhr.getResponseHeader("Content-Length");
                        const fileName = url.split('/').pop();

                        resolve({
                            fileName: fileName,
                            sizeKb: size ? Math.round(size / 1024) : null
                        });
                    },
                    error: function () {
                        resolve({
                            fileName: url.split('/').pop(),
                            sizeKb: null
                        });
                    }
                });
            });
        }

        async function loadProductImageAndFinishGalery(productId) {
            $.getJSON('/Product/GetAllProductImageByProductId', { productId: productId }, async function (gallery) {

                if (gallery.data && gallery.data.length > 0) {

                    for (let img of gallery.data) {

                        const info = await getFileInfo(img.ImageUrl);

                        $("#detailGallery").append(`
                                        <div class="slider-product">
                                            <img src="${img.ImageUrl}" alt="${info.fileName}" />
                                            <h4>${"Hình ảnh sản phẩm"}</h4>
                                            <h6>${info.sizeKb ? formatFileSize(info.sizeKb) : ""}</h6>
                                        </div>
                                    `);
                    }
                }

                // 3. Re-init Owl Carousel
                $("#detailGallery").owlCarousel({
                    loop: true,
                    margin: 10,
                    nav: true,
                    dots: true,
                    items: 1,
                    autoplay: true,
                    autoplayTimeout: 3000
                });
            });
        }

        async function showProductDetails(id) {
            $.ajax({
                url: '/Admin/Product/GetProductById/' + id,
                type: 'GET',
                success: async function (res) {

                    // Gán dữ liệu
                    $("#dName").text(res.Name);
                    $("#dCategory").text(res.CategoryName ?? "N/A");
                    $("#dSupplier").text(res.SupplierName ?? "N/A");
                    $("#dUnit").text(res.Unit);
                    $("#dBarcode").text(res.Barcode);
                    $("#dMinStock").text(res.MinStock);
                    $("#dMaxStock").text(res.MaxStock);
                    $("#dPrice").text(formatCurrency(res.Price));
                    $("#dQuantity").text(res.Quantity);
                    $("#dExpiry").text(formatDate(res.ExpiredAt) || "N/A");
                    $("#dDescription").text(res.Description || "Không có mô tả");

                    // BARCODE
                    $("#detailBarcode").attr("src", `/Admin/Product/GenerateBarcode?code=${res.Barcode}`);

                    // THUMBNAIL
                    if ($("#detailGallery").data('owl.carousel')) {
                        $("#detailGallery").owlCarousel('destroy');
                    }
                    $("#detailGallery").empty();
                    if (res.Image) {

                        const info = await getFileInfo(res.Image);

                        $("#detailGallery").append(`
                                        <div class="slider-product">
                                            <img src="${res.Image}" alt="${info.fileName}" />
                                            <h4>${"HInh ảnh sản phẩm"}</h4>
                                            <h6>${info.sizeKb ? formatFileSize(info.sizeKb) : ""}</h6>
                                        </div>
                                    `);
                    }

                    // PRODUCT IMAGE
                    await loadProductImageAndFinishGalery(res.ProductId);

                    var modalEl = document.getElementById('modalProductDetails');
                    if (modalEl) {
                        var modal = new bootstrap.Modal(modalEl, { backdrop: 'static' });
                        modal.show();
                    }
                }
            });
        }

        function printBarcode() {
            var img = document.getElementById("detailBarcode");
            if (!img) return;

            var src = img.src;

            // "_blank" = mở tab mới (không phải popup window)
            var w = window.open("about:blank", "_blank");

            w.document.write(`
                    <html>
                    <head>
                        <title>Print Barcode</title>
                        <style>
                            body { margin:0; padding:0; text-align:center; }
                            img { height:200px; width:auto; }
                        </style>
                    </head>
                    <body>
                        <img src="${src}" />
                    </body>
                    </html>
                `);

            w.document.close();

            w.onload = function () {
                w.print();
                w.close();
            };
        }

        $(document).ready(function () {

            function deleteProduct(id) {
                $.ajax({
                    url: '/Product/DeleteProduct',
                    type: 'POST',
                    data: {
                        id: id,
                    },
                    success: function (res) {
                        if (res.success) {
                            Swal.fire({
                                title: "Thành công!",
                                text: "Đã xóa sản phẩm thành công.",
                                icon: "success",
                                confirmButtonText: "Hoàn tất",
                                confirmButtonColor: "#28a745",
                                timer: 3000,
                                timerProgressBar: true
                            });
                            tblProducts.ajax.reload();
                        } else {
                            Swal.fire({
                                title: "Lỗi!",
                                text: "Không thể xóa sản phẩm!",
                                icon: "error",
                                confirmButtonText: "Đã hiểu",
                                confirmButtonColor: "#dc3545",
                                timer: 3000,
                                timerProgressBar: true
                            });
                        }
                    }
                });
            }

            // Xử lý data table
            $.extend(true, $.fn.dataTable.defaults, {
                dom: 't<"bottom_controls"lp>',
                language: {
                    search: "",
                    searchPlaceholder: "Tìm kiếm...",
                    info: "",
                    infoEmpty: "",
                    infoFiltered: ""
                }
            });

            function initProductTable() {
                if ($.fn.DataTable.isDataTable('#tblProducts')) {
                    $('#tblProducts').DataTable().clear().destroy();
                }

                tblProducts = $('#tblProducts').DataTable({
                    processing: true,
                    serverSide: false,
                    responsive: true,
                    searching: true,
                    ajax: {
                        url: showInactive ? '/Admin/Product/GetAllInactiveProduct' : '/Admin/Product/GetAllProduct',
                        type: 'POST',
                        data: function (d) {
                            d.keyWord = $("#txtSearch").val() ?? "";
                            d.categoryId = $('#filterCategory').val();
                            d.branchId = $('#filterBranch').val();
                            d.supplierId = $('#filterSupplier').val();
                            d.warehouseId = $('#filterWarehouse').val();
                        },
                        dataSrc: "products"
                    },
                    columns: [
                        // 0. Checkbox
                        {
                            data: null,
                            orderable: false,
                            className: 'text-center dt-checkbox-col',
                            width: '30px',
                            render: function (data, type, row) {
                                return `<label class="checkboxs"><input type="checkbox" class="row-select" data-id="${row.ProductId}" /><span class="checkmarks"></span></label>`;
                            }
                        },
                        // 1. [MỚI] Nút mở rộng (Dấu +)
                        {
                            className: 'dt-control',
                            orderable: false,
                            data: null,
                            defaultContent: '',
                            width: '30px'
                        },
                    // 2. Image + Name
                    {
                        data: 'Name',
                        render: function (data, type, row) {
                            var img = defaultImage(row.Image);
                            const firstChar = data ? data.charAt(0).toUpperCase() : 'P';
                            const isDefault = img.includes('EMarket_Logo_Icon') || img.includes('logo-black');
                            
                            let avatarHtml = '';
                            if (isDefault) {
                                avatarHtml = `<div class="me-3 bg-soft-primary text-primary rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width:40px; height:40px; font-weight:bold; font-size:1.2rem;">${firstChar}</div>`;
                            } else {
                                avatarHtml = `<img src="${img}" class="me-3 rounded-circle shadow-sm" alt="product" style="width:40px;height:40px;object-fit:cover; border: 2px solid #fff;"/>`;
                            }

                            return `
                                    <div class="d-flex align-items-center">
                                        ${avatarHtml}
                                        <a href="javascript:void(0);" class="product-name fw-bold text-dark btn-product-detail" data-id="${row.ProductId}" style="font-size:14px;">${data ?? ""}</a>
                                    </div>`;
                        }
                    },
                    { data: 'Barcode', defaultContent: '' }, // SKU
                    { data: 'CategoryName', defaultContent: '' },
                    { data: 'SupplierName', defaultContent: '' },
                    {
                        data: 'Price', className: 'text-end fw-semibold',
                        render: d => formatCurrency(d)
                    },
                    { data: 'Unit', defaultContent: '', className: 'text-center' },
                    {
                        data: 'Quantity', className: 'text-end',
                        render: function(data, type, row) {
                            const qty = data || 0;
                            const minStock = row.MinStock || 10;
                            const maxStock = row.MaxStock || 100;
                            
                            let colorClass = 'bg-success';
                            let aiBadge = '';
                            if (qty <= minStock) {
                                colorClass = 'bg-danger';
                                aiBadge = `<span class="badge bg-soft-danger text-danger border border-danger ms-2" style="font-size:0.65rem"><i class="fas fa-exclamation-triangle"></i> Nhập hàng</span>`;
                            } else if (qty >= maxStock) {
                                colorClass = 'bg-warning';
                                aiBadge = `<span class="badge bg-soft-warning text-warning border border-warning ms-2" style="font-size:0.65rem"><i class="fas fa-arrow-down"></i> Tồn cao</span>`;
                            }
                            
                            const percent = Math.min(100, Math.max(5, (qty / (maxStock == 0 ? 1 : maxStock)) * 100));

                            return `<div class="d-flex align-items-center justify-content-end" style="min-width: 140px;">
                                        <div class="d-flex flex-column align-items-end me-2" style="width: 60px;">
                                            <span class="fw-bold mb-1">${qty.toLocaleString()}</span>
                                            <div class="progress w-100" style="height: 4px; background-color: #e9ecef;">
                                                <div class="progress-bar ${colorClass}" role="progressbar" style="width: ${percent}%;"></div>
                                            </div>
                                        </div>
                                        ${aiBadge}
                                    </div>`;
                        }
                    },
                    // Action buttons
                    {
                        data: 'ProductId',
                        orderable: false,
                        className: 'text-center dt-action-col',
                        render: function (id, type, row) {
                            if (showInactive) {
                                // Inactive mode: chỉ hiển thị nút kích hoạt lại
                                return `
                                    <a class="btn-icon btn-sm btn-soft-success btn-reactivate" href="javascript:void(0);" 
                                       data-id="${id}" data-name="${(row.Name || '').replace(/"/g, '&quot;')}" 
                                       data-min="${row.MinStock || 0}" data-max="${row.MaxStock || 0}"
                                       title="Kích hoạt lại sản phẩm">
                                        <i class="fas fa-undo-alt" style="font-size:13px;"></i>
                                    </a>`;
                            }

                            // Active mode: giữ nguyên icons gốc
                            const totalQty = row.Quantity;
                            const isDisabled = totalQty > 0;
                            return `
                                    <a class="me-2 btn-product-detail" href="javascript:void(0);" data-id="${id}"><img src="/assets/img/icons/eye.svg" alt="view" /></a>
                                    <a class="me-2 btn-edit-product" href="javascript:void(0);" data-id="${id}"><img src="/assets/img/icons/edit.svg" alt="edit" /></a>
                                    <a class="${isDisabled ? 'btn-disabled' : 'confirm-text btn-delete-product'}" 
                                       href="javascript:void(0);" 
                                       data-id="${id}" 
                                       ${isDisabled ? 'style="cursor: not-allowed; opacity: 0.3;" title="Không thể xóa sản phẩm còn tồn kho"' : ''}>
                                        <img src="/assets/img/icons/delete.svg" alt="delete" />
                                    </a>
                                `;
                        }
                    }
                ],
                order: [[2, 'asc']], // Sắp xếp theo tên
                drawCallback: function () {
                    $('#tblProducts_filter input')
                        .attr('id', 'txtSearch')
                        .attr('placeholder', 'Tìm kiếm...');
                }
                });
            }

            // Gọi lần đầu khi trang load
            initProductTable();

            // ROW CLICK => toggle child row
            $('#tblProducts tbody').on('click', 'tr', function (e) {
                // 1. Chặn click vào nút, checkbox, input
                if ($(e.target).closest('a, button, input, label.checkboxs, .btn-product-detail').length) return;

                // 2. Chặn click vào child row đang mở
                if ($(this).hasClass('dt-child-row') || $(this).closest('.child-row-container').length) return;

                // 3. Chặn click vào child data table
                if ($(e.target).closest('.child-row-container').length) return;

                var tr = $(this);
                var row = tblProducts.row(tr);

                if (row.child.isShown()) {
                    // Đóng lại
                    row.child.hide();
                    tr.removeClass('dt-hasChild');
                } else {
                    // Mở ra
                    var rowData = row.data();
                    var html = formatChildRow(rowData); // Gọi hàm render mới

                    row.child(html).show();
                    tr.addClass('dt-hasChild'); // Thêm class để xoay dấu + thành -
                }
            });

            // Prevent row click when clicking checkbox explicitly (so selection works)
            $('#tblProducts tbody').on('click', '.row-select', function (e) {
                e.stopPropagation();
            });

            // Optional: toggle all checkbox behavior
            $('#select-all').on('change', function () {
                var checked = $(this).is(':checked');
                $('#tblProducts .row-select').prop('checked', checked);
            });

            $('#tblProducts tbody').on('click', 'td.dt-control', function () {
                var tr = $(this).closest('tr');
                var row = tblProducts.row(tr);
                var icon = $(this).find('i');

                if (row.child.isShown()) {
                    // Đang mở -> Đóng lại
                    row.child.hide();
                    tr.removeClass('shown');
                    icon.removeClass('fa-minus-circle text-danger').addClass('fa-plus-circle text-success');
                }
                else {
                    // Đang đóng -> Mở ra
                    // Gọi hàm format() để lấy HTML chi tiết
                    row.child(format(row.data())).show();
                    tr.addClass('shown');
                    icon.removeClass('fa-plus-circle text-success').addClass('fa-minus-circle text-danger');
                }
            });

            // Load data vào dropdownlist
            $.ajax({
                url: '/Admin/Product/LoadDropdowns',
                type: 'GET',
                data: function (d) {
                    d.branchId = $('#filterBranch').val();
                },
                success: function (res) {

                    // CATEGORY
                    $('#filterCategory').empty().append('<option value="">--Loại sản phẩm--</option>');
                    $.each(res.categories, function (i, item) {
                        $('#filterCategory').append(
                            `<option value="${item.CategoryId}">${item.Name}</option>`
                        );
                    });

                    // SUPPLIER
                    $('#filterSupplier').empty().append('<option value="">--Nhà cung cấp--</option>');
                    $.each(res.suppliers, function (i, item) {
                        $('#filterSupplier').append(
                            `<option value="${item.SupplierId}">${item.Name}</option>`
                        );
                    });

                    // BRANCH
                    $('#filterBranch').empty().append('<option value="">--Chi nhánh kho--</option>');
                    $.each(res.branches, function (i, item) {
                        $('#filterBranch').append(
                            `<option value="${item.BranchId}">${item.Name}</option>`
                        );
                    });

                    // WAREHOUSE
                    $('#filterWarehouse').empty().append('<option value="">--Kho--</option>');
                    $.each(res.warehouses, function (i, item) {
                        $('#filterWarehouse').append(
                            `<option value="${item.WarehouseId}">${item.Name}</option>`
                        );
                    });

                    // CATEGORY Edit
                    $('#CategoryId').empty().append('<option value="">--Loại sản phẩm--</option>');
                    $.each(res.categories, function (i, item) {
                        $('#CategoryId').append(`<option value="${item.CategoryId}">${item.Name}</option>`);
                    });

                    // SUPPLIER Edit
                    $('#SupplierId').empty().append('<option value="">--Nhà cung cấp--</option>');
                    $.each(res.suppliers, function (i, item) {
                        $('#SupplierId').append(`<option value="${item.SupplierId}">${item.Name}</option>`);
                    });
                }
            });

            // NÚT SEARCH
            $('#btnSearch').on('click', function () {
                tblProducts.ajax.reload();
            });

            // TOGGLE SẢN PHẨM ẨN
            $('#toggleInactive').on('change', function () {
                showInactive = $(this).is(':checked');

                // Phải destroy và rebuild DataTable để render lại cột Action
                if ($.fn.DataTable.isDataTable('#tblProducts')) {
                    tblProducts.destroy();
                }
                initProductTable();

                // Toggle badge hiển thị
                if (showInactive) {
                    $('#badgeInactiveMode').removeClass('d-none');
                } else {
                    $('#badgeInactiveMode').addClass('d-none');
                }
            });

            // SỰ KIỆN KÍCH HOẠT LẠI SẢN PHẨM (Inactive mode)
            $(document).on('click', '.btn-reactivate', function () {
                const productId = $(this).data('id');
                const productName = $(this).data('name');
                const currentMin = $(this).data('min') || 0;
                const currentMax = $(this).data('max') || 0;

                Swal.fire({
                    title: '<span style="font-size:1.1rem; font-weight:700;">Kích hoạt sản phẩm</span>',
                    html: `
                        <div style="text-align:left; padding: 0 8px;">
                            <div style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-radius:12px; padding:14px 16px; margin-bottom:18px; border-left: 4px solid #22c55e;">
                                <div style="font-size:0.78rem; color:#6b7280; margin-bottom:2px;">Sản phẩm</div>
                                <div style="font-weight:700; color:#111827; font-size:1rem;">${productName}</div>
                            </div>
                            <p style="font-size:0.82rem; color:#6b7280; margin-bottom:16px; line-height:1.5;">Thiết lập ngưỡng tồn kho trước khi kích hoạt lại sản phẩm này.</p>
                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                                <div>
                                    <label style="font-size:0.78rem; font-weight:600; color:#374151; display:block; margin-bottom:6px;"><i class="fas fa-arrow-down text-danger me-1" style="font-size:0.7rem;"></i>Tồn tối thiểu</label>
                                    <input type="number" id="swalMinStock" class="swal2-input" value="${currentMin}" min="0" placeholder="0" style="margin:0; width:100%; font-size:0.95rem; height:42px; border-radius:8px; border:1.5px solid #e5e7eb; text-align:center; font-weight:600;">
                                </div>
                                <div>
                                    <label style="font-size:0.78rem; font-weight:600; color:#374151; display:block; margin-bottom:6px;"><i class="fas fa-arrow-up text-warning me-1" style="font-size:0.7rem;"></i>Tồn tối đa</label>
                                    <input type="number" id="swalMaxStock" class="swal2-input" value="${currentMax}" min="0" placeholder="0" style="margin:0; width:100%; font-size:0.95rem; height:42px; border-radius:8px; border:1.5px solid #e5e7eb; text-align:center; font-weight:600;">
                                </div>
                            </div>
                        </div>`,
                    showCancelButton: true,
                    confirmButtonText: '<i class="fas fa-check-circle me-1"></i> Kích hoạt',
                    cancelButtonText: 'Hủy',
                    confirmButtonColor: '#22c55e',
                    cancelButtonColor: '#9ca3af',
                    customClass: {
                        popup: 'swal-reactivate-popup',
                        confirmButton: 'swal-btn-confirm',
                        cancelButton: 'swal-btn-cancel'
                    },
                    focusConfirm: false,
                    preConfirm: () => {
                        const minStock = parseInt($('#swalMinStock').val()) || 0;
                        const maxStock = parseInt($('#swalMaxStock').val()) || 0;

                        if (minStock < 0 || maxStock < 0) {
                            Swal.showValidationMessage('Giá trị không được âm');
                            return false;
                        }
                        if (maxStock > 0 && minStock > maxStock) {
                            Swal.showValidationMessage('Tồn tối thiểu không được lớn hơn tối đa');
                            return false;
                        }
                        return { minStock, maxStock };
                    }
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            Swal.fire({ allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                            const res = await $.post('/Admin/Product/ActiveProduct', {
                                productId: productId,
                                minStock: result.value.minStock,
                                maxStock: result.value.maxStock,
                                __RequestVerificationToken: $('input[name=__RequestVerificationToken]').val()
                            });

                            if (res.success) {
                                await Swal.fire({
                                    icon: 'success',
                                    title: '<span style="font-weight:700;">Đã kích hoạt!</span>',
                                    html: `<span style="color:#6b7280;">Sản phẩm <b>${productName}</b> đã được đưa trở lại danh sách.</span>`,
                                    timer: 2000,
                                    timerProgressBar: true,
                                    showConfirmButton: false
                                });
                                tblProducts.ajax.reload(null, false);
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Thất bại',
                                    text: res.message || 'Không thể kích hoạt sản phẩm',
                                    confirmButtonColor: '#ef4444'
                                });
                            }
                        } catch (err) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi hệ thống',
                                text: 'Kết nối máy chủ thất bại',
                                confirmButtonColor: '#ef4444'
                            });
                        }
                    }
                });
            });

            $(document).on("keyup",
                "#tblProducts_filter input",
                function () {
                    clearTimeout(window.searchTimer);
                    window.searchTimer = setTimeout(function () {
                        if (tblProducts) {
                            tblProducts.ajax.reload();
                        }
                    }, 400);
                }
            );

            $(document).on("change",
                "#filterWarehouse, #filterSupplier, #filterBranch, #filterCategory",
                function () {
                    if (tblProducts) {
                        tblProducts.ajax.reload();
                    }
                }
            );

            $('#filterBranch').on('change', function () {
                var branchId = $(this).val();

                $.ajax({
                    url: '/Admin/Product/LoadWarehousesByBranch',
                    type: 'GET',
                    data: { branchId: branchId },
                    success: function (warehouses) {

                        $('#filterWarehouse').empty().append('<option value="">--Kho--</option>');

                        $.each(warehouses, function (i, item) {
                            $('#filterWarehouse').append(
                                `<option value="${item.WarehouseId}">${item.Name}</option>`
                            );
                        });
                    }
                });
            });



            // Xư lý Popup Edit Product
            $("#ImageFile").on("change", function () {
                const file = this.files[0];
                if (!file) return;

                let reader = new FileReader();
                reader.onload = function (e) {
                    $("#PreviewImg").attr("src", e.target.result);
                };
                reader.readAsDataURL(file);
            });

            // Image preview when user selects new file
            $('#ImageFile').on('change', function () {
                var fi = this.files && this.files[0];
                if (!fi) return;
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#PreviewImg').attr('src', e.target.result);
                };
                reader.readAsDataURL(fi);
            });

            $(document).on('click', '.btn-edit-product', function (e) {
                e.preventDefault();

                // Lấy ID từ thuộc tính data-id trên nút vừa click
                var productId = $(this).data('id');
                $("#btnSaveProduct").text('Cập nhật');
                // Gọi hàm xử lý
                editProduct(productId);
            });

            $(document).on('click', '#btnSaveProduct', function (e) {
                e.preventDefault();

                var productId = $(this).data('id');

                // Gọi hàm xử lý
                saveProduct();
            });

            $(document).on('click', '.btn-product-detail', async function (e) {
                e.preventDefault();

                // Lấy ID từ thuộc tính data-id trên nút vừa click
                var productId = $(this).data('id');

                // Gọi hàm xử lý
                await showProductDetails(productId);
            });

            $(document).on('click', '.btn-delete-product', function (e) {
                e.preventDefault();

                // Lấy ID từ thuộc tính data-id trên nút vừa click
                var productId = $(this).data('id');
                // Gọi hàm xử lý
                deleteProduct(productId);
            });
        });

        // ======================================================
        // STATE TOÀN CỤC CHO FORM
        // ======================================================
        let tempFiles = [];            // Ảnh tạm khi thêm sản phẩm
        let currentProductId = 0;      // 0 = Add, >0 = Edit


        /* Product + Image manager (Add mode: temp images, Edit mode: real images)
Requires jQuery and Bootstrap modal. */

        (function ($) {
            'use strict';

            // STATE
            var tempFiles = [];         // list of temp filenames returned from server (only in Add mode)
            var currentProductId = 0;   // 0 => Add mode, >0 => Edit mode
            var $previewZone = $('#PreviewZone');
            var $imageInput = $('#ImageFiles');
            var $thumbnailInput = $('#ImageFile'); // single thumbnail optional
            var $modalEl = $('#modalProductEdit');

            // ---------------------------
            // PUBLIC: open Add modal
            // ---------------------------
            window.addProduct = function () {
                currentProductId = 0;
                tempFiles = [];

                // reset form and preview
                $('#frmProductEdit')[0].reset();
                $previewZone.empty();
                $('#PreviewImg').attr('src', '/assets/img/logo-black.png');
                $('#ProductId').val('');

                // show modal
                $("#btnSaveProduct").text('Thêm Sản phẩm');
                $modalEl.modal('show');
            };

            // ---------------------------
            // PUBLIC: open Edit modal
            // ---------------------------
            window.editProduct = function (id) {
                if (!id) return;
                currentProductId = parseInt(id, 10);
                tempFiles = []; // tempFiles not used for edit by default

                $previewZone.empty();
                $('#frmProductEdit')[0].reset();

                // load product
                $.ajax({
                    url: '/Admin/Product/GetProductById',
                    type: 'GET',
                    data: { id: currentProductId },
                    dataType: 'json'
                }).done(function (res) {
                    if (!res) {
                        Swal.fire('Lỗi', 'Không tìm thấy sản phẩm', 'error');
                        return;
                    }

                    // populate fields (safe)
                    $('#ProductId').val(res.ProductId || '');
                    $('#Name').val(res.Name || '');
                    $('#CategoryId').val(res.CategoryId == null ? '' : res.CategoryId);
                    $('#SupplierId').val(res.SupplierId == null ? '' : res.SupplierId);
                    $('#Barcode').val(res.Barcode || '');
                    $('#Price').val(res.Price != null ? parseFloat(res.Price).toFixed(2) : '');
                    $('#Unit').val(res.Unit || '');
                    $('#MinStock').val(res.MinStock != null ? res.MinStock : '');
                    $('#MaxStock').val(res.MaxStock != null ? res.MaxStock : '');
                    $('#Description').val(res.Description || '');

                    $('#PreviewImg').attr('src', res.Image && res.Image.length ? res.Image : '/assets/img/logo-black.png');

                    // load existing product images (real images)
                    loadExistingProductImages(currentProductId);

                    $modalEl.modal({ backdrop: 'static' });
                    $modalEl.modal('show');
                }).fail(function () {
                    Swal.fire('Lỗi', 'Lấy thông tin sản phẩm thất bại', 'error');
                });
            };

            // format /Date(...) or ISO to yyyy-mm-dd for input[type=date]
            function formatToInputDate(v) {
                if (!v) return '';
                var msMatch = /\/Date\((\d+)(?:[-+]\d+)?\)\//.exec(v);
                if (msMatch) {
                    var d = new Date(parseInt(msMatch[1], 10));
                    return d.toISOString().slice(0, 10);
                }
                try {
                    var d2 = new Date(v);
                    if (!isNaN(d2)) return d2.toISOString().slice(0, 10);
                } catch (e) { }
                return '';
            }

            // ---------------------------
            // LOAD existing images for EDIT mode
            // ---------------------------
            function loadExistingProductImages(productId) {
                $previewZone.empty();
                $.get('/Product/GetAllProductImageByProductId', { productId: productId })
                    .done(function (res) {
                        if (!res || !res.data) return;
                        res.data.forEach(function (img) {
                            appendRealImagePreview(img.ImageId, img.ImageUrl);
                        });
                    })
                    .fail(function () {
                        console.warn('Failed to load product images');
                    });
            }

            // append a real image block (has data-img-id)
            function appendRealImagePreview(imageId, imageUrl) {
                $previewZone.append(
                    '<div class="m-2 position-relative" data-img-id="' + imageId + '">' +
                    '<img src="' + imageUrl + '" style="width:120px;height:120px;object-fit:cover;border:1px solid #ddd;border-radius:4px;" />' +
                    '<button type="button" class="btn btn-sm btn-danger delete-img-btn" style="position:absolute;top:0;right:0;">X</button>' +
                    '</div>'
                );
            }

            // append a temp image block (data-temp)
            function appendTempImagePreview(tempFileName, tempPath) {
                $previewZone.append(
                    '<div class="m-2 position-relative" data-temp="' + tempFileName + '">' +
                    '<img src="' + tempPath + '" style="width:120px;height:120px;object-fit:cover;border:1px solid #ddd;border-radius:4px;" />' +
                    '<button type="button" class="btn btn-sm btn-danger delete-temp-btn" style="position:absolute;top:0;right:0;">X</button>' +
                    '</div>'
                );
            }

            // ---------------------------
            // File input change (shared)
            // ---------------------------
            $imageInput.on('change', function () {
                var files = Array.from(this.files || []);
                if (!files.length) return;

                // If Add mode (no product id yet) => upload temp for each; else upload directly to product
                if (!currentProductId || currentProductId === 0 || currentProductId === '0') {
                    files.forEach(function (f) { uploadTempImage(f); });
                } else {
                    files.forEach(function (f) { uploadDirectProductImage(f, currentProductId); });
                }

                // reset input to allow re-select same file later
                this.value = '';
            });

            // ---------------------------
            // Upload a single temp image (Add mode)
            // ---------------------------
            function uploadTempImage(file) {
                var fd = new FormData();
                fd.append('file', file);


                $.ajax({
                    url: '/Product/UploadTempImage',
                    method: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false
                }).done(function (dto) {
                    // dto expected { FileName, TempPath }
                    if (!dto || !dto.FileName) return;
                    tempFiles.push(dto.FileName);
                    appendTempImagePreview(dto.FileName, dto.TempPath);
                }).fail(function () {
                    Swal.fire('Lỗi', 'Upload ảnh tạm thất bại', 'error');
                });
            }

            // ---------------------------
            // Upload direct to product (Edit mode)
            // ---------------------------
            function uploadDirectProductImage(file, productId) {
                var fd = new FormData();
                fd.append('file', file);
                fd.append('productId', productId);


                $.ajax({
                    url: '/Product/CreateProductImage',
                    method: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false
                }).done(function (dto) {
                    // dto expected { ImageId, ImageUrl }
                    if (!dto || !dto.ImageId) return;
                    appendRealImagePreview(dto.ImageId, dto.ImageUrl);
                }).fail(function () {
                    Swal.fire('Lỗi', 'Upload ảnh vào product thất bại', 'error');
                });
            }

            // ---------------------------
            // Delete handlers (delegated)
            // - .delete-img-btn => real image (edit mode)
            // - .delete-temp-btn => temp image (add mode)
            // ---------------------------
            $previewZone.on('click', '.delete-img-btn', function () {
                var $div = $(this).closest('div[data-img-id]');
                var imageId = $div.data('img-id');
                if (!imageId) return;

                
                $.post('/Product/DeleteProductImage', { id: imageId })
                    .done(function (res) {
                        if (res && res.success) $div.remove();
                        else Swal.fire('Lỗi', 'Xóa ảnh thất bại', 'error');
                    }).fail(function () {
                        Swal.fire('Lỗi', 'Xóa ảnh thất bại', 'error');
                    });
            });

            $previewZone.on('click', '.delete-temp-btn', function () {
                var $div = $(this).closest('div[data-temp]');
                var fileName = $div.data('temp');
                if (!fileName) return;

                // remove from local tempFiles list
                tempFiles = tempFiles.filter(function (x) { return x !== fileName; });

                // optional: tell server to delete the temp file immediately if backend supports it
                if (typeof window.deleteTempImageOnServer === 'function') {
                    // if user provided a custom delete handler, call it
                    window.deleteTempImageOnServer(fileName).then(function () { $div.remove(); }).catch(function () { $div.remove(); });
                } else {
                    // send request if endpoint exists; otherwise just remove preview & keep server cleanup for cron
                    $.post('/Product/DeleteTempImage', { fileName: fileName })
                        .always(function () {
                            $div.remove();
                        });
                }
            });

            // ---------------------------
            // SAVE PRODUCT (shared for Add + Edit)
            // - Add: call AddProduct => server returns productId => MoveTempImages => done
            // - Edit: call UpdateProduct => done
            // ---------------------------
            window.saveProduct = function () {
                var $btn = $('#btnSaveProduct');
                $btn.prop('disabled', true).text('Saving...');

                // client validation minimal
                var name = $('#Name').val();
                if (!name || !name.trim()) {
                    Swal.fire('Lỗi', 'Vui lòng nhập tên sản phẩm', 'warning');
                    $btn.prop('disabled', false).text('Save Changes');
                    return;
                }

                var name = $('#Name').val();
                var categoryId = $('#CategoryId').val();
                var supplierId = $('#SupplierId').val();
                var barcode = $('#Barcode').val();
                var price = $('#Price').val();
                var unit = $('#Unit').val();
                var minStock = $('#MinStock').val();
                var maxStock = $('#MaxStock').val();

                // validate
                if (!name || !name.trim()) {
                    Swal.fire('Lỗi', 'Vui lòng nhập tên sản phẩm', 'warning');
                    $btn.prop('disabled', false).text('Save Changes');
                    return;
                }
                if (!categoryId || !categoryId.trim()) {
                    Swal.fire('Lỗi', 'Vui lòng chọn danh mục', 'warning');
                    $btn.prop('disabled', false).text('Save Changes');
                    return;
                }
                if (!supplierId || !supplierId.trim()) {
                    Swal.fire('Lỗi', 'Vui lòng chọn nhà cung cấp', 'warning');
                    $btn.prop('disabled', false).text('Save Changes');
                    return;
                }
                if (!barcode || !barcode.trim()) {
                    Swal.fire('Lỗi', 'Vui lòng nhập mã vạch', 'warning');
                    $btn.prop('disabled', false).text('Save Changes');
                    return;
                }
                if (!price || !price.trim()) {
                    Swal.fire('Lỗi', 'Vui lòng nhập giá sản phẩm', 'warning');
                    $btn.prop('disabled', false).text('Save Changes');
                    return;
                }
                if (!unit || !unit.trim()) {
                    Swal.fire('Lỗi', 'Vui lòng nhập đơn vị tính', 'warning');
                    $btn.prop('disabled', false).text('Save Changes');
                    return;
                }
                if (!minStock || !minStock.trim()) {
                    Swal.fire('Lỗi', 'Vui lòng nhập tồn kho tối thiểu', 'warning');
                    $btn.prop('disabled', false).text('Save Changes');
                    return;
                }
                if (!maxStock || !maxStock.trim()) {
                    Swal.fire('Lỗi', 'Vui lòng nhập tồn kho tối đa', 'warning');
                    $btn.prop('disabled', false).text('Save Changes');
                    return;
                }

                // build FormData
                var fd = new FormData();
                var productId = $('#ProductId').val() || '';
                fd.append('ProductId', productId);
                fd.append('Name', name);
                fd.append('CategoryId', $('#CategoryId').val() || '');
                fd.append('SupplierId', $('#SupplierId').val() || '');
                fd.append('Barcode', $('#Barcode').val() || '');
                fd.append('Price', $('#Price').val() || '');
                fd.append('Unit', $('#Unit').val() || '');
                fd.append('MinStock', $('#MinStock').val() || '');
                fd.append('MaxStock', $('#MaxStock').val() || '');
                fd.append('Description', $('#Description').val() || '');

                // optional thumbnail file
                var thumb = ($thumbnailInput && $thumbnailInput.length) ? $thumbnailInput[0].files[0] : null;
                if (thumb) fd.append('Image', thumb);

                // anti-forgery

                // choose endpoint
                var isAdd = !productId || productId === '0';
                var endpoint = isAdd ? '/Admin/Product/CreateProduct' : '/Admin/Product/UpdateProduct';

                $.ajax({
                    url: endpoint,
                    method: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false,
                    dataType: 'json'
                }).done(function (res) {
                    if (!res) {
                        Swal.fire('Lỗi', 'Server không trả về dữ liệu', 'error');
                        return;
                    }

                    if (!res.success) {
                        var msg = res.message || 'Lưu thất bại';
                        if (res.errors && Array.isArray(res.errors)) msg += '\n' + res.errors.join('\n');
                        Swal.fire('Lỗi', msg, 'error');
                        return;
                    } else {
                        Swal.fire({
                            title: "Thành công!",
                            text: "Thông tin sản phẩm đã được lưu trữ.",
                            icon: "success",
                            confirmButtonText: "Hoàn tất",
                            confirmButtonColor: "#28a745",
                            timer: 2000,
                            timerProgressBar: true,
                            didClose: () => {
                                $('#modalProductEdit').modal('hide');

                                if ($.fn.dataTable.isDataTable('#tblProducts')) {
                                    $('#tblProducts').DataTable().ajax.reload(null, false);
                                }
                            }
                        });
                    }

                    var newProductId = res.productId || productId || 0;

                    // If Add mode and we have temp files, move them to product folder
                    if (isAdd && tempFiles.length > 0) {
                        // move temp files
                        $.ajax({
                            url: '/Product/MoveTempImages',
                            method: 'POST',
                            data: { productId: newProductId, files: tempFiles },
                            traditional: true // array param support
                        }).done(function (mvRes) {
                            // optional check mvRes.success
                            finalizeSave();
                        }).fail(function () {
                            Swal.fire('Cảnh báo', 'Sản phẩm được tạo nhưng chuyển ảnh tạm thất bại', 'warning');
                            finalizeSave();
                        });
                    } else {
                        finalizeSave();
                    }

                    function finalizeSave() {
                        // if was Add, set currentProductId so user can continue editing if desired
                        if (isAdd) {
                            $('#ProductId').val(newProductId);
                            currentProductId = newProductId;
                        }
                        // close modal for update; for add keep modal open (UX choice)
                        if (!isAdd) {
                            var m = bootstrap.Modal.getInstance($modalEl[0]);
                            if (m) m.hide();
                        } else {
                            // after adding and moving images, refresh preview to show real images
                            if (currentProductId) loadExistingProductImages(currentProductId);
                        }

                        // refresh table
                        if (typeof tblProducts !== 'undefined' && tblProducts.ajax) {
                            tblProducts.ajax.reload();
                        }
                    }

                }).fail(function () {
                    Swal.fire('Lỗi', 'Gọi server thất bại', 'error');
                }).always(function () {
                    $btn.prop('disabled', false).text('Save Changes');
                });
            };

            // expose helper to delete temp on server manually (optional)
            window.deleteTempImageOnServer = function (fileName) {
                return $.ajax({
                    url: '/Product/DeleteTempImage',
                    method: 'POST',
                    data: { fileName: fileName}
                });
            };

            // ensure PreviewZone delegate handlers are attached (in case script loaded after DOM)
            $(function () {
                // nothing else here; event handlers already bound above
            });

        }(jQuery));

    </script>
}

@section Styles {
    <style>
        /* =========================================
           1. NÚT MỞ RỘNG (+/-) CHUẨN XANH LÁ
           ========================================= */
        table.dataTable td.dt-control {
            text-align: center;
            cursor: pointer;
            color: #198754; /* Màu xanh lá */
            font-weight: bold;
            font-size: 1.1rem;
            vertical-align: middle;
            transition: color 0.2s;
        }

            /* Trạng thái đóng: Dấu cộng */
            table.dataTable td.dt-control::before {
                content: "+";
                display: inline-block;
               
                width: 24px;
                height: 24px;
                line-height: 22px; /* Căn giữa dọc */
                border-radius: 50%;
                border: 2px solid #198754;
                transition: all 0.2s ease;
            }

            /* Hover vào nút cộng */
            table.dataTable td.dt-control:hover::before {
                background-color: #198754;
                color: white;
                transform: scale(1.1);
            }

        /* Trạng thái mở: Dấu trừ */
        table.dataTable tr.dt-hasChild td.dt-control::before {
            content: "−"; /* Dấu trừ dài */
            background-color: #198754;
            color: white;
            border-color: #198754;
            transform: rotate(180deg); /* Xoay nhẹ hiệu ứng */
        }

        /* =========================================
           2. ANIMATION & CONTAINER CHI TIẾT
           ========================================= */
        .child-row-container {
            will-change: transform, opacity;
            backface-visibility: hidden;
            animation: smoothExpand 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            transform-origin: top;
            background-color: #f8f9fa;
            border-left: 5px solid #198754; /* Vạch xanh */
            border-radius: 0 8px 8px 8px;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.03);
            margin: 10px 0 10px 60px; /* Thụt lùi so với checkbox và nút + */
            overflow: hidden;
        }

        @@keyframes smoothExpand {
            0% {
                opacity: 0;
                transform: scaleY(0.9) translateY(-10px);
                filter: blur(2px);
            }

            100% {
                opacity: 1;
                transform: scaleY(1) translateY(0);
                filter: blur(0);
            }
        }

        /* Hiệu ứng xuất hiện từng dòng trong bảng chi tiết (Stagger) */
        .child-row-container table tbody tr {
            opacity: 0;
            animation: slideInRight 0.3s ease forwards;
        }

            .child-row-container table tbody tr:nth-child(1) {
                animation-delay: 0.05s;
            }

            .child-row-container table tbody tr:nth-child(2) {
                animation-delay: 0.1s;
            }

            .child-row-container table tbody tr:nth-child(3) {
                animation-delay: 0.15s;
            }

        @@keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* =========================================
           3. UI TINH CHỈNH KHÁC
           ========================================= */
        .productimgname {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .product-name {
            font-weight: 500;
            color: #333;
            text-decoration: none;
        }

            .product-name:hover {
                color: #198754;
            }

        /* Cột checkbox căn giữa */
        .dt-checkbox-col {
            vertical-align: middle;
        }
        .btn-disabled {
            filter: grayscale(1); /* Biến icon thành màu xám */
            pointer-events: none; /* Ngăn chặn click chuột */
            display: inline-block;
        }

            /* Hiển thị tooltip giải thích khi hover (tùy chọn) */
            .btn-disabled:hover {
                cursor: not-allowed;
            }

        /* Toggle inactive switch */
        .bg-soft-secondary { background-color: #e9ecef; }
        .inactive-toggle-wrapper .form-check-input { width: 2.25em; height: 1.15em; cursor: pointer; }
        .inactive-toggle-wrapper .form-check-input:checked { background-color: #6c757d; border-color: #6c757d; }

        /* Reactivate button */
        .btn-icon { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 0; border-radius: 6px; transition: all 0.2s ease; }
        .btn-soft-success { background-color: rgba(34,197,94,0.1); border: 1px solid transparent; color: #22c55e; }
        .btn-soft-success:hover { background-color: rgba(34,197,94,0.2); border-color: rgba(34,197,94,0.3); transform: translateY(-1px); color: #16a34a; }

        /* SweetAlert2 reactivate popup custom */
        .swal-reactivate-popup { border-radius: 16px !important; padding: 24px 20px !important; }
        .swal-btn-confirm { border-radius: 8px !important; font-weight: 600 !important; padding: 10px 28px !important; font-size: 0.9rem !important; }
        .swal-btn-cancel { border-radius: 8px !important; font-weight: 600 !important; padding: 10px 28px !important; font-size: 0.9rem !important; }

    </style>
}