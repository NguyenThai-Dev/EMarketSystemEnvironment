<!-- PRODUCT EDIT AND INSERT MODAL -->
<div class="modal fade" id="modalProductEdit" tabindex="-1" aria-hidden="true" data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Edit Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="frmProductEdit">

                    @Html.AntiForgeryToken()

                    <input type="hidden" id="ProductId" />

                    <div class="row g-3">

                        <div class="col-lg-4 col-sm-6">
                            <label class="form-label">Tên sản phẩm</label>
                            <input type="text" id="Name" class="form-control" />
                        </div>

                        <div class="col-lg-4 col-sm-6">
                            <label class="form-label">Loại</label>
                            <select id="CategoryId" class="form-select"></select>
                        </div>

                        <div class="col-lg-4 col-sm-6">
                            <label class="form-label">Nhà cung cấp</label>
                            <select id="SupplierId" class="form-select"></select>
                        </div>

                        <div class="col-lg-4 col-sm-6">
                            <label class="form-label">Barcode</label>
                            <input type="text" id="Barcode" class="form-control" />
                        </div>

                        <div class="col-lg-4 col-sm-6">
                            <label class="form-label">Giá</label>
                            <input type="text" id="Price" class="form-control" />
                        </div>

                        <div class="col-lg-4 col-sm-6">
                            <label class="form-label">Đơn vị tính</label>
                            <input type="text" id="Unit" class="form-control" />
                        </div>

                        <div class="col-lg-6 col-sm-6">
                            <label class="form-label">Số lượng tối thiểu</label>
                            <input type="number" id="MinStock" class="form-control" />
                        </div>

                        <div class="col-lg-6 col-sm-6">
                            <label class="form-label">Số lượng tối đa</label>
                            <input type="number" id="MaxStock" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Ghi chú</label>
                            <textarea id="Description" rows="3" class="form-control"></textarea>
                        </div>

                        <!-- IMAGE UPLOAD -->
                        <div class="col-lg-12">
                            <div class="form-group">
                                <label> Hình ảnh đại diện của sản phẩm</label>

                                @* Thumbnail Upload Image *@
                                <div class="image-upload">
                                    <input type="file" id="ImageFile" class="form-control" />
                                    <div class="image-uploads">
                                        <img src="~/assets/img/icons/upload.svg" alt="img" />
                                        <h4>Drag and drop a file to upload Thumbnail</h4>
                                    </div>
                                </div>
                                <div id="ImagePreview"
                                     class="rounded overflow-hidden d-flex justify-content-center align-items-center"
                                     style="width:120px; height:120px; border: 1px solid #ddd; background-color: #f8f9fa;">
                                    <img id="PreviewImg"
                                         src="/assets/img/logo-black.png"
                                         class="img-fluid"
                                         alt="Ảnh xem trước"
                                         style="width:100%; height:100%; object-fit:cover;" />
                                </div>

                                @* Product Image Input *@
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>Hình ảnh về sản phẩm</label>

                                        <div class="image-upload">
                                            <input type="file" id="ImageFiles" name="ImageFiles" class="form-control" multiple />

                                            <div class="image-uploads mt-2 border p-3 rounded text-center" style="cursor:pointer;">
                                                <img src="~/assets/img/icons/upload.svg" alt="img" />
                                                <h4>Drag and drop or select multiple images</h4>
                                            </div>
                                        </div>

                                        <!-- Preview zone -->
                                        <div id="PreviewZone" class="d-flex flex-wrap mt-3"></div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button class="btn btn-primary" id="btnSaveProduct">Xác nhận</button>
            </div>

        </div>
    </div>
</div>

