        }

        /* Animation cho child row */
.child-row-container {
    /* Ép trình duyệt tối ưu phần cứng cho hiệu ứng */
    will-change: transform, opacity;
    backface-visibility: hidden;

    /* Animation mới: mượt và có độ nảy nhẹ */
    animation: smoothExpand 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: top;
    background-color: #f8f9fa;
    padding: 15px;
    border-left: 5px solid #198754;
    border-radius: 0 8px 8px 0;
    box-shadow: inset 0 2px 10px rgba(0,0,0,0.03);
}

@@keyframes smoothExpand {
    0% {
        opacity: 0;
        transform: scaleY(0.95) translateY(-10px);
        filter: blur(2px); /* Hiệu ứng mờ nhẹ khi đang rơi xuống */
    }
    100% {
        opacity: 1;
        transform: scaleY(1) translateY(0);
        filter: blur(0);
    }
}
    /* Làm các dòng trong bảng con hiện ra lần lượt */
.child-row-container tbody tr {
    animation: fadeInRight 0.5s ease forwards;
    opacity: 0;
}

/* Tạo độ trễ cho từng dòng (tối đa 5 dòng đầu) */
.child-row-container tbody tr:nth-child(1) { animation-delay: 0.1s; }
.child-row-container tbody tr:nth-child(2) { animation-delay: 0.15s; }
.child-row-container tbody tr:nth-child(3) { animation-delay: 0.2s; }
.child-row-container tbody tr:nth-child(4) { animation-delay: 0.25s; }
.child-row-container tbody tr:nth-child(5) { animation-delay: 0.3s; }

@@keyframes fadeInRight {
    from {
        opacity: 0;
        transform: translateX(-15px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}
        .currency-input {
            color: #198754 !important; /* Màu xanh lá đặc trưng của tiền/thanh toán */
            letter-spacing: 1px;
        }
    </style>
}