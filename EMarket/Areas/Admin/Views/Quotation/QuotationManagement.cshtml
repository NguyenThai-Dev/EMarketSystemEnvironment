        // ==========================================

        function initDataTable() {
            if ($.fn.DataTable.isDataTable('#tblQuotation')) {
                $('#tblQuotation').DataTable().clear().destroy();
            }

            $.extend(true, $.fn.dataTable.defaults, {
                dom: 't<"bottom_controls"lp>',
                language: {
                    search: "",
                    searchPlaceholder: "Tìm kiếm...",
                    info: "",
                    infoEmpty: "",
                    infoFiltered: ""
                }
            });

            tblQuotation = $('#tblQuotation').DataTable({
                processing: true,
                serverSide: false, // Hoặc true tùy backend
                searching: false,
                ajax: {
                    url: CONFIG.API.GET_LIST,
                    type: 'POST',
                    data: function (d) {
                        return {
                            keyword: $('#keyword').val(), // Nếu có ô search bên ngoài
                            branchId: $('#filterBranch').val(),
                            status: $('#filterStatus').val(),
                            fromDate: $('#fromDate').val(),
                            toDate: $('#toDate').val()
                        };
                    },
                    dataSrc: 'data' // Trường chứa mảng data từ backend trả về
                },
                columns: [
                    { data: 'QuotationCode', render: (d) => `<span class="fw-bold text-primary cursor-pointer">${d}</span>` },
                    { data: 'CustomerName', render: (d, t, r) => `<div>${d}</div><small class="text-muted">${r.CustomerPhone || ''}</small>` },
                    { data: 'BranchName' },
                    { data: 'IssueDate', render: d => formatDate(d) },
                    {
                        data: 'ExpiryDate',
                        render: function (d, t, r) {
                            let dateStr = formatDate(d);
                            // Logic check hết hạn đơn giản
                            // Bạn có thể parse Date để so sánh chính xác hơn
                            return dateStr;
                        }
                    },
                    { data: 'FinalAmount', className: 'text-end fw-bold', render: d => formatCurrency(d) },
                    {
                        data: 'Status',
                        className: 'text-center',
                        render: function (d) {
                            if (d === 'Draft') return '<span class="badge bg-secondary">Nháp</span>';
                            if (d === 'Sent') return '<span class="badge bg-info">Đã gửi</span>';
                            if (d === 'Converted') return '<span class="badge bg-success">Đã chốt đơn</span>';
                            return `<span class="badge bg-light text-dark border">${d}</span>`;
                        }
                    },
                    {
                        data: 'QuotationId',
                        className: 'text-center',
                        render: function (id) {
                            return `<a href="javascript:void(0)" onclick="loadDetail(${id})" class="text-primary fs-5" title="Xem chi tiết"><i class="fa fa-eye"></i></a>`;
                        }
                    }
                ],
                order: [[3, 'desc']], // Sắp xếp theo ngày tạo mới nhất
                language: {
                    emptyTable: "Không có dữ liệu báo giá",
                    processing: "Đang tải..."
                }
            });
        }

        function loadDetail(id) {
            currentId = id;
            $('#d_TableBody').html('<tr><td colspan="7" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>');
            $('#modalDetail').modal('show');

            $.get('/Admin/Quotation/GetQuotationDetail', { id: id }, function (res) {
                if (res.success) {
                    var d = res.data;
                    state.currentQuoteId = id;

                    // 1. Thông tin cơ bản
                    $('#d_Code').text(d.QuotationCode);
                    $('#d_CusName').text(d.CustomerName || 'Khách lẻ');
                    $('#d_CusPhone').text(d.CustomerPhone || '---');
                    $('#d_CusAddress').text(d.CustomerAddress || '---');
                    $('#d_IssueDate').text(formatDate(d.IssueDate));
                    $('#d_ExpiryDate').text(formatDate(d.ExpiryDate));
                    $('#d_Creator').text(d.CreatorName);
                    $('#d_Branch').text(d.BranchName);

                    // 2. Xử lý Trạng thái & Badge
                    let statusBadge = '';
                    let actionBtnHtml = '';

                    switch (d.Status) {
                        case 'Draft':
                            statusBadge = '<span class="badge bg-secondary fs-6">Bản nháp</span>';
                            actionBtnHtml = `
            <button class="btn btn-warning me-2" onclick="editQuotation(${d.QuotationId})"><i class="fas fa-edit me-1"></i> Sửa</button>
            <button class="btn btn-danger me-2" onclick="deleteQuotation(${d.QuotationId})"><i class="fas fa-trash me-1"></i> Xóa</button>
            <button class="btn btn-primary" onclick="changeStatus(${d.QuotationId}, 'Sent')"><i class="fas fa-paper-plane me-1"></i> Gửi</button>
        `;
                            break;
                        case 'Sent':
                            statusBadge = '<span class="badge bg-info fs-6 text-white">Đã gửi</span>';
                            actionBtnHtml = `
            <button class="btn btn-warning me-2" onclick="editQuotation(${d.QuotationId})"><i class="fas fa-edit me-1"></i> Sửa</button>
            <button class="btn btn-outline-danger me-2" onclick="cancelQuotation(${d.QuotationId})"><i class="fas fa-ban me-1"></i> Hủy</button>
            <button class="btn btn-success" onclick="processConvert()"><i class="fas fa-check-circle me-1"></i> Chốt đơn</button>
        `;
                            break;
                        case 'Accepted':
                            statusBadge = '<span class="badge bg-primary fs-6">Khách đã chốt</span>';
                            actionBtnHtml = `
            <button class="btn btn-outline-danger me-2" onclick="cancelQuotation(${d.QuotationId})"><i class="fas fa-ban me-1"></i> Hủy phiếu</button>
            <button class="btn btn-success" onclick="processConvert()"><i class="fas fa-check-circle me-1"></i> Chốt đơn hàng</button>
        `;
                            break;
                        case 'Converted':
                            statusBadge = '<span class="badge bg-success fs-6">Đã tạo đơn hàng</span>';
                            $('#d_LinkOrder').removeClass('d-none');
                            $('#d_OrderId').text('#' + d.ConvertedOrderId);
                            // Đã chốt đơn thì không làm gì được nữa
                            break;
                        case 'Cancelled':
                            statusBadge = '<span class="badge bg-danger fs-6">Đã hủy</span>';
                            break;
                        case 'Expired':
                            statusBadge = '<span class="badge bg-warning text-dark fs-6">Hết hạn</span>';
                            // Hết hạn có thể cho phép gia hạn hoặc hủy
                            actionBtnHtml = `<button class="btn btn-outline-danger" onclick="cancelQuotation(${d.QuotationId})"><i class="fas fa-ban me-1"></i> Hủy phiếu</button>`;
                            break;
                    }
                    $('#d_StatusBadge').html(statusBadge);
                    $('#actionButtons').html(actionBtnHtml);

                    // 3. Ghi chú & Giảm giá
                    if (d.Note) { $('#d_Note').text(d.Note); $('#d_NoteBox').show(); } else { $('#d_NoteBox').hide(); }
                    $('#d_DiscountReason').text(d.DiscountReason ? "(" + d.DiscountReason + ")" : "");

                    // 4. Render Table
                    let html = '';
                    if (d.Details && d.Details.length > 0) {
                        d.Details.forEach((item, idx) => {
                            html += `
                        <tr>
                            <td class="ps-3">${idx + 1}</td>
                            <td><div class="fw-bold text-dark">${item.ProductName}</div></td>
                            <td class="text-center">${item.Unit || 'Món'}</td>
                            <td class="text-end fw-bold">${item.Quantity}</td>
                            <td class="text-end">${formatCurrency(item.UnitPrice)}</td>
                            <td class="text-end text-danger">-${formatCurrency(item.Discount)}</td>
                            <td class="text-end fw-bold text-primary pe-3">${formatCurrency(item.TotalPrice)}</td>
                        </tr>`;
                        });
                    }
                    $('#d_TableBody').html(html);

                    // 5. Footer Money
                    $('#d_TotalAmount').text(formatCurrency(d.TotalAmount));
                    $('#d_Discount').text("-" + formatCurrency(d.DiscountAmount));
                    $('#d_FinalAmount').text(formatCurrency(d.FinalAmount));

                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                    $('#modalDetail').modal('hide');
                }
            });
        }

        function processConvert() {
            Swal.fire({
                title: 'Chốt đơn hàng?',
                text: "Đơn hàng sẽ được tạo và trừ tồn kho.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#modalDetail').modal('hide');
                    Swal.fire({ title: 'Đang xử lý...', didOpen: () => Swal.showLoading() });

                    $.post(CONFIG.API.CONVERT_ORDER, { id: state.currentQuoteId }, function (res) {
                        if (res.success) {
                            Swal.fire('Thành công', res.message, 'success');
                            tblQuotation.ajax.reload();
                        } else {
                            Swal.fire('Thất bại', res.message, 'error');
                        }
                    });
                }
            });
        }

        function editQuotation(id) {
            // 1. Đóng Modal Detail trước
            $('#modalDetail').modal('hide');

            Swal.fire({ title: 'Đang tải dữ liệu...', didOpen: () => Swal.showLoading() });

            // 2. Lấy dữ liệu chi tiết (Reuse API cũ)
            $.get(CONFIG.API.GET_DETAIL, { id: id }, function (res) {
                Swal.close();

                if (res.success) {
                    let d = res.data;

                    // 3. Reset & Gán State cho Modal Create
                    state.items = []; // Reset giỏ hàng
                    state.currentQuoteId = d.QuotationId; // Lưu ID đang sửa (QUAN TRỌNG)

                    // Gán thông tin Header
                    $('#newBranchId').val(d.BranchId);
                    $('#newNote').val(d.Note);
                    $('#newExpiryDate').val(formatDateISO(d.ExpiryDate)); // Cần hàm helper format yyyy-MM-dd

                    // Gán thông tin Khách hàng
                    state.customer = {
                        id: d.CustomerId,
                        name: d.CustomerName,
                        phone: d.CustomerPhone
                        // Lưu ý: API GetDetail nên trả về thêm PointBalance của khách nếu muốn hiển thị điểm chuẩn
                    };

                    // Update UI Khách hàng
                    $('#txtCustomerSearch').val(d.CustomerName);
                    $('#customerSuggest').hide();
                    $('#customerInfoBox').removeClass('d-none');
                    $('#lblCustName').text(d.CustomerName);
                    $('#lblCustPhone').text(d.CustomerPhone);
                    $('#lblCustRank').text('---'); // API Detail chưa có rank, có thể để tạm
                    $('#lblCustPoint').text('?');  // API Detail chưa có point

                    // Gán thông tin Giảm giá & Điểm
                    // Giả định: ManualDiscount trong DB chính là tiền quy đổi từ điểm (nếu có dùng điểm)
                    // Nếu logic DB của bạn: manual_discount lưu cả tiền giảm tay + tiền điểm -> Cần tách ra nếu muốn hiển thị đúng.
                    // Ở đây ta làm đơn giản: Nếu DiscountReason có chứa chữ "điểm", ta cố gắng parse số điểm ra.

                    state.pointsUsed = 0;
                    state.discount = 0; // Giảm giá tay

                    // Logic phục hồi điểm (Basic)
                    // Nếu bạn đã lưu cột PointsUsed trong DB thì lấy thẳng ra gán vào state.pointsUsed
                    // Nếu chưa, tạm thời coi ManualDiscount là giảm giá tay hoàn toàn.

                    // Gán giá trị giảm giá tay vào ô input
                    // (Nếu ManualDiscount trong DB bao gồm cả điểm, bạn cần trừ tiền điểm ra trước khi gán vào ô này)
                    $('#txtManualDiscount').val(d.ManualDiscount);

                    // Gán danh sách sản phẩm
                    if (d.Details && d.Details.length > 0) {
                        state.items = d.Details.map(x => ({
                            id: x.ProductId,
                            name: x.ProductName,
                            price: x.UnitPrice,
                            qty: x.Quantity,
                            discount: x.Discount, // Giảm giá từng dòng
                            image: '' // API Detail có thể thiếu ảnh, chấp nhận null
                        }));
                    }

                    // 4. Mở Modal Create & Render lại
                    renderQuoteGrid(); // Hàm này sẽ tự gọi calculateTotals()

                    // Đổi tiêu đề Modal cho hợp ngữ cảnh
                    $('#modalCreate .modal-title').html('<i class="fa fa-edit me-2"></i>Cập nhật Báo Giá #' + d.QuotationCode);
                    $('#modalCreate').modal('show');

                } else {
                    Swal.fire('Lỗi', 'Không lấy được dữ liệu báo giá.', 'error');
                }
            });
        }

        // Helper để format ngày cho input type="date"
        function formatDateISO(jsonDate) {
            if (!jsonDate) return '';
            let date = new Date(jsonDate.match(/\d+/) ? parseInt(jsonDate.match(/\d+/)[0]) : jsonDate);
            // Trả về yyyy-MM-dd
            return date.toISOString().split('T')[0];
        }

        // ==========================================
        // 8. TIỆN ÍCH (UTILS)
        // ==========================================

        function formatCurrency(val) {
            return (val || 0).toLocaleString('vi-VN') + ' ₫';
        }

        function formatDate(jsonDate) {
            if (!jsonDate) return '';
            // Xử lý dạng /Date(123456)/ của .NET cũ hoặc ISO string
            let date;
            if (typeof jsonDate === 'string' && jsonDate.includes('/Date(')) {
                date = new Date(parseInt(jsonDate.match(/\d+/)[0]));
            } else {
                date = new Date(jsonDate);
            }
            return date.toLocaleDateString('vi-VN');
        }

        function debounce(func, wait) {
            let timeout;
            return function (...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }
        function cancelQuotation(id) {
            Swal.fire({
                title: 'Hủy báo giá này?',
                text: "Trạng thái sẽ chuyển sang 'Đã hủy' và không thể khôi phục.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Đồng ý hủy',
                cancelButtonText: 'Không'
            }).then((result) => {
                if (result.isConfirmed) {
                    changeStatus(id, 'Cancelled');
                }
            });
        }

        function deleteQuotation(id) {
            Swal.fire({
                title: 'Xóa vĩnh viễn?',
                text: "Bản nháp này sẽ bị xóa khỏi hệ thống.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Xóa ngay',
                cancelButtonText: 'Không'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Gọi API Delete riêng (hoặc dùng changeStatus nếu soft delete)
                    $.post('/Admin/Quotation/DeleteQuotation', { id: id }, function (res) {
                        if (res.success) {
                            $('#modalDetail').modal('hide');
                            Swal.fire('Đã xóa!', res.message, 'success');
                            tblQuotation.ajax.reload();
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    });
                }
            });
        }

        function changeStatus(id, status) {
            $.post('/Admin/Quotation/ChangeStatus', { id: id, status: status }, function (res) {
                if (res.success) {
                    Swal.fire('Thành công', 'Trạng thái đã được cập nhật', 'success');
                    $('#modalDetail').modal('hide');
                    tblQuotation.ajax.reload();
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            });
        }
    </script>
}
