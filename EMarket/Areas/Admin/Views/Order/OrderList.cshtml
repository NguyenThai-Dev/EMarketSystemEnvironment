@using EMarket.Modules.UserModule.Services.Interfaces
@{
    ViewBag.Title = "OrderList";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    // 1. Lấy UserContext & Check Admin
    var UserContext = System.Web.Mvc.DependencyResolver.Current.GetService<IUserContext>();
    bool IsAdmin = UserContext != null && UserContext.IsAdmin;
    int CurrentBranchId = UserContext != null ? UserContext.BranchId ?? 0 : 0;
}

<div class="page-wrapper">
    <div class="content">
        <div class="page-header">
            <div class="page-title">
                <h4>DANH SÁCH ĐƠN HÀNG</h4>
                <h6>Quản lý đơn đặt hàng của khách</h6>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-top">
                    <div class="search-set">
                        <div class="search-path">
                            <a class="btn btn-filter" id="filter_search">
                                <img src="~/assets/img/icons/filter.svg" alt="img" />
                                <span><img src="~/assets/img/icons/closes.svg" alt="img" /></span>
                            </a>
                        </div>
                        <div class="search-input">
                            <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img" /></a>
                        </div>
                    </div>
                </div>

                <div class="card" id="filter_inputs">
                    <div class="card-body pb-0">
                        <div class="row">
                            <div class="col-lg-2 col-sm-6 col-12">
                                <div class="form-group">
                                    <select id="ddlUser" class="select form-control">
                                        <option value="">-- Nhân viên --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    <select id="ddlBranch" class="select form-control">
                                        <option value="">-- Chi nhánh --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    <select id="ddlStatus" class="select form-control">
                                        <option value="">-- Trạng thái đơn --</option>
                                        <option value="Pending">Chờ xử lý</option>
                                        <option value="Processing">Đang xử lý</option>
                                        <option value="Shipped">Đang giao</option>
                                        <option value="Completed">Hoàn thành</option>
                                        <option value="Cancelled">Đã hủy</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-4 col-sm-6 col-12">
                                <div class="form-group">
                                    <div class="input-group">
                                        <input type="date" id="fromDate" class="form-control">
                                        <span class="input-group-text">đến</span>
                                        <input type="date" id="toDate" class="form-control">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-1 col-sm-6 col-12">
                                <div class="form-group d-flex">
                                    <a class="btn btn-filters ms-auto me-2" id="btnSearch" title="Tìm kiếm">
                                        <img src="~/assets/img/icons/search-whites.svg" alt="img" />
                                    </a>
                                    <a class="btn btn-danger" id="btnReset" title="Làm mới bộ lọc" style="background: #ff9f43; border: none;">
                                        <i class="fa fa-undo text-white"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="tblOrders" class="table datanew">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Mã Đơn</th>
                                <th>Khách Hàng</th>
                                <th>Chi nhánh</th>
                                <th>Ngày đặt</th>
                                <th>Tổng tiền</th>
                                <th>Thanh toán</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modalDetails" class="modal fade" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title" id="modalTitle">Chi tiết đơn hàng</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="OrderId" />

                <div class="row g-3">
                    <div class="col-lg-3 col-sm-6">
                        <div class="form-group">
                            <label class="form-label">Khách hàng</label>
                            <input type="text" id="CustomerNameDisplay" class="form-control" disabled />
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6">
                        <div class="form-group">
                            <label class="form-label">Chi nhánh</label>
                            <input type="text" id="BranchNameDisplay" class="form-control" disabled />
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6">
                        <div class="form-group">
                            <label class="form-label">Ngày đặt</label>
                            <input type="text" id="OrderDateDisplay" class="form-control" disabled />
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6">
                        <div class="form-group">
                            <label class="form-label">Thanh toán</label>
                            <input type="text" id="PaymentInfoDisplay" class="form-control fw-bold" disabled
                                   style="color: #2563eb; background: #eff6ff;" />
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <h6 class="text-secondary mb-2">Danh sách sản phẩm</h6>
                        <div class="table-responsive border rounded">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40%;">Sản phẩm</th>
                                        <th class="text-end">Số lượng</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end">Giảm giá</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody id="tblOrderDetailsBody">
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="4" class="text-end fw-bold">Tổng cộng:</td>
                                        <td class="text-end fw-bold text-primary fs-5">
                                            <span id="lblModalTotalAmount">0</span> đ
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-12">
                        <h5 class="text-primary mb-3"><i class="fa fa-edit"></i> Cập nhật trạng thái</h5>
                    </div>
                    <div class="col-lg-4 col-sm-6">
                        <div class="form-group">
                            <label class="form-label fw-bold">Trạng thái đơn hàng</label>
                            <select id="Status" class="form-select">
                                <option value="Pending">Chờ xử lý</option>
                                <option value="Processing">Đang xử lý</option>
                                <option value="Shipped">Đang giao hàng</option>
                                <option value="Completed">Hoàn thành</option>
                                <option value="Cancelled">Đã hủy</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-8 col-sm-6">
                        <div class="alert alert-info mt-4 mb-0 py-2">
                            <small><i class="fa fa-info-circle"></i> Bạn chỉ có thể cập nhật trạng thái đơn hàng tại đây.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <a href="javascript:void(0)" id="btnViewStockHistory" class="btn btn-outline-info me-auto" target="_blank">
                    <i class="fas fa-boxes"></i> Xem xuất kho
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> Đóng
                </button>
                <button type="button" id="btnSaveStatus" class="btn btn-primary">
                    <i class="fa fa-save"></i> Lưu trạng thái
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="~/assets/js/signalr-handler.js"></script>

    <script>
        /* =========================================================
           GLOBAL STATE
        ========================================================= */
        let tblOrders, listBranch, currentSignalRConnectionId = "";

        /* =========================================================
           HELPERS
        ========================================================= */
        function formatDate(jsonDateString) {
            if (!jsonDateString) return '—';

            let date;
            if (typeof jsonDateString === 'string' && jsonDateString.includes('/Date(')) {
                const match = jsonDateString.match(/\/Date\((\d+)\)\//);
                if (match) date = new Date(parseInt(match[1], 10));
            } else {
                date = new Date(jsonDateString);
            }

            if (!date || isNaN(date.getTime())) return '—';

            return date.toLocaleString('vi-VN', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function formatCurrency(val) {
            return (val || 0).toLocaleString('vi-VN');
        }

        function getStatusBadgeClass(status) {
            if (!status) return 'bg-lightgray';

            // Chuyển về chữ thường để so sánh không phân biệt hoa thường
            switch (status.toLowerCase()) {
                case 'pending':
                    return 'bg-lightgray';    // Màu xám: Mới tạo, chưa đụng vào
                case 'processing':
                    return 'bg-lightyellow';  // Màu vàng: Đang đóng gói/chuẩn bị
                case 'shipped':
                    return 'bg-lightblue';    // Màu xanh dương: Đang trên đường giao
                case 'completed':
                    return 'bg-lightgreen';   // Màu xanh lá: Thành công, kết thúc
                case 'cancelled':
                    return 'bg-lightred';     // Màu đỏ: Đơn lỗi hoặc khách hủy
                default:
                    return 'bg-secondary';    // Màu mặc định nếu có trạng thái lạ
            }
        }

        function resetFilters() {

            $('#ddlUser, #ddlBranch, #ddlStatus').val('').trigger('change');

            $('#toDate').val(new Date().toISOString().split('T')[0]).parent().find('#fromDate').val(new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]);

            $('#txtSearch').val('');

            if (typeof tblOrders !== 'undefined') {
                $('#txtSearch').val('');
                tblOrders.ajax.reload();
            }
        }

        function fixMapLink(url) {
            if (!url) return '';

            let cleanUrl = url.replace('/embed', '/maps');

            if (cleanUrl.includes('!1m18')) {
                return cleanUrl;
            }
            return cleanUrl;
        }

        async function loadSessionInfo() {
            try {
                window.CURRENT_BRANCH_ID = @Html.Raw(Json.Encode(CurrentBranchId));
                window.IS_ADMIN = @Html.Raw(Json.Encode(IsAdmin));
                return true;
            } catch (err) {
                console.error("Không lấy được session:", err);
            }
            return false;
        }

        function getOrderIdFromUrl() {
            const parts = window.location.pathname.split('/');
            const last = parts[parts.length - 1];
            return /^\d+$/.test(last) ? last : null;
        }

        const focusOrderId = getOrderIdFromUrl();


        /* =========================================================
           DROPDOWNS
        ========================================================= */
        function populateDropdown(selector, url, defaultText, valueField = "id", textField = "name") {
            return new Promise((resolve, reject) => {
                const ddl = $(selector);

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (response) {
                        // Kiểm tra cấu trúc response: response.data hay chỉ là response?
                        const data = response.data || response;
                        const isSuccess = response.success !== undefined ? response.success : true;

                        if (isSuccess && Array.isArray(data)) {
                            let html = `<option value="">${defaultText}</option>`;

                            $.each(data, function (i, item) {
                                const val = item[valueField];
                                const text = item[textField];

                                // Log để kiểm tra xem có lấy được giá trị không
                                if (val === undefined) {
                                    console.warn(`Cảnh báo: Không tìm thấy trường '${valueField}' trong item:`, item);
                                }

                                html += `<option value="${val || ''}">${text || ''}</option>`;
                            });

                            ddl.html(html);
                            resolve(data);
                        } else {
                            console.error("Dữ liệu không hợp lệ hoặc không phải mảng:", response);
                            reject("Invalid data format");
                        }
                    },
                    error: function (err) {
                        console.error(`Lỗi tải dropdown ${selector}:`, err);
                        reject(err);
                    }
                });
            });
        }

        async function initBranchData() {
            try {
                const rawData = await populateDropdown('#ddlBranch', '/Branch/GetAllBranch', '-- Chi nhánh --', "BranchId", "Name");

                listBranch = rawData.map(item => ({
                    id: item.BranchId,
                    name: item.Name
                }));

            } catch (error) {
                console.error("Không thể lấy danh sách chi nhánh:", error);
            }
        }

        /* =========================================================
           DATATABLE INIT (SERVER SIDE)
        ========================================================= */
        function initOrderTable() {

            if ($.fn.DataTable.isDataTable('#tblOrders')) {
                $('#tblOrders').DataTable().destroy();
            }

            $.extend(true, $.fn.dataTable.defaults, {
                dom: 't<"bottom_controls"lp>',
                language: {
                    search: "",
                    searchPlaceholder: "Tìm kiếm...",
                    info: "",
                    infoEmpty: "",
                    infoFiltered: ""
                }
            });
            const today = new Date().toISOString().split('T')[0];
            const lastWeek = new Date(Date.now() - 604800000).toISOString().split('T')[0];

            tblOrders = $('#tblOrders').DataTable({
                processing: true,
                serverSide: true,
                searching: true,
                responsive: true,
                pageLength: 10,
                order: [[1, 'desc']],

                ajax: {
                    url: '/Admin/Order/GetAllOrders',
                    type: 'POST',
                    data: function (d) {
                        return {

                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            UserId: $('#ddlUser').val(),
                            BranchId: $('#ddlBranch').val(),
                            Status: $('#ddlStatus').val(),
                            FromDate: $("#fromDate").val() || lastWeek,
                            ToDate: $("#toDate").val() || today,
                            Keyword: $('#txtSearch').val()
                        };
                    },
                    dataSrc: function (json) {
                        return json.data || [];
                    }
                },

                columns: [
                    {
                        className: 'dt-control',
                        orderable: false,
                        data: null,
                        defaultContent: '',
                        width: "20px"
                    },
                    {
                        data: 'OrderId',
                        render: function (data) {
                            return `<a href="javascript:void(0)" class="fw-bold text-primary">#${data}</a>`;
                        }
                    },
                    {
                        data: 'CustomerName',
                        defaultContent: 'Khách lẻ',
                        render: function (data, type, row) {
                            // Lấy chữ cái đầu làm avatar
                            const avatarChar = data ? data.charAt(0).toUpperCase() : 'K';
                            return `
                    <div class="d-flex align-items-center">
                        <div class="avatar-xs me-2 bg-soft-primary text-primary rounded-circle"
                             style="width:30px; height:30px; display:flex; align-items:center; justify-content:center; font-weight:bold; background:#e0f2f1; color:#00695c;">
                            ${avatarChar}
                        </div>
                        <div class="d-flex flex-column">
                            <span class="fw-medium">${data}</span>
                            ${row.CustomerPhone ? `<small class="text-muted">${row.CustomerPhone}</small>` : ''}
                        </div>
                    </div>
                `;
                        }
                    },
                    {
                        data: 'BranchId',
                        width: "15%",
                        defaultContent: '—',
                        render: function (branchId) {
                            const branch = listBranch.find(b => b.id == branchId);
                            return branch ? `<span class="badge bg-light text-dark border">${branch.name}</span>` : '—';
                        }
                    },
                    {
                        data: 'OrderDate',
                        render: d => formatDate(d)
                    },
                    {
                        data: 'TotalAmount',
                        className: 'text-end fw-bold',
                        render: d => formatCurrency(d)
                    },
                    {
                        data: null, // Dùng null để lấy cả object row
                        className: 'text-center',
                        width: "12%",
                        render: function (data, type, row) {
                            // Safe check
                            const method = row.PaymentMethod || 'N/A';
                            const status = row.PaymentStatus || 'Unpaid';

                            // Màu badge payment
                            let badgeClass = 'bg-lightgray'; // Mặc định (Pending/Unpaid)
                            if (status.toLowerCase() === 'completed' || status.toLowerCase() === 'paid') badgeClass = 'bg-lightgreen text-success border-success';
                            if (status.toLowerCase() === 'failed') badgeClass = 'bg-lightred text-danger border-danger';

                            // Icon method
                            let iconMethod = '<i class="fa fa-money-bill"></i>'; // Cash
                            if (method.toLowerCase().includes('card')) iconMethod = '<i class="fa fa-credit-card"></i>';
                            if (method.toLowerCase().includes('transfer')) iconMethod = '<i class="fa fa-university"></i>';

                            return `
                                    <div class="d-flex flex-column align-items-center">
                                        <span class="badges ${badgeClass} mb-1" style="font-size: 11px;">${status}</span>
                                        <small class="text-muted">${iconMethod} ${method}</small>
                                    </div>
                                `;
                        }
                    },
                    {
                        data: 'Status',
                        render: d =>
                            `<span class="badges ${getStatusBadgeClass(d)}">${d || ''}</span>`
                    },
                    {
                        data: 'OrderId',
                        orderable: false,
                        className: 'text-center',
                        render: function (id, type, row) {
                            const status = (row.Status || '').toLowerCase();
                            const isLocked = status === 'completed' || status === 'cancelled';

                            const icon = isLocked
                                ? '/assets/img/icons/eye.svg'
                                : '/assets/img/icons/edit.svg';

                            const title = isLocked
                                ? 'Xem chi tiết đơn hàng'
                                : 'Cập nhật trạng thái đơn hàng';

                            return `
                            <a href="javascript:void(0)"
                               class="js-open-order d-inline-flex align-items-center ${isLocked ? 'text-muted' : ''}"
                               data-id="${id}"
                               data-locked="${isLocked}"
                               title="${title}">
                                <img src="${icon}" />
                            </a>`;
                        }
                    }
                ],

                initComplete: function () {
                    const api = this.api();

                    const $input = $('#tblOrders_filter input');
                    $input
                        .attr('id', 'txtSearch')
                        .attr('placeholder', 'Tìm kiếm...');

                    if (focusOrderId) {
                        $input.val(focusOrderId);

                        $input.trigger('input');
                    }
                }
            });
        }

        /* =========================================================
           CHILD ROW
        ========================================================= */
        function formatChildRow(row) {
            const containerId = `detail-container-${row.OrderId}`;

            loadFullOrderDetail(row, containerId);

            return `
                            <div id="${containerId}" class="p-3 text-center bg-light border-start border-success border-3 m-2">
                                <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                <span class="ms-2 text-muted">Đang tải thông tin khách hàng & sản phẩm...</span>
                            </div>`;
        }

        function loadFullOrderDetail(orderData, containerId) {
            // 1. Chuẩn bị Request lấy thông tin khách hàng
            const customerPromise = (orderData.CustomerId && orderData.CustomerId > 0)
                ? $.ajax({ url: '/Customer/GetCustomerById', type: 'GET', data: { id: orderData.CustomerId } })
                : Promise.resolve(null); // Nếu không có ID thì trả về null ngay

            // 2. Chuẩn bị Request lấy địa chỉ giao hàng (Nếu có ID)
            const addressPromise = (orderData.DeliveryAddressId && orderData.DeliveryAddressId > 0)
                ? $.ajax({ url: '/Customer/GetCustomerAddressById', type: 'GET', data: { addressId: orderData.DeliveryAddressId } })
                : Promise.resolve(null); // Nếu null (nhận tại quầy) thì trả về null ngay

            // 3. Thực thi cả 2 song song (Promise.all)
            Promise.all([customerPromise, addressPromise])
                .then(([customerRes, addressRes]) => {
                    // Chuẩn hóa dữ liệu (phòng trường hợp API trả về dạng { data: ... })
                    const customer = customerRes && customerRes.customers ? customerRes.customers : customerRes;
                    const address = addressRes && addressRes.addresses ? addressRes.addresses : addressRes;

                    // Render HTML
                    const html = renderDetailHtml(customer, address, orderData);

                    // Hiển thị với hiệu ứng FadeIn
                    $(`#${containerId}`).html(html).hide().fadeIn(300).removeClass('text-center');
                })
                .catch(err => {
                    console.error(err);
                    $(`#${containerId}`).html(`
                                    <div class="alert alert-danger m-0">
                                        <i class="fa fa-exclamation-triangle"></i> Lỗi tải dữ liệu chi tiết.
                                        ${renderOrderTable(orderData)}
                                    </div>
                                `);
                });
        }

        function renderDetailHtml(customer, address, orderData) {

            /* ===============================
               KHỐI 1: CUSTOMER INFO
            =============================== */
            let customerHtml = '';

            if (customer) {
                const avatar = customer.UserImg || '/assets/img/logo-black.png';

                let typeClass = 'badge-standard';
                if (customer.CustomerType === 'VIP') typeClass = 'badge-vip';
                else if (customer.CustomerType === 'Member') typeClass = 'badge-member';

                customerHtml = `
                            <div class="customer-card">
                                <div class="customer-header">
                                    <img src="${avatar}" class="customer-avatar" alt="Avatar">
                                    <div class="customer-meta">
                                        <div class="customer-name">${customer.FullName}</div>
                                        <div class="customer-sub">
                                            <span class="badge ${typeClass}">${customer.CustomerType || 'Standard'}</span>
                                            <span class="customer-id">ID #${customer.CustomerId}</span>
                                        </div>
                                    </div>
                                </div>

                                <ul class="customer-info">
                                    <li>
                                        <i class="fa fa-phone"></i>
                                        <a href="tel:${customer.Phone}">${customer.Phone || '—'}</a>
                                    </li>
                                    <li>
                                        <i class="fa fa-envelope"></i>
                                        <span title="${customer.Email}">${customer.Email || 'Chưa cập nhật'}</span>
                                    </li>
                                    <li>
                                        <i class="fa fa-coins text-warning"></i>
                                        <span>Điểm tích lũy:
                                            <b class="text-success">
                                                ${(customer.PointBalance || 0).toLocaleString()}
                                            </b>
                                        </span>
                                    </li>
                                </ul>
                            </div>`;
            } else {
                customerHtml = `
                            <div class="empty-customer">
                                <i class="fa fa-user-slash"></i>
                                <div>Khách vãng lai</div>
                            </div>`;
            }

            /* ===============================
               KHỐI 2: SHIPPING ADDRESS
            =============================== */
            let shippingHtml = '';

            if (address) {
                const searchUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address.FullAddress)}`;
                const mapBtn = address.AddressUrl
                    ? `<a href="${searchUrl}" target="_blank" class="btn-map">
                                       <i class="fa fa-map-marked-alt"></i> Bản đồ
                                   </a>`
                    : '';

                shippingHtml = `
                            <div class="shipping-card">
                                <div class="shipping-title">
                                    <i class="fa fa-truck"></i> Giao hàng đến
                                </div>
                                <div class="shipping-address">
                                    ${address.FullAddress}
                                </div>
                                ${mapBtn}
                            </div>`;
            } else {
                shippingHtml = `
                            <div class="pickup-card">
                                <i class="fa fa-store"></i>
                                <div>
                                    <strong>Nhận tại cửa hàng</strong>
                                    <div class="pickup-note">Không yêu cầu giao hàng</div>
                                </div>
                            </div>`;
            }

            /* ===============================
       KHỐI: PAYMENT CARD
=============================== */
            const payStatus = orderData.PaymentStatus || 'Unpaid';
            const payMethod = orderData.PaymentMethod || 'Unknown';

            // Logic màu sắc cho Card
            let payClass = 'payment-pending';
            let payIcon = 'fa-clock';
            let payLabel = 'Chưa thanh toán';

            if (payStatus.toLowerCase() === 'completed') {
                payClass = 'payment-success';
                payIcon = 'fa-check-circle';
                payLabel = 'Đã thanh toán';
            } else if (payStatus.toLowerCase() === 'failed') {
                payClass = 'payment-failed';
                payIcon = 'fa-times-circle';
                payLabel = 'Thanh toán lỗi';
            }

            const paymentHtml = `
            <div class="payment-card ${payClass}">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="payment-title">
                            <i class="fa ${payIcon}"></i> ${payLabel}
                        </div>
                        <div class="payment-method">
                            <span>Phương thức:</span> <strong>${payMethod}</strong>
                        </div>
                    </div>
                    <div class="payment-amount">
                        ${formatCurrency(orderData.TotalAmount)}
                    </div>
                </div>
            </div>
        `;

            /* ===============================
               KHỐI 3: PRODUCT TABLE
            =============================== */
            const productTableHtml = renderOrderTable(orderData);

            /* ===============================
               LAYOUT
            =============================== */
            return `
                        <div class="order-detail-wrapper">
                            <div class="order-left">
                                <div class="section-title">Thông tin khách hàng</div>
                    ${customerHtml}
                    ${shippingHtml}
                    ${paymentHtml} </div>

                            <div class="order-right">
                                <div class="section-title">
                                    Chi tiết đơn hàng #${orderData.OrderId}
                                </div>
                                <div class="order-product-card">
                                    ${productTableHtml}
                                </div>
                            </div>
                        </div>`;
        }

        function renderOrderTable(data) {
            if (!data.OrderDetails || !data.OrderDetails.length) {
                return `<div class="p-4 text-center text-muted">Không có chi tiết sản phẩm</div>`;
            }

            const rows = data.OrderDetails.map(d => {
                const discount = d.Discount || 0;
                const total = (d.Quantity * (d.UnitPrice || 0)) - discount;
                const img = d.ProductImage || '/assets/img/logo-black.png';

                return `
                <tr>
                    <td class="align-middle">
                        <div class="d-flex align-items-center">
                             <img src="${img}" style="width:40px; height:40px; object-fit:cover; border-radius:4px; margin-right:10px; border:1px solid #eee;">
                            <div>
                                <div class="fw-medium text-dark">${d.ProductName}</div>
                                <div class="d-flex align-items-center small text-muted">
                                    <span class="me-2">SKU: ${d.ProductId}</span>
                                    ${d.Barcode ? `<span><i class="fa fa-barcode ms-1"></i> ${d.Barcode}</span>` : ''}
                                </div>
                            </div>
                        </div>
                    </td>
                    <td class="text-end align-middle">
                        <span class="badge bg-light text-dark border border-secondary" style="font-size:0.9em;">
                            x${d.Quantity}
                        </span>
                    </td>
                    <td class="text-end align-middle">${formatCurrency(d.UnitPrice)}</td>
                    <td class="text-end align-middle text-danger">-${formatCurrency(discount)}</td>
                    <td class="text-end align-middle fw-bold text-primary">${formatCurrency(total)}</td>
                </tr>`;
            }).join('');

            return `
                            <div class="table-responsive">
                                <table class="table table-hover table-striped mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 40%">Sản phẩm</th>
                                            <th class="text-end">SL</th>
                                            <th class="text-end">Đơn giá</th>
                                            <th class="text-end">Giảm</th>
                                            <th class="text-end">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>${rows}</tbody>
                                </table>
                            </div>
                            <div class="p-2 border-top bg-light text-end small">
                                <span class="text-muted me-2">Tổng số lượng: <b>${data.OrderDetails.reduce((a, b) => a + b.Quantity, 0)}</b></span>
                            </div>
                        `;
        }
        /* =========================================================
           EVENTS
        ========================================================= */
        $(document).ready(async function () {
            const sessionLoaded = await loadSessionInfo();

            if (sessionLoaded) {
                console.log("✅ Dữ liệu session đã sẵn sàng:", window.CURRENT_BRANCH_ID, window.IS_ADMIN);
                SignalRManager.init();
            }

            const today = new Date();
            const lastWeek = new Date();
            lastWeek.setDate(today.getDate() - 7);

            // Định dạng YYYY-MM-DD để input type="date" hiểu được
            $('#toDate').val(today.toISOString().split('T')[0]);
            $('#fromDate').val(lastWeek.toISOString().split('T')[0]);

            await Promise.all([
                populateDropdown('#ddlUser', '/User/GetAllUsers', '-- Nhân viên --', "UserId", "FullName"), initBranchData()
            ]);

            initOrderTable();

            $('#ddlUser, #fromDate, #toDate, #ddlBranch, #ddlStatus').on('change', function () {
                tblOrders.ajax.reload();
            });

            $('#tblOrders tbody').on('click', 'tr', function (e) {
                // 1. Chặn click vào nút, checkbox, input
                if ($(e.target).closest('a, button, input, label.checkboxs, .btn-product-detail').length) return;

                // 2. Chặn click vào child row đang mở
                if ($(this).hasClass('dt-child-row') || $(this).closest('.child-row-container').length) return;

                var tr = $(this);
                var row = tblOrders.row(tr);

                if (row.child.isShown()) {
                    // Đóng lại
                    row.child.hide();
                    tr.removeClass('dt-hasChild');
                } else {
                    // Mở ra
                    var rowData = row.data();
                    var html = formatChildRow(rowData); // Gọi hàm render mới

                    row.child(html).show();
                    tr.addClass('dt-hasChild'); // Thêm class để xoay dấu + thành -
                }
            });

            $('#btnReset').on('click', function () {
                resetFilters();
            });

            let typingTimer;                // Biến giữ thời gian đợi

            $(document).on('input', '#txtSearch', function () {
                clearTimeout(typingTimer);

                typingTimer = setTimeout(function () {
                    tblOrders.ajax.reload();
                }, 300);
            });

            $(document).on('click', '.js-open-order', function () {
                const id = $(this).data('id');
                const isLocked = $(this).data('locked') === true;

                openOrderModal(id, isLocked);
            });
        });

        /* =========================================================
           MODAL
        ========================================================= */
        async function openOrderModal(id, isLocked) {
            try {
                const res = await $.get('/Order/GetOrder', { id });
                if (!res.success) return;

                const d = res.data;

                $('#OrderId').val(d.OrderId);
                $('#CustomerNameDisplay').val(d.CustomerName);

                const branch = listBranch.find(b => b.id == d.BranchId) ?? "--";

                $('#BranchNameDisplay').val(branch.name);
                $('#OrderDateDisplay').val(formatDate(d.OrderDate));
                $('#lblModalTotalAmount').text(formatCurrency(d.TotalAmount));
                $('#Status').val(d.Status);

                const payMethod = d.PaymentMethod || 'N/A';
                const payStatus = d.PaymentStatus || 'Unpaid';
                $('#PaymentInfoDisplay').val(`${payMethod} (${payStatus})`);

                const historyUrl = `/Admin/Warehouse/StockHistory/${d.OrderId}`;
                $('#btnViewStockHistory').attr('href', historyUrl);

                const $tbody = $('#tblOrderDetailsBody').empty();
                d.OrderDetails.forEach(x => {
                    const total = (x.Quantity * x.UnitPrice) - (x.Discount || 0);
                    $tbody.append(`
                                            <tr>
                                                <td>${x.ProductName}</td>
                                                <td class="text-end">${x.Quantity}</td>
                                                <td class="text-end">${formatCurrency(x.UnitPrice)}</td>
                                                <td class="text-end text-danger">${formatCurrency(x.Discount || 0)}</td>
                                                <td class="text-end fw-bold">${formatCurrency(total)}</td>
                                            </tr>`);
                });

                if (isLocked) {
                    $('#Status')
                        .prop('disabled', true)
                        .attr('title', 'Đơn hàng đã hoàn tất, không thể thay đổi trạng thái');

                    $('#btnSaveStatus')
                        .prop('disabled', true)
                        .addClass('opacity-50 pe-none')
                        .attr('title', 'Đơn hàng đã hoàn tất hoặc bị huỷ, không thể cập nhật');
                } else {
                    $('#Status')
                        .prop('disabled', false);
                    $('#btnSaveStatus')
                        .prop('disabled', false)
                        .removeClass('opacity-50 pe-none')
                        .removeAttr('title');
                }

                $('#modalDetails').modal('show');

            } catch {
                Swal.fire('Lỗi', 'Không thể tải chi tiết đơn hàng', 'error');
            }
        }

        /* =========================================================
           SAVE STATUS
        ========================================================= */
        $('#btnSaveStatus').on('click', function () {

            const payload = {
                orderId: $('#OrderId').val(),
                status: $('#Status').val(),
                ConnectionId: currentSignalRConnectionId
            };

            $.post('/Order/UpdateStatus', payload)
                .done(res => {
                    if (!res.success) {
                        Swal.fire('Thất bại', res.message, 'error');
                        return;
                    }

                    $('#modalDetails').modal('hide');
                    tblOrders.ajax.reload(null, false);

                    Swal.fire('Thành công', 'Cập nhật trạng thái thành công', 'success');
                });
        });
    </script>
}


