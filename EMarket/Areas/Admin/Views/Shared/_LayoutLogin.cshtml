<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0" />
    <meta name="description"
          content="EMarket Admin là nền tảng quản trị vận hành dành cho doanh nghiệp bán lẻ và chuỗi siêu thị, hỗ trợ quản lý hàng hóa, kiểm soát tồn kho, quy trình nhập – xuất – bán hàng, quản lý cửa hàng, người dùng, phân quyền và báo cáo vận hành toàn diện." />
    <meta name="keywords"
          content="EMarket, quản trị doanh nghiệp bán lẻ, vận hành chuỗi siêu thị, POS doanh nghiệp, quản trị hàng hóa, quản lý tồn kho, quản trị cửa hàng, hệ thống bán lẻ, quản lý người dùng, phân quyền nâng cao" />
    <meta name="author" content="EMarket Enterprise Platform" />
    <meta name="robots" content="noindex, nofollow" />
    <title>EMarket Admin — Nền tảng quản trị vận hành cho chuỗi siêu thị & bán lẻ</title>

    <link href="~/assets/img/EMarket_Logo.png" rel="icon">
    <link href="~/assets/css/login.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    @RenderSection("styles", required: false)
</head>
<body>
    @RenderBody()

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            localStorage.removeItem('access_token');
        });
    </script>
   

    @RenderSection("Scripts", required: false)
    @RenderSection("Style", required: false)
</body>
</html>
