    <script>

    function loadSystemEvents() {
        const apiUrl = '@Url.Action("GetLatestSystemEvents", "Logs", new { area = "Admin" })';

        $.get(apiUrl, function (events) {
            let html = '';

            if (events && events.length > 0) {
                events.forEach(item => {
                    const themeCls = item.IsError ? 'text-danger' : 'text-primary';
                    const bgCls = item.IsError ? 'bg-danger-light' : 'bg-primary-light';
                    const iconCls = item.IsError ? 'fas fa-exclamation-triangle' : 'fas fa-history';
                    const targetUrl = '@Url.Action("SystemLog", "Logs", new { area = "Admin" })';

                    // 2. Xử lý thời gian (Backend trả về RawDate hoặc string)
                    let timeDisplay = item.CreatedAt;
                    if (typeof moment !== 'undefined') {
                        timeDisplay = moment(item.RawDate).fromNow();
                    }
                    html += `
<li class="notification-message">
    <a href="${targetUrl}">
        <div class="media d-flex align-items-center">
            <span class="avatar avatar-sm flex-shrink-0">
                <img src="${item.UserImgUrl}" onerror="this.src='/assets/img/EMarket_Logo.png'" class="rounded-circle" />
            </span>
            <div class="media-body flex-grow-1 ms-2">
                <p class="noti-details mb-0">
                    <span class="fw-bold ${item.IsError ? 'text-danger' : 'text-dark'}">${item.Title}</span>
                    <span class="text-muted"> ${item.Summary}</span>
                </p>
                <p class="noti-time mb-0">
                    <small class="text-muted">${moment(item.RawDate).fromNow()}</small>
                </p>
            </div>
        </div>
    </a>
</li>`;
                });

                // Badge đỏ trên chuông: Chỉ hiện tổng số sự kiện mới
                $('.nav-item.dropdown .badge').text(events.length).show();
            } else {
                html = '<li class="p-3 text-center text-muted">Không có hoạt động mới</li>';
                $('.nav-item.dropdown .badge').hide();
            }

            $('.notification-list').html(html);

        }).fail(function() {
            $('.notification-list').html('<li class="p-2 text-center text-danger small">Lỗi kết nối Server</li>');
        });
        }

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        // 2. Hàm xóa Cookie sau khi đã sử dụng
        function deleteCookie(name) {
            document.cookie = name + '=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
        }


        $(document).ready(function () {
            
            // 3. Kiểm tra và thực hiện luân chuyển Token
            const apiToken = getCookie("access_token");
            if (apiToken) {
                // Lưu vào LocalStorage để đồng bộ với cách Login thường
                localStorage.setItem('access_token', apiToken);

                // Xóa ngay Cookie để tránh rò rỉ và bảo mật
                deleteCookie("access_token");

                console.log("Hệ thống: Đã đồng bộ Token từ Google Auth vào LocalStorage.");
            }

            if ($.fn.DataTable || $.fn.dataTable) {
                $.fn.dataTable.ext.errMode = 'none';
            }
            
            // --- DARK MODE LOGIC ---
            const currentTheme = localStorage.getItem('theme');
            if (currentTheme === 'dark') {
                $('body').attr('data-theme', 'dark');
                $('#darkModeIcon').removeClass('fa-moon text-secondary').addClass('fa-sun text-warning');
            }

            $('#darkModeToggle').click(function () {
                const body = $('body');
                if (body.attr('data-theme') === 'dark') {
                    body.removeAttr('data-theme');
                    localStorage.setItem('theme', 'light');
                    $('#darkModeIcon').removeClass('fa-sun text-warning').addClass('fa-moon text-secondary');
                } else {
                    body.attr('data-theme', 'dark');
                    localStorage.setItem('theme', 'dark');
                    $('#darkModeIcon').removeClass('fa-moon text-secondary').addClass('fa-sun text-warning');
                }
            });
        });

        // --- DEBOUNCE LOGIC FOR SIGNALR FETCH ---
        let logFetchTimeout = null;
        function debounceLoadSystemEvents() {
            if (logFetchTimeout) {
                clearTimeout(logFetchTimeout);
            }
            logFetchTimeout = setTimeout(function() {
                loadSystemEvents();
            }, 3000); // Chờ 3 giây, nếu không có log mới thì mới fetch 1 lần
        }

    $(function () {
        loadSystemEvents();

        if ($.connection && $.connection.systemLogHub) {
            const logHub = $.connection.systemLogHub;

            logHub.client.onNewLogReceived = function (res) {
                console.log("Layout nhận tín hiệu onNewLogReceived:", res.type);

                // Thay vì loadSystemEvents() gọi ngay, dùng debounce
                debounceLoadSystemEvents();

                $(document).trigger('onSignalR_UpdateLogTable', [res]);

                const isAtLogPage = window.location.pathname.toLowerCase().includes("systemlog");
                if (!isAtLogPage && typeof toastr !== 'undefined') {
                    if (res.type === "AppLog" && (res.data && (res.data.LogLevel === "ERROR" || res.data.LogLevel === "FATAL"))) {
                        toastr.error("Hệ thống phát sinh lỗi mới!");
                    }
                }
            };


            logHub.client.forceLogout = function (message) {
                console.warn("Tín hiệu Kick nhận được từ Server!");

                // Sử dụng SweetAlert2 để thông báo
                Swal.fire({
                    title: 'Thông báo hệ thống!',
                    text: message || "Tài khoản của bạn đã bị khóa hoặc hết hạn!",
                    icon: 'warning',
                    showConfirmButton: false, // Không cho tắt bằng nút
                    allowOutsideClick: false, // Không cho click ra ngoài để tắt
                    allowEscapeKey: false,    // Không cho nhấn Esc
                    timer: 3000,              // Tự động đóng sau 3 giây
                    timerProgressBar: true,   // Hiển thị thanh đếm ngược
                    showClass: {
                        popup: 'animate__animated animate__fadeInDown' 
                    },
                    hideClass: {
                        popup: 'animate__animated animate__fadeOutUp'   
                    },
                }).then((result) => {
                    localStorage.clear();
                    sessionStorage.clear();

                    const cookies = document.cookie.split(";");
                    for (let i = 0; i < cookies.length; i++) {
                        const cookie = cookies[i];
                        const eqPos = cookie.indexOf("=");
                        const name = eqPos > -1 ? cookie.substr(0, eqPos).trim() : cookie.trim();
                        document.cookie = name + "=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/";
                    }
                    window.location.replace("/Admin/Admin/AccessDenied");
                });
            };

            logHub.client.updateLogTable = function (res) {
                console.log("Layout nhận tín hiệu updateLogTable...");
                $(document).trigger('onSignalR_UpdateLogTable', [res]);
            };

            $.connection.hub.start().done(function () {
                console.log("SignalR Global Connected!");
                logHub.server.joinLogGroup();
            });
        }

        const currentPath = window.location.pathname.toLowerCase();
        $('#sidebar-menu a[href]').each(function () {
            const href = $(this).attr('href');
            if (href && href !== '#' && !href.startsWith('javascript')) {
                if (currentPath === href.toLowerCase()) {
                    $(this).addClass('active');
                    $(this).closest('li.submenu').find('a').first().addClass('active subdrop');
                    $(this).closest('li.submenu').find('ul').first().show();
                }
            }
        });
    });
    </script>
</body>
</html>
