@using EMarket.Modules.UserModule.Services.Interfaces
@{
    ViewBag.Title = "Quản lý Chi phí";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    // 1. Lấy UserContext & Check Admin
    var UserContext = System.Web.Mvc.DependencyResolver.Current.GetService<IUserContext>();
    bool IsAdmin = UserContext != null && UserContext.IsAdmin;
}

<div class="page-wrapper">
    <div class="content">

        <div class="page-header">
            <div class="page-title">
                <h4>QUẢN LÝ CHI PHÍ</h4>
                <h6>Theo dõi dòng tiền chi tiêu tại các chi nhánh</h6>
            </div>
            <div class="page-btn">
                <a href="javascript:void(0);" class="btn btn-added" onclick="openExpenseModal()">
                    <img src="~/assets/img/icons/plus.svg" alt="img" />Tạo phiếu chi
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                @* ... Phần Filter HTML giữ nguyên ... *@
                <div class="table-top">
                    <div class="search-set">
                        <div class="search-path">
                            <a class="btn btn-filter" id="filter_search">
                                <img src="~/assets/img/icons/filter.svg" alt="img" />
                                <span><img src="~/assets/img/icons/closes.svg" alt="img" /></span>
                            </a>
                        </div>
                        <div class="search-input">
                            <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img" /></a>
                        </div>
                    </div>
                </div>
                <div class="card" id="filter_inputs">
                    <div class="card-body pb-0">
                        <div class="row">
                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    @Html.DropDownList("branchId", (SelectList)ViewBag.Branches, "-- Chi nhánh --", new { @class = "select form-control", @id = "filterBranch" })
                                </div>
                            </div>
                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    @Html.DropDownList("categoryId", (SelectList)ViewBag.Categories, "-- Loại chi phí --", new { @class = "select form-control", @id = "filterCategory" })
                                </div>
                            </div>
                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group"><input type="date" id="fromDate" class="form-control" placeholder="Từ ngày" /></div>
                            </div>
                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group"><input type="date" id="toDate" class="form-control" placeholder="Đến ngày" /></div>
                            </div>
                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    <select id="filterStatus" class="select form-control">
                                        <option value="">-- Trạng thái --</option>
                                        <option value="Pending">Chờ duyệt</option>
                                        <option value="Approved">Đã duyệt</option>
                                        <option value="Rejected">Từ chối</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-1 col-sm-6 col-12">
                                <div class="form-group">
                                    <a class="btn btn-filters ms-auto" onclick="tblExpense.ajax.reload()"><img src="~/assets/img/icons/search-whites.svg" alt="img" /></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="tblExpense" class="table datanew table-hover">
                        <thead>
                            <tr>
                                <th>Ngày tạo</th>
                                <th>Chi nhánh / Loại</th>
                                <th>Nội dung</th>
                                <th>Người tạo</th>
                                <th class="text-end">Số tiền</th>
                                <th class="text-center">Hóa đơn</th>
                                <th style="min-width: 200px;">Thông tin xử lý</th>
                                <th class="text-center">Hành động</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                        <tfoot>
                            <tr class="bg-light fw-bold">
                                <td colspan="4" class="text-end">TỔNG CỘNG</td>
                                <td class="text-end text-danger fs-6" id="lblTotalAmount">0 ₫</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

@* ... Code Modal Expense cũ của bạn ... *@
<div class="modal fade" id="modalExpense" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content expense-modal">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-file-invoice-dollar me-2 text-primary"></i>Tạo phiếu chi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmExpense">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Chi nhánh <span class="text-danger">*</span></label>
                            @Html.DropDownList("BranchId", (SelectList)ViewBag.Branches, "-- Chọn chi nhánh --", new { @class = "form-select" })
                        </div>
                        <div class="col-12">
                            <label class="form-label">Hạng mục chi phí <span class="text-danger">*</span></label>
                            @Html.DropDownList("CategoryId", (SelectList)ViewBag.Categories, "-- Chọn loại chi phí --", new { @class = "form-select" })
                        </div>
                        <div class="col-md-7">
                            <label class="form-label">Số tiền</label>
                            <input type="text" id="AmountDisplay" class="form-control amount-input" placeholder="0 ₫" />
                            <input type="hidden" name="Amount" id="Amount" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Ngày chi</label>
                            <input type="date" name="ExpenseDate" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Diễn giải</label>
                            <textarea name="Note" class="form-control" rows="2" placeholder="Ví dụ: Mua văn phòng phẩm..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Đính kèm hóa đơn</label>
                            <input type="file" name="refImageFile" class="form-control" accept="image/*" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                <button class="btn btn-primary px-4" onclick="submitExpense()"><i class="fa fa-save me-1"></i> Lưu</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalApproveExpense" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 flex-column align-items-center pb-0">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal"></button>
                <div class="d-flex justify-content-center align-items-center bg-success bg-opacity-10 rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <i class="fa fa-check fa-2x text-success"></i>
                </div>
                <h5 class="modal-title fw-bold text-dark text-center">Duyệt phiếu chi</h5>
            </div>
            <div class="modal-body px-4 py-3">
                <input type="hidden" id="approveExpenseId" />
                <div class="mb-2">
                    <label class="form-label fw-semibold text-secondary small text-uppercase">Hình thức thanh toán</label>
                    <select id="approvePaymentMethod" class="form-select bg-light border-0 py-2">
                        <option value="Cash">💵 Tiền mặt</option>
                        <option value="Transfer">🏦 Chuyển khoản</option>
                        <option value="Card">💳 Thẻ tín dụng/Ghi nợ</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0 row g-2">
                <div class="col-6 m-0"><button class="btn btn-light w-100 fw-semibold py-2 rounded-3" data-bs-dismiss="modal">Hủy</button></div>
                <div class="col-6 m-0"><button class="btn btn-success w-100 fw-semibold py-2 rounded-3 shadow-sm" onclick="submitApproveExpense()">Duyệt ngay</button></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalRejectExpense" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 flex-column align-items-center pb-0">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal"></button>
                <div class="d-flex justify-content-center align-items-center bg-danger bg-opacity-10 rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <i class="fa fa-times fa-2x text-danger"></i>
                </div>
                <h5 class="modal-title fw-bold text-dark text-center">Từ chối phiếu chi</h5>
                <p class="text-muted small text-center mb-0 mt-1">Vui lòng nhập lý do từ chối</p>
            </div>
            <div class="modal-body px-4 py-3">
                <input type="hidden" id="rejectExpenseId" />
                <textarea id="rejectReason" class="form-control bg-light border-0 p-3" rows="3" style="resize: none;" placeholder="Lý do từ chối..."></textarea>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0 row g-2">
                <div class="col-6 m-0"><button class="btn btn-light w-100 fw-semibold py-2 rounded-3" data-bs-dismiss="modal">Hủy</button></div>
                <div class="col-6 m-0"><button class="btn btn-danger w-100 fw-semibold py-2 rounded-3 shadow-sm" onclick="submitRejectExpense()">Xác nhận</button></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var tblExpense;
        // Lấy giá trị Admin từ Razor xuống JS
        var isAdmin = @Json.Encode(IsAdmin);

        $(document).ready(function () {
            // Set default dates
            const now = new Date();
            const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
            $('#fromDate').val(firstDay.toISOString().split('T')[0]);
            $('#toDate').val(now.toISOString().split('T')[0]);
            $('input[name="ExpenseDate"]').val(now.toISOString().split('T')[0]);

            initDataTable();

            // Event Filters
            $('#filterBranch, #filterCategory, #filterStatus, #fromDate, #toDate').on('change', function () {
                tblExpense.ajax.reload();
            });

            // Format Amount Input
            $('#AmountDisplay').on('input', function () {
                let raw = $(this).val().replace(/[^\d]/g, '');
                if (!raw) { $('#Amount').val(''); $(this).val(''); return; }
                let value = parseInt(raw, 10);
                $('#Amount').val(value);
                $(this).val(value.toLocaleString('vi-VN') + ' ₫');
            });
        });

        // Hàm helper parse Date từ JSON /Date(...)/
        function parseJsonDate(jsonDate) {
            if (!jsonDate) return null;
            try {
                const match = String(jsonDate).match(/\/Date\(([+-]?\d+)\)\/?/);
                return match ? new Date(parseInt(match[1])) : null;
            } catch { return null; }
        }

        function formatDate(dateObj) {
            if (!dateObj) return '';
            return dateObj.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }); // + ' ' + dateObj.toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'});
        }

        function initDataTable() {
            if ($.fn.DataTable.isDataTable('#tblExpense')) {
                $('#tblExpense').DataTable().clear().destroy();
            }

            $.extend(true, $.fn.dataTable.defaults, {
                dom: 't<"bottom_controls"lp>',

                language: {
                    search: "",
                    searchPlaceholder: "Tìm kiếm...",
                    info: "",
                    infoEmpty: "",
                    infoFiltered: "",
                },
            });

            tblExpense = $('#tblExpense').DataTable({
                processing: true,
                serverSide: false,
                responsive: true,
                searching: false,
                ajax: {
                    url: '/Admin/Expense/GetExpenseList',
                    type: 'POST',
                    data: function (d) {
                        return {
                            branchId: $('#filterBranch').val(),
                            categoryId: $('#filterCategory').val(),
                            fromDate: $('#fromDate').val(),
                            toDate: $('#toDate').val(),
                            status: $('#filterStatus').val()
                        };
                    },
                    dataSrc: function (json) {
                        // Chỉ tính tổng tiền cho các khoản có Status là 'Approved'
                        let totalApproved = 0;
                        if (json.data && Array.isArray(json.data)) {
                            json.data.forEach(x => {
                                if (x.Status === 'Approved') {
                                    totalApproved += (x.Amount || 0);
                                }
                            });
                        }

                        $('#lblTotalAmount').html(
                            totalApproved.toLocaleString('vi-VN') + ' ₫ ' +
                            '<br/><small class="text-muted fw-normal">(Chỉ tính phiếu đã duyệt)</small>'
                        );

                        return json.data || [];
                    }
                },
                columns: [
                    {
                        data: 'ExpenseDate',
                        render: d => formatDate(parseJsonDate(d))
                    },
                    {
                        data: 'BranchName',
                        render: function(d, type, row){
                            return `<div class="fw-bold text-dark">${d}</div>
                                    <span class="badge bg-light text-secondary border mt-1">${row.CategoryName}</span>`;
                        }
                    },
                    {
                        data: 'Note',
                        render: d => d ? `<span title="${d}">${d.length > 50 ? d.substring(0, 50) + '...' : d}</span>` : '—'
                    },
                    {
                        data: 'UserName',
                        render: d => `<div class="d-flex align-items-center"><div class="avatar avatar-xs me-2 bg-primary rounded-circle text-white d-flex justify-content-center align-items-center" style="width:24px;height:24px;font-size:10px;">${d.charAt(0)}</div>${d}</div>`
                    },
                    {
                        data: 'Amount',
                        className: 'text-end',
                        render: d => `<span class="fw-bold text-danger fs-6">${(d || 0).toLocaleString('vi-VN')} ₫</span>`
                    },
                    {
                        data: 'RefImage',
                        className: 'text-center',
                        render: d => d ? `<a href="javascript:void(0);" onclick="viewImage('${d}')"><img src="${d}" class="rounded border" style="width:36px;height:36px;object-fit:cover;" /></a>` : '<span class="text-muted text-xs">Không có</span>'
                    },
                    {
                        // CỘT THÔNG TIN XỬ LÝ (MỚI)
                        data: 'Status',
                        render: function(d, type, row){
                            let html = '';
                            if (d === 'Approved') {
                                let methodLabel = row.PaymentMethod === 'Cash' ? 'Tiền mặt' :
                                                  row.PaymentMethod === 'Transfer' ? 'Chuyển khoản' :
                                                  row.PaymentMethod === 'Card' ? 'Thẻ' : row.PaymentMethod;

                                html = `<span class="badge bg-success-light text-success"><i class="fa fa-check-circle me-1"></i>Đã duyệt</span>`;
                                if(row.ApproverName && row.ApproverName !== 'N/A'){
                                    let date = formatDate(parseJsonDate(row.ApprovedAt));
                                    html += `<div class="text-xs text-muted mt-1">Bởi: <b>${row.ApproverName}</b> (${date})</div>`;
                                }
                                if(methodLabel) html += `<div class="text-xs mt-1 text-primary"><i class="fa fa-wallet me-1"></i>${methodLabel}</div>`;

                            } else if (d === 'Rejected') {
                                html = `<span class="badge bg-danger-light text-danger"><i class="fa fa-times-circle me-1"></i>Từ chối</span>`;
                                if(row.RejectorName && row.RejectorName !== 'N/A'){
                                    let date = formatDate(parseJsonDate(row.RejectedAt));
                                    html += `<div class="text-xs text-muted mt-1">Bởi: <b>${row.RejectorName}</b> (${date})</div>`;
                                }
                                if(row.RejectionReason){
                                    html += `<div class="text-xs text-danger mt-1 fst-italic" title="${row.RejectionReason}">Lý do: ${row.RejectionReason}</div>`;
                                }
                            } else {
                                html = `<span class="badge bg-warning-light text-warning">Chờ duyệt</span>`;
                            }
                            return html;
                        }
                    },
                    {
                        // CỘT HÀNH ĐỘNG
                        data: 'ExpenseId',
                        className: 'text-center',
                        orderable: false,
                        render: function (id, type, row) {
                            let html = '<div class="action-icons d-flex justify-content-center">';

                            // LOGIC: Chỉ hiển thị nút Duyệt/Từ chối nếu là Admin và trạng thái là Pending
                            if (isAdmin && row.Status === 'Pending') {
                                html += `
                                    <a class="me-2" onclick="openApproveModal(${id})" title="Duyệt" style="cursor:pointer;">
                                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-1 d-flex align-items-center justify-content-center" style="width:32px;height:32px;">
                                            <i class="fa fa-check"></i>
                                        </div>
                                    </a>
                                    <a class="me-2" onclick="openRejectModal(${id})" title="Từ chối" style="cursor:pointer;">
                                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-1 d-flex align-items-center justify-content-center" style="width:32px;height:32px;">
                                            <i class="fa fa-times"></i>
                                        </div>
                                    </a>
                                `;
                            }

                            if (row.Status === 'Pending') {
                                html += `
                                    <a onclick="deleteExpense(${id})" title="Xóa" style="cursor:pointer;">
                                        <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle p-1 d-flex align-items-center justify-content-center" style="width:32px;height:32px;">
                                            <i class="fa fa-trash"></i>
                                        </div>
                                    </a>
                                `;
                            }

                            html += '</div>';
                            return html;
                        }
                    }
                ],
                order: [[0, 'desc']]
            });
        }

        // --- ACTIONS ---

        function openExpenseModal() {
            $('#frmExpense')[0].reset();
            const now = new Date().toISOString().split('T')[0];
            $('input[name="ExpenseDate"]').val(now);
            $('#modalExpense').modal('show');
        }

        // [NEW] Mở Modal Duyệt
        function openApproveModal(id) {
            $('#approveExpenseId').val(id);
            $('#approvePaymentMethod').val('Cash'); // Default
            $('#modalApproveExpense').modal('show');
        }

        // [NEW] Submit Duyệt kèm Payment Method
        function submitApproveExpense() {
            const id = $('#approveExpenseId').val();
            const method = $('#approvePaymentMethod').val();

            $.post('/Admin/Expense/UpdateStatus', {
                expenseId: id,
                status: 'Approved',
                paymentMethod: method // Gửi thêm trường này về server
            }, function (res) {
                $('#modalApproveExpense').modal('hide');
                if (res.success) {
                    Swal.fire({ icon: 'success', title: 'Đã duyệt', text: 'Phiếu chi đã được hạch toán.', timer: 1500, showConfirmButton: false });
                    tblExpense.ajax.reload();
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            });
        }

        function openRejectModal(id) {
            $('#rejectExpenseId').val(id);
            $('#rejectReason').val('');
            $('#modalRejectExpense').modal('show');
        }

        function submitRejectExpense() {
            const id = $('#rejectExpenseId').val();
            const reason = $('#rejectReason').val().trim();
            if (!reason) { Swal.fire('Cảnh báo', 'Vui lòng nhập lý do từ chối', 'warning'); return; }

            $.post('/Admin/Expense/UpdateStatus', {
                expenseId: id,
                status: 'Rejected',
                rejectReason: reason
            }, function (res) {
                $('#modalRejectExpense').modal('hide');
                if (res.success) {
                    Swal.fire({ icon: 'success', title: 'Đã từ chối', timer: 1500, showConfirmButton: false });
                    tblExpense.ajax.reload();
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            });
        }

        // Giữ nguyên các hàm Delete, Submit Create, View Image cũ của bạn
        function deleteExpense(id) {
             Swal.fire({
                title: 'Xác nhận xóa?', text: 'Hành động này không thể hoàn tác!', icon: 'warning',
                showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'Xóa'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Admin/Expense/Delete', { id: id }, function (res) {
                        if (res.success) {
                            Swal.fire('Đã xóa', '', 'success');
                            tblExpense.ajax.reload();
                        } else Swal.fire('Lỗi', res.message, 'error');
                    });
                }
            });
        }

        function submitExpense() {
            // ... (Logic cũ giữ nguyên) ...
             const form = $('#frmExpense')[0];
            if (!form.checkValidity()) { form.reportValidity(); return; }
            const formData = new FormData(form);
            $.ajax({
                url: '/Admin/Expense/Create', type: 'POST', data: formData, contentType: false, processData: false,
                success: function (res) {
                    if (res.success) {
                        $('#modalExpense').modal('hide');
                        Swal.fire({ icon: 'success', title: 'Thành công', showConfirmButton: false, timer: 1500 });
                        tblExpense.ajax.reload();
                    } else Swal.fire('Lỗi', res.message, 'error');
                }
            });
        }

        function viewImage(url) {
            Swal.fire({ imageUrl: url, imageAlt: 'Hóa đơn', showConfirmButton: false, showCloseButton: true, width: 'auto' });
        }
    </script>

    <style>
        /* CSS bổ sung */
        .bg-success-light {
            background-color: rgba(40, 199, 111, 0.1) !important;
            color: #28c76f !important;
        }

        .bg-danger-light {
            background-color: rgba(234, 84, 85, 0.1) !important;
            color: #ea5455 !important;
        }

        .bg-warning-light {
            background-color: rgba(255, 159, 67, 0.1) !important;
            color: #ff9f43 !important;
        }

        .text-xs {
            font-size: 0.75rem;
        }

        .avatar-xs {
            width: 2rem;
            height: 2rem;
        }
    </style>
}