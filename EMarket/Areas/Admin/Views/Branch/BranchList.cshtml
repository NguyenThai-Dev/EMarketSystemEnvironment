@{
    ViewBag.Title = "BranchList";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content">

        <div class="page-header">
            <div class="page-title">
                <h4>Danh sách chi nhánh</h4>
                <h6>Quản lý hệ thống chi nhánh</h6>
            </div>
            <div class="page-btn">
                <button class="btn btn-added" id="btnAddBranch">
                    <img src="~/assets/img/icons/plus.svg" class="me-1" />
                    Thêm chi nhánh mới
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-body">

                <div class="table-top">
                    <div class="search-set">
                        <div class="search-input">
                            <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img" /></a>
                        </div>
                    </div>
                    @Html.Partial("~/Areas/Admin/Views/Partial/_ExportButtons.cshtml", "tblBranches")
                </div>

                <div class="table-responsive">
                    <table id="tblBranches" class="table datanew w-100">
                        <thead>
                            <tr>
                                <th><label class="checkboxs"><input type="checkbox" id="select-all" /><span class="checkmarks"></span></label></th>
                                <th>Tên chi nhánh</th>
                                <th>Địa chỉ</th>
                                <th style="width:140px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalBranchInput" tabindex="-1"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Branch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="BranchId" value="0" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label>Tên chi nhánh <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="BranchName" />
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group mb-3">
                            <label>Địa chỉ</label>
                            <input type="text" class="form-control" id="Address" />
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group mb-3">
                            <label>Map URL (Embed)</label>
                            <input type="text" class="form-control" id="AddressUrl"
                                   placeholder="https://www.google.com/maps/embed?..." />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label>Latitude</label>
                            <input type="text" step="any" class="form-control" id="Latitude" placeholder="10°46&#39;36.8&quot;N" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label>Longitude</label>
                            <input type="text" step="any" class="form-control" id="Longitude" placeholder="10°46&#39;36.8&quot;N" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button class="btn btn-primary" id="btnSaveBranch">Lưu</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalBranchInfo" tabindex="-1"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title fw-semibold">
                    Địa chỉ chi nhánh
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-0">
                <div class="row g-0">

                    <div class="col-lg-8">
                        <iframe id="branchMap"
                                style="width:100%; height:520px; border:0"
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>

                    <div class="col-lg-4 border-start">
                        <div class="p-4">

                            <h6 class="text-muted text-center mb-3">
                                Thông tin chi nhánh
                            </h6>

                            <div class="mb-3">
                                <div class="text-muted small">Tên chi nhánh</div>
                                <div id="spBranchName"
                                     class="fw-semibold fs-6 text-primary"></div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Địa chỉ</div>
                                <div id="spBranchAddress"></div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Tọa độ</div>
                                <div>
                                    <span id="spLat"></span>,
                                    <span id="spLng"></span>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Đóng
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        let tblBranches;

        $(function () {
            function convertToDecimalValue(dms) {
                if (!dms) return 0;
                const regex = /(\d+)°(\d+)'([\d.]+)"([NSEW])/;
                const matches = dms.match(regex);
                if (!matches) return 0;

                const deg = parseInt(matches[1]);
                const min = parseInt(matches[2]);
                const sec = parseFloat(matches[3]);
                const dir = matches[4];

                let decimal = deg + min / 60 + sec / 3600;
                if (dir === 'S' || dir === 'W') decimal *= -1;
                return parseFloat(decimal.toFixed(6));
            }

            function convertToDMS(decimal, isLatitude) {
                if (decimal === null || decimal === undefined || isNaN(decimal)) return "";
                let direction = isLatitude ? (decimal >= 0 ? "N" : "S") : (decimal >= 0 ? "E" : "W");
                const absolute = Math.abs(decimal);
                const degrees = Math.floor(absolute);
                const minutesNotTruncated = (absolute - degrees) * 60;
                const minutes = Math.floor(minutesNotTruncated);
                const seconds = ((minutesNotTruncated - minutes) * 60).toFixed(1);
                const minStr = minutes.toString().padStart(2, '0');
                return `${degrees}°${minStr}'${seconds}"${direction}`;
            }

            if ($.fn.DataTable.isDataTable('#tblBranches')) {
                $('#tblBranches').DataTable().clear().destroy();
            }

            $.extend(true, $.fn.dataTable.defaults, {
                dom: 't<"bottom_controls"lp>',
                language: {
                    search: "",
                    searchPlaceholder: "Search...",
                    info: "",
                    infoEmpty: "",
                    infoFiltered: "",
                },
            });

            tblBranches = $('#tblBranches').DataTable({
                processing: true,
                serverSide: false,
                searching: false,
                ajax: {
                    url: '/Branch/GetFilteredBranch',
                    type: 'GET',
                    data: d => {
                        d.branchName = $('#txtSearch').val() ?? '';
                    }
                },
                columns: [
                    {
                        data: null,
                        orderable: false,
                        className: 'text-center dt-checkbox-col',
                        render: (data, type, row) => `
                                <label class="checkboxs">
                                    <input type="checkbox" class="row-select" data-id="${row.BranchId}" />
                                    <span class="checkmarks"></span>
                                </label>`
                    },
                    { data: 'Name' },
                    { data: 'Address', render: d => d || '-' },
                    {
                        data: null,
                        orderable: false,
                        render: d => {
                            const viewBtn = `<a href="javascript:void(0)" class="me-3 btn-view" data-obj='${JSON.stringify(d)}'><img src="/assets/img/icons/eye.svg" /></a>`;
                            const editBtn = `<a href="javascript:void(0)" class="me-3 btn-edit" data-obj='${JSON.stringify(d)}'><img src="/assets/img/icons/edit.svg" /></a>`;
                            const canDelete = d.CanBeDeleted !== false;
                            const deleteBtn = canDelete
                                ? `<a href="javascript:void(0)" class="btn-delete" data-id="${d.BranchId}"><img src="/assets/img/icons/delete.svg" /></a>`
                                : `<a href="javascript:void(0)" class="btn-delete btn-delete-disabled" data-id="${d.BranchId}"><img src="/assets/img/icons/delete.svg" /></a>`;
                            return viewBtn + editBtn + deleteBtn;
                        }
                    }
                ],
                order: [[1, 'asc']],
                drawCallback: function () {
                    $('#tblBranches_filter input').attr('id', 'txtSearch');
                },
            });

            $('#btnAddBranch').click(() => {
                resetBranchModal();
                $('#modalTitle').text('Add Branch');
                $('#modalBranchInput').modal('show');
            });

            $(document).on('click', '.btn-view', function () {
                const d = $(this).data('obj');
                $('#spBranchName').text(d.Name);
                $('#spBranchAddress').text(d.Address || '-');
                $('#spLat').text(convertToDMS(d.Latitude, true) || '-');
                $('#spLng').text(convertToDMS(d.Longitude, false) || '-');
                $('#branchMap').attr('src', d.AddressUrl || '');
                $('#modalBranchInfo').modal('show');
            });

            $(document).on('click', '.btn-edit', function () {
                const d = $(this).data('obj');
                $('#BranchId').val(d.BranchId);
                $('#BranchName').val(d.Name);
                $('#Address').val(d.Address);
                $('#AddressUrl').val(d.AddressUrl);
                $('#Latitude').val(convertToDMS(d.Latitude, true));
                $('#Longitude').val(convertToDMS(d.Longitude, false));
                $('#modalTitle').text('Edit Branch');
                $('#modalBranchInput').modal('show');
            });

            $('#btnSaveBranch').click(async () => {
                const dto = {
                    BranchId: Number($('#BranchId').val()),
                    Name: $('#BranchName').val()?.trim(),
                    Address: $('#Address').val()?.trim(),
                    AddressUrl: $('#AddressUrl').val()?.trim(),
                    Latitude: convertToDecimalValue($('#Latitude').val()),
                    Longitude: convertToDecimalValue($('#Longitude').val())
                };

                if (!dto.Name) {
                    Swal.fire({ icon: 'warning', title: 'Chú ý', text: 'Vui lòng nhập tên chi nhánh', confirmButtonColor: '#ff9b44' });
                    return;
                }

                Swal.showLoading();
                const url = dto.BranchId ? '/Branch/UpdateBranch' : '/Branch/CreateBranch';

                try {
                    const res = await $.post(url, dto);
                    if (res.success) {
                        $('#modalBranchInput').modal('hide');
                        Swal.fire({ icon: 'success', title: 'Thành công', text: 'Dữ liệu đã được lưu', timer: 1500, showConfirmButton: false });
                        tblBranches.ajax.reload(null, false);
                    } else {
                        Swal.fire({ icon: 'error', title: 'Lỗi', text: res.message || 'Không thể lưu dữ liệu' });
                    }
                } catch {
                    Swal.fire({ icon: 'error', title: 'Lỗi hệ thống', text: 'Kết nối thất bại' });
                }
            });

            $(document).on('click', '.btn-delete', function () {
                const id = $(this).data('id');
                if ($(this).hasClass('btn-delete-disabled')) {
                    Swal.fire({ icon: 'error', title: 'Không thể xóa', text: 'Chi nhánh này đang chứa kho hàng!', confirmButtonColor: '#3085d6' });
                    return;
                }

                Swal.fire({
                    title: 'Xác nhận xóa?',
                    text: "Bạn sẽ không thể khôi phục lại dữ liệu này!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ff9b44',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy'
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        const res = await $.post('/Branch/DeleteBranch', { id: id });
                        if (res.success) {
                            Swal.fire({ icon: 'success', title: 'Đã xóa', timer: 1500, showConfirmButton: false });
                            tblBranches.ajax.reload(null, false);
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    }
                });
            });

            $('#btnSearch').on('click', () => tblBranches.ajax.reload());

            $(document).on("keyup", "#txtSearch", function () {
                clearTimeout(window.searchTimer);
                window.searchTimer = setTimeout(() => tblBranches.ajax.reload(), 400);
            });
        });

        function resetBranchModal() {
            $('#BranchId').val(0);
            $('#BranchName').val('');
            $('#Address').val('');
            $('#AddressUrl').val('');
            $('#Latitude').val('');
            $('#Longitude').val('');
        }
    </script>
}

@section Styles {
    <style>
        table.dataTable td {
            white-space: normal !important;
            vertical-align: middle;
        }

        .btn-delete-disabled {
            opacity: 0.4;
            cursor: not-allowed !important;
            pointer-events: none;
        }

        #modalBranchInfo .list-group-item {
            padding: 0.6rem 0;
            border: none;
        }

        #modalBranchInfo .card {
            border-radius: 10px;
        }

        #modalBranchInfo .modal-header,
        #modalBranchInfo .modal-footer {
            border: none;
        }
    </style>
}
