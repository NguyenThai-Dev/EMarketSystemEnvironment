@{
    ViewBag.Title = "Phân quyền Hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content">
        <div class="page-header d-flex justify-content-between align-items-center mb-4">
            <div class="page-title">
                <h4 class="fw-bold text-dark mb-1">Danh sách Vai trò (Roles)</h4>
                <h6 class="text-muted">Quản lý và cấu hình phân quyền chi tiết cho hệ thống</h6>
            </div>
            <div>
                <!-- Nút thêm mới nếu cần sau này -->
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblRoles" class="table table-hover w-100 align-middle custom-table">
                        <thead class="table-light text-muted">
                            <tr>
                                <th class="text-center rounded-start" style="width: 80px;">ID</th>
                                <th>Tên Vai trò</th>
                                <th class="text-center">Số lượng Quyền</th>
                                <th class="text-end rounded-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Phân quyền Card Grid -->
<div class="modal fade" id="modalPermission" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px 24px;">
                <div>
                    <h5 class="modal-title fw-bold mb-1">
                        <i class="fas fa-user-shield me-2"></i>Cấu hình Phân quyền
                    </h5>
                    <div id="RoleNameDisplay" class="text-white-50" style="font-size: 13px;">Vai trò: Đang tải...</div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="form-check form-switch mb-0 d-flex align-items-center gap-2 px-3 py-2 rounded-3" >
                        <input class="form-check-input mt-0" type="checkbox" id="globalSelectAll" style="cursor: pointer; width: 36px; height: 18px;">
                        <label class="form-check-label text-white fw-medium mb-0" for="globalSelectAll" style="cursor: pointer; font-size: 14px;">Chọn tất cả hệ thống</label>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            
            <div class="modal-body bg-light" style="padding: 24px;">
                <input type="hidden" id="RoleId" value="0" />
                
                <!-- Grid Container thay cho Matrix -->
                <div class="row g-3" id="permissionsGrid">
                    <!-- Các Card Module sẽ được render ở đây -->
                </div>
            </div>
            
            <div class="modal-footer bg-white border-top-0" style="padding: 16px 24px;">
                <button class="btn btn-light fw-medium px-4" data-bs-dismiss="modal" style="border-radius: 8px;">Hủy bỏ</button>
                <button class="btn btn-primary fw-bold px-4 shadow-sm" id="btnSavePermissions" style="border-radius: 8px; background: #667eea; border: none;">
                    <i class="fas fa-save me-2"></i>Lưu Cấu hình
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let tblRoles;
        let allPermissions = [];

        // Từ điển Vietsub cho Action & Module
        const actionDict = {
            'View': 'Xem',
            'Create': 'Thêm mới',
            'Edit': 'Sửa',
            'Update': 'Cập nhật',
            'Delete': 'Xóa',
            'Import': 'Nhập Excel',
            'Export': 'Xuất Excel',
            'Print': 'In ấn'
        };

        const moduleDict = {
            'DashboardModule': 'Bảng điều khiển',
            'ProductModule': 'Quản lý Sản phẩm',
            'SalesModule': 'Bán hàng (Sales)',
            'InventoryModule': 'Quản lý Tồn kho',
            'UserModule': 'Người dùng & Vai trò',
            'CustomerModule': 'Khách hàng',
            'SupplierModule': 'Nhà cung cấp / Thương hiệu',
            'ReportModule': 'Báo cáo & Thống kê',
            'DebtModule': 'Quản lý Công nợ',
            'WarehouseModule': 'Quản lý Kho',
            'BranchModule': 'Quản lý Chi nhánh',
            'QuotationModule': 'Báo giá',
            'ExpenseModule': 'Quản lý Chi phí'
        };

        $(document).ready(function () {
            // 1. Load Master Data Permissions
            $.get('/Admin/Role/GetAllPermission', function (res) {
                if (res.success) {
                    allPermissions = res.data;
                }
            });

            if ($.fn.DataTable.isDataTable('#tblRoles')) {
                $('#tblRoles').DataTable().clear().destroy();
            }

            $.extend(true, $.fn.dataTable.defaults, {
                dom: 't<"bottom_controls"lp>',
                language: {
                    search: "",
                    searchPlaceholder: "Search...",
                    info: "",
                    infoEmpty: "",
                    infoFiltered: "",
                },
            });

            // 2. Init Datatable
            tblRoles = $('#tblRoles').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: '/Admin/Role/GetAllRole',
                    type: 'GET'
                },
                columnDefs: [
                    { targets: [0, 2], className: 'text-center' }
                ],
                columns: [
                    {
                        data: 'RoleId', width: "60px", orderable: false,
                        render: d => `<span class="badge bg-light text-secondary border">#${d}</span>`
                    },
                    {
                        data: 'Name',
                        orderable: false,
                        render: function (d) {
                            let iconHtml = '';
                            let colorClass = 'text-dark';
                            
                            if (d === 'System Admin') {
                                iconHtml = '<div class="role-icon bg-danger bg-opacity-10 text-danger"><i class="fas fa-crown"></i></div>';
                            } else if (d.toLowerCase().includes('manager')) {
                                iconHtml = '<div class="role-icon bg-primary bg-opacity-10 text-primary"><i class="fas fa-user-tie"></i></div>';
                            } else if (d.toLowerCase().includes('staff')) {
                                iconHtml = '<div class="role-icon bg-success bg-opacity-10 text-success"><i class="fas fa-user"></i></div>';
                            } else {
                                iconHtml = '<div class="role-icon bg-secondary bg-opacity-10 text-secondary"><i class="fas fa-shield-alt"></i></div>';
                            }

                            return `<div class="d-flex align-items-center gap-3">${iconHtml}<span class="fw-bold ${colorClass}" style="font-size:15px;">${d}</span></div>`;
                        }
                    },
                    {
                        data: 'Permissions',
                        orderable: false,
                        render: d => {
                            let count = d ? d.length : 0;
                            let badgeClass = count > 0 ? 'bg-info bg-opacity-10 text-info border-info' : 'bg-light text-muted border-secondary';
                            return `<span class="badge ${badgeClass} border border-opacity-25 px-3 py-2 rounded-pill"><i class="fas fa-key me-1"></i> ${count} Quyền</span>`;
                        }
                    },
                    {
                        data: null, orderable: false, className: 'text-end',
                        render: (data) => `
                            <button class="btn btn-sm btn-action-hover btn-permission" data-id="${data.RoleId}" data-name="${data.Name}" title="Phân quyền">
                                <i class="fas fa-sliders-h text-primary"></i> <span class="ms-1 fw-medium text-primary">Cấu hình</span>
                            </button>
                        `
                    }
                ]
            });

            // 3. Sự kiện mở Modal Phân Quyền
            $(document).on('click', '.btn-permission', function () {
                let roleId = $(this).data('id');
                let roleName = $(this).data('name');

                $('#RoleId').val(roleId);
                $('#RoleNameDisplay').text('Phân quyền cho: ' + roleName);

                $.get(`/Admin/Role/GetRolePermissions?roleId=${roleId}`, function (res) {
                    if (res.success) {
                        renderCards(allPermissions, res.data);
                        $('#modalPermission').modal('show');
                    }
                });
            });

            function renderCards(masterData, checkedIds) {
                let groupedData = {}; 

                // Nhóm Data theo Module
                masterData.forEach(p => {
                    let actionName = p.Name.replace(p.Module, '').trim();

                    if (!groupedData[p.Module]) {
                        groupedData[p.Module] = [];
                    }
                    groupedData[p.Module].push({
                        id: p.PermissionId,
                        action: actionName
                    });
                });

                // Sort Action
                const priority = ['View', 'Create', 'Edit', 'Update', 'Delete', 'Import', 'Export', 'Print'];
                for (let module in groupedData) {
                    groupedData[module].sort((a, b) => {
                        let idxA = priority.indexOf(a.action);
                        let idxB = priority.indexOf(b.action);
                        if (idxA === -1) idxA = 99;
                        if (idxB === -1) idxB = 99;
                        return idxA - idxB;
                    });
                }

                // Render HTML theo Grid
                let gridHtml = '';
                for (const [module, actions] of Object.entries(groupedData)) {
                    let moduleText = moduleDict[module] || module;
                    
                    let allChecked = actions.every(a => checkedIds.includes(a.id));
                    let moduleCheckState = allChecked && actions.length > 0 ? 'checked' : '';

                    gridHtml += `
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm module-card" style="border-radius: 12px; overflow: hidden; transition: all 0.2s;">
                            <div class="card-header bg-white border-bottom-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                                <h6 class="mb-0 fw-bold text-dark d-flex align-items-center" style="font-size: 14px;">
                                    <div style="width: 6px; height: 16px; border-radius: 4px; background: #667eea; margin-right: 8px;"></div>
                                    ${moduleText}
                                </h6>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input module-select-all" style="cursor: pointer;" type="checkbox" ${moduleCheckState} title="Chọn tất cả module này">
                                </div>
                            </div>
                            <div class="card-body pt-0 pb-3">
                                <hr class="mt-0 mb-3" style="border-color: #f1f5f9; opacity: 1;">
                                <div class="d-flex flex-wrap gap-2">`;
                    
                    actions.forEach(a => {
                        let actionText = actionDict[a.action] || a.action;
                        let isChecked = checkedIds.includes(a.id) ? 'checked' : '';
                        let colorClass = 'btn-outline-primary'; // default
                        
                        if (a.action === 'View') colorClass = 'btn-outline-info';
                        else if (a.action === 'Create') colorClass = 'btn-outline-success';
                        else if (a.action === 'Edit' || a.action === 'Update') colorClass = 'btn-outline-warning';
                        else if (a.action === 'Delete') colorClass = 'btn-outline-danger';

                        gridHtml += `
                                    <div class="permission-pill">
                                        <input type="checkbox" class="btn-check perm-check" id="perm_${a.id}" value="${a.id}" autocomplete="off" ${isChecked}>
                                        <label class="btn ${colorClass} fw-medium rounded-pill px-3 m-0" for="perm_${a.id}">
                                            ${actionText}
                                        </label>
                                    </div>
                        `;
                    });

                    gridHtml += `       </div>
                            </div>
                        </div>
                    </div>`;
                }

                $('#permissionsGrid').html(gridHtml);

                setupCardEvents();
            }

            function setupCardEvents() {
                // Check all in Module
                $('.module-select-all').change(function () {
                    let isChecked = $(this).is(':checked');
                    $(this).closest('.module-card').find('.perm-check').prop('checked', isChecked);
                    updateGlobalSelectAll();
                });

                // Check specific perm
                $('.perm-check').change(function () {
                    let $card = $(this).closest('.module-card');
                    let total = $card.find('.perm-check').length;
                    let checked = $card.find('.perm-check:checked').length;
                    $card.find('.module-select-all').prop('checked', total === checked && total > 0);
                    updateGlobalSelectAll();
                });

                // Global Select All
                $('#globalSelectAll').change(function() {
                    let isChecked = $(this).is(':checked');
                    $('.perm-check, .module-select-all').prop('checked', isChecked);
                });

                updateGlobalSelectAll();
            }

            function updateGlobalSelectAll() {
                let total = $('.perm-check').length;
                let checked = $('.perm-check:checked').length;
                $('#globalSelectAll').prop('checked', total === checked && total > 0);
            }

            // 4. Lưu Phân Quyền
            $('#btnSavePermissions').click(function () {
                let roleId = $('#RoleId').val();
                let selectedIds = [];
                $('.perm-check:checked').each(function () {
                    selectedIds.push(parseInt($(this).val()));
                });

                let btn = $(this);
                let oldHtml = btn.html();
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Đang lưu...');

                $.ajax({
                    url: '/Admin/Role/UpdateRolePermissions',
                    type: 'POST',
                    data: ({ RoleId: roleId, PermissionIds: selectedIds }),
                    success: function (res) {
                        btn.prop('disabled', false).html(oldHtml);
                        if (res.success) {
                            $('#modalPermission').modal('hide');
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: 'Đã cập nhật cấu hình phân quyền!',
                                confirmButtonColor: '#667eea'
                            });
                            tblRoles.ajax.reload(null, false);
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function() {
                        btn.prop('disabled', false).html(oldHtml);
                        Swal.fire('Lỗi', 'Có lỗi kết nối đến máy chủ.', 'error');
                    }
                });
            });
        });
    </script>
}

@section Styles {
    <style>
        /* Modern Table Style */
        .custom-table th {
            text-transform: uppercase;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            padding: 16px;
            border-bottom: 2px solid #e2e8f0;
        }
        .custom-table td {
            padding: 16px;
            border-bottom: 1px solid #f1f5f9;
        }

        /* Role Icons */
        .role-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        /* Action Buttons */
        .btn-action-hover {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 6px 14px;
            transition: all 0.2s;
        }
        .btn-action-hover:hover {
            background: #eff6ff;
            border-color: #bfdbfe;
            transform: translateY(-1px);
            box-shadow: 0 4px 6px rgba(59, 130, 246, 0.1);
        }

        /* Module Card Hover */
        .module-card:hover {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025) !important;
            transform: translateY(-2px);
        }

        /* Checkbox Pills Styling */
        .permission-pill label {
            font-size: 12px;
            letter-spacing: 0.3px;
            border-width: 1.5px;
            padding-top: 4px !important;
            padding-bottom: 4px !important;
            transition: all 0.2s ease;
        }

        /* Custom Colors for Pills */
        /* View - Info */
        .btn-outline-info { color: #0ea5e9; border-color: #e0f2fe; background-color: #f0f9ff; }
        .btn-outline-info:hover { color: #0369a1; border-color: #bae6fd; background-color: #e0f2fe; }
        .btn-check:checked + .btn-outline-info { background-color: #0ea5e9; color: white; border-color: #0ea5e9; box-shadow: 0 4px 6px rgba(14, 165, 233, 0.2); }

        /* Create - Success */
        .btn-outline-success { color: #10b981; border-color: #d1fae5; background-color: #ecfdf5; }
        .btn-outline-success:hover { color: #047857; border-color: #a7f3d0; background-color: #d1fae5; }
        .btn-check:checked + .btn-outline-success { background-color: #10b981; color: white; border-color: #10b981; box-shadow: 0 4px 6px rgba(16, 185, 129, 0.2); }

        /* Edit - Warning */
        .btn-outline-warning { color: #f59e0b; border-color: #fef3c7; background-color: #fffbeb; }
        .btn-outline-warning:hover { color: #b45309; border-color: #fde68a; background-color: #fef3c7; }
        .btn-check:checked + .btn-outline-warning { background-color: #f59e0b; color: white; border-color: #f59e0b; box-shadow: 0 4px 6px rgba(245, 158, 11, 0.2); }

        /* Delete - Danger */
        .btn-outline-danger { color: #ef4444; border-color: #fee2e2; background-color: #fef2f2; }
        .btn-outline-danger:hover { color: #b91c1c; border-color: #fecaca; background-color: #fee2e2; }
        .btn-check:checked + .btn-outline-danger { background-color: #ef4444; color: white; border-color: #ef4444; box-shadow: 0 4px 6px rgba(239, 68, 68, 0.2); }

        /* Others - Primary */
        .btn-outline-primary { color: #6366f1; border-color: #e0e7ff; background-color: #eef2ff; }
        .btn-outline-primary:hover { color: #4338ca; border-color: #c7d2fe; background-color: #e0e7ff; }
        .btn-check:checked + .btn-outline-primary { background-color: #6366f1; color: white; border-color: #6366f1; box-shadow: 0 4px 6px rgba(99, 102, 241, 0.2); }
    </style>
}