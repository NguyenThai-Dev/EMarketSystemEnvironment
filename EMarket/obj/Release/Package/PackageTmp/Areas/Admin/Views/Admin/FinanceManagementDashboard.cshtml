@{
    ViewBag.Title = "Finance Command Center";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content">

        <div class="page-header mb-4 mt-2">
            <div class="row align-items-center w-100">
                <div class="col">
                    <h3 class="page-title fw-bold text-dark" style="letter-spacing: -0.5px;">
                        <span class="bg-primary-light p-2 rounded-3 me-2">
                            <i class="fas fa-chart-line text-primary"></i>
                        </span>
                        Trung Tâm Tài Chính
                    </h3>
                    <ul class="breadcrumb border-0 mb-0 ps-0 bg-transparent">
                        <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item active">Báo cáo Thu Chi</li>
                    </ul>
                </div>

                <div class="col-auto">
                    <div class="d-flex align-items-center bg-white px-3 py-2 rounded-pill shadow-sm border">

                        <!-- Branch -->
                        <div class="d-flex align-items-center pe-3 me-3 border-end">
                            <span class="d-flex align-items-center justify-content-center rounded-circle bg-light me-2"
                                  style="width:28px;height:28px;">
                                <i class="fas fa-store text-muted small"></i>
                            </span>

                            <select id="branchSelect"
                                    class="form-select form-select-sm border-0 shadow-none fw-bold text-dark"
                                    style="min-width:180px; background-color:transparent;">
                                <option value="">Tất cả Chi Nhánh</option>
                            </select>
                        </div>

                        <!-- Time -->
                        <div class="d-flex align-items-center">
                            <span class="d-flex align-items-center justify-content-center rounded-circle bg-light me-2"
                                  style="width:28px;height:28px;">
                                <i class="far fa-calendar-alt text-muted small"></i>
                            </span>

                            <select id="timeRangeSelect"
                                    class="form-select form-select-sm border-0 shadow-none fw-bold text-primary"
                                    style="min-width:140px; background-color:transparent;">
                                <option value="7">7 ngày qua</option>
                                <option value="30" selected>30 ngày qua</option>
                                <option value="90">Quý này</option>
                            </select>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-3 col-sm-6 col-12 d-flex">
                <div class="card flex-fill finance-card card-revenue">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="finance-info">
                                <h6 class="text-white-50">Doanh thu thuần</h6>
                                <h3 id="kpiRevenue" class="text-white fw-bold mb-0">0 ₫</h3>
                            </div>
                            <div class="finance-icon bg-white-10">
                                <i class="fas fa-coins"></i>
                            </div>
                        </div>
                        <div class="progress mt-3 bg-white-10" style="height: 4px;">
                            <div class="progress-bar bg-white" style="width: 75%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-sm-6 col-12 d-flex">
                <div class="card flex-fill finance-card card-expense">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="finance-info">
                                <h6 class="text-white-50">Tổng chi phí</h6>
                                <h3 id="kpiExpense" class="text-white fw-bold mb-0">0 ₫</h3>
                            </div>
                            <div class="finance-icon bg-white-10">
                                <i class="fas fa-wallet"></i>
                            </div>
                        </div>
                        <div class="mt-3 small text-white-50">
                            <i class="fas fa-info-circle me-1"></i> Gồm nhập & vận hành
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-sm-6 col-12 d-flex">
                <div class="card flex-fill finance-card card-profit">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="finance-info">
                                <h6 class="text-white-50">Lợi nhuận gộp</h6>
                                <h3 id="kpiProfit" class="text-white fw-bold mb-0">0 ₫</h3>
                            </div>
                            <div class="finance-icon bg-white-10">
                                <i class="fas fa-hand-holding-usd"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <span id="kpiMarginBadge" class="badge bg-white text-success rounded-pill px-3">Margin: 0%</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-sm-6 col-12 d-flex">
                <div class="card flex-fill finance-card card-debt">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="finance-info">
                                <h6 class="text-white-50">Nợ cần trả</h6>
                                <h3 id="kpiDebt" class="text-white fw-bold mb-0">0 ₫</h3>
                            </div>
                            <div class="finance-icon bg-white-10">
                                <i class="fas fa-exclamation-circle"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <a href="@Url.Action("SupplierDebtAndPayment", "Supplier", new { area = "Admin" })" class="text-white small fw-bold text-decoration-underline">Thanh toán ngay →</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8 d-flex">
                <div class="card flex-fill">
                    <div class="card-header border-0 pb-0">
                        <h5 class="card-title">Dòng tiền (Thu vs Chi)</h5>
                    </div>
                    <div class="card-body">
                        <div id="cashFlowChart" style="min-height: 300px;"></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 d-flex">
                <div class="card flex-fill">
                    <div class="card-header border-0 pb-0">
                        <h5 class="card-title">Cơ cấu Chi phí</h5>
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <div id="expensePieChart" class="w-100"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-top">
                    <div class="search-set">
                        <div class="search-path">
                            <h5 class="card-title mb-0">Giao dịch gần đây</h5>
                        </div>
                    </div>
                    <div class="wordset">
                        <ul>
                            <li>
                                <a data-bs-toggle="tooltip" data-bs-placement="top" title="Xuất Excel">
                                    <img src="~/assets/img/icons/excel.svg" alt="img">
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="tblTransactions">
                        <thead>
                            <tr>
                                <th>Mô tả</th>
                                <th>Loại</th>
                                <th>Hình thức</th>
                                <th class="text-end">Số tiền</th>
                                <th class="text-end">Thời gian</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        let cashFlowChart, expensePieChart;
        let currentUserBranchId = 0;
        const formatter = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });

        $(document).ready(function () {
            initFinanceDashboard();
            $('#branchSelect').change(loadFinanceData);
            $('#timeRangeSelect').change(loadFinanceData);
        });

        async function initFinanceDashboard() {
            await getCurrentUserBranch();
            await loadDropdowns(currentUserBranchId);
            await loadFinanceData();
        }

        async function loadFinanceData() {
            const branchId = $('#branchSelect').val();
            const daysBack = $('#timeRangeSelect').val();

            try {
                const res = await $.get('/Admin/Admin/GetFinanceDashboardData', {
                    branchId,
                    daysBack
                });

                if (!res.success || !res.data) return;

                renderKpi(res.data.Kpi);
                renderMainChart(res.data.Trends);
                renderPieChart(res.data.ExpensePie);
                renderTransactions(res.data.RecentOrders);

            } catch (e) {
                console.error('Finance dashboard load failed', e);
            }
        }

        /* ================= KPI ================= */

        function renderKpi(kpi) {
            const revenue = kpi.TotalRevenue || 0;
            const expense = kpi.TotalPurchase || 0;
            const profit = kpi.GrossProfit || 0;
            const debt = kpi.SupplierDebt || 0;

            const margin = revenue === 0 ? 0 : (profit / revenue) * 100;

            $('#kpiRevenue').text(formatter.format(revenue));
            $('#kpiExpense').text(formatter.format(expense));
            $('#kpiProfit').text(formatter.format(profit));
            $('#kpiDebt').text(formatter.format(debt));

            const $badge = $('#kpiMarginBadge');
            $badge.text(`Margin: ${margin.toFixed(1)}%`)
                .removeClass('bg-success-soft bg-danger-soft text-success text-danger border-success border-danger')
                .addClass(margin >= 0
                    ? 'bg-success-soft text-success border-success'
                    : 'bg-danger-soft text-danger border-danger');
        }

        /* ================= MAIN CHART ================= */

        function renderMainChart(data) {
            if (!data || !data.length) return;

            const labels = data.map(x => x.DateLabel);
            const revenue = data.map(x => x.Revenue);
            const expense = data.map(x => x.PurchaseCost);

            const options = {
                series: [
                    { name: 'Doanh thu', data: revenue },
                    { name: 'Chi phí nhập', data: expense }
                ],
                chart: { type: 'area', height: 350, toolbar: { show: false } },
                dataLabels: { enabled: false },
                stroke: { curve: 'smooth', width: 2 },
                xaxis: { categories: labels },
                tooltip: {
                    y: { formatter: val => formatter.format(val) }
                }
            };

            if (cashFlowChart) cashFlowChart.destroy();
            cashFlowChart = new ApexCharts(document.querySelector("#cashFlowChart"), options);
            cashFlowChart.render();
        }

        /* ================= PIE ================= */

        function renderPieChart(data) {
            if (!data || !data.length) return;

            const options = {
                series: data.map(x => x.Value),
                labels: data.map(x => x.Label),
                chart: { type: 'donut', height: 300 },
                legend: { position: 'bottom' },
                dataLabels: { enabled: false }
            };

            if (expensePieChart) expensePieChart.destroy();
            expensePieChart = new ApexCharts(document.querySelector("#expensePieChart"), options);
            expensePieChart.render();
        }

        /* ================= TRANSACTIONS ================= */

        function renderTransactions(list) {
            const $tbody = $('#tblTransactions tbody').empty();

            if (!list || !list.length) {
                $tbody.append(`
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            Không có giao dịch gần đây
                        </td>
                    </tr>`);
                return;
            }

            list.forEach(x => {
                const isIn = x.Status === 'IN';
                const badgeClass = isIn ? 'bg-success-soft text-success' : 'bg-danger-soft text-danger';
                const sign = isIn ? '+' : '-';

                $tbody.append(`
                    <tr>
                        <td class="ps-4 fw-bold">${x.OrderId}</td>
                        <td><span class="badge ${badgeClass}">${isIn ? 'Thu' : 'Chi'}</span></td>
                        <td class="small text-muted">${isIn ? 'Sale' : 'Purchase'}</td>
                        <td class="text-end fw-bold">${sign}${formatter.format(x.TotalAmount)}</td>
                        <td class="text-end pe-4 small text-muted">
                           ${formatDateTime(x.OrderDate)}
                        </td>
                    </tr>
                `);
            });
        }

        /* ================= HELPERS ================= */

        async function getCurrentUserBranch() {
            try {
                const res = await $.get('/Admin/Login/GetCurrentUser');
                if (res.success) currentUserBranchId = res.data.BranchId || 0;
            } catch { }
        }

        function formatDateTime(dateStr) {
            if (!dateStr) return '__';

            var d = null;

            // Case 1: .NET JSON Date: /Date(1764435600000)/
            if (typeof dateStr === 'string' && dateStr.indexOf('/Date(') === 0) {
                var ticks = parseInt(dateStr.replace(/[^0-9]/g, ''), 10);
                if (!isNaN(ticks)) {
                    d = new Date(ticks);
                }
            }
            // Case 2: ISO / normal date string
            else {
                d = new Date(dateStr);
            }

            if (!d || isNaN(d.getTime())) return '__';

            var dd = ('0' + d.getDate()).slice(-2);
            var mm = ('0' + (d.getMonth() + 1)).slice(-2);
            var yyyy = d.getFullYear();

            var hh = ('0' + d.getHours()).slice(-2);
            var mi = ('0' + d.getMinutes()).slice(-2);

            return dd + '/' + mm + '/' + yyyy + ' ' + hh + ':' + mi;
        }

        async function loadDropdowns(branchId) {
            try {
                const res = await $.get('/Admin/Admin/LoadDropdowns', { branchId });
                const $select = $('#branchSelect').empty()
                    .append('<option value="">-- Tất cả Chi Nhánh --</option>');

                (res.branches || []).forEach(b =>
                    $select.append(`<option value="${b.BranchId}">${b.Name}</option>`));

                if (currentUserBranchId) $select.val(currentUserBranchId);
            } catch (e) {
                console.error('Load dropdown failed', e);
            }
        }
    </script>
}


@section Styles {
    <style>
        /* Nâng cấp Card KPI */
        .finance-card {
            border: none;
            border-radius: 20px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .finance-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 30px rgba(0,0,0,0.12);
            }

        /* Các bộ màu Gradient sang trọng */
        .card-revenue {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        /* Tím xanh */
        .card-expense {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5253 100%);
        }
        /* Đỏ san hô */
        .card-profit {
            background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
        }
        /* Xanh lục bảo */
        .card-debt {
            background: linear-gradient(135deg, #f6ad55 0%, #ed8936 100%);
        }
        /* Cam hoàng hôn */

        .finance-icon {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: white;
        }

        .bg-white-10 {
            background: rgba(255, 255, 255, 0.2);
        }

        .finance-info h6 {
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        /* Tinh chỉnh Header & Breadcrumb */
        .breadcrumb-item + .breadcrumb-item::before {
            content: "•";
            color: #adb5bd;
        }

        .page-title h3 {
            margin-bottom: 2px;
        }

        /* Làm sạch Select2 của DreamPOS để khớp với header mới */
        .select2-container--default .select2-selection--single {
            border: none !important;
            background-color: transparent !important;
        }

        /* Hiệu ứng bóng mờ cho Card Chart */
        .card.flex-fill {
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: 1px solid rgba(0,0,0,0.05);
            border-radius: 15px;
        }
    </style>
}