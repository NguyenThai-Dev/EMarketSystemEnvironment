@{
    ViewBag.Title = "Quản lý Khuyến Mãi";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content">

        <div class="page-header">
            <div class="page-title">
                <h4>Khuyến mãi</h4>
                <h6>Danh sách chương trình ưu đãi</h6>
            </div>
            <div class="page-btn">
                <button class="btn btn-added" id="btnAdd">
                    <img src="~/assets/img/icons/plus.svg" class="me-1" />
                    Thêm mới
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="table-top">
                    <div class="search-set">
                        <div class="search-path">
                            <a class="btn btn-filter" id="filter_search">
                                <img src="~/assets/img/icons/filter.svg" alt="img" />
                                <span><img src="~/assets/img/icons/closes.svg" alt="img" /></span>
                            </a>
                        </div>
                        <div class="search-input">
                            <a class="btn btn-searchset"><img src="~/assets/img/icons/search-white.svg" alt="img" /></a>
                        </div>
                    </div>
                    <div class="wordset">
                        <ul>
                            <li>
                                <a data-bs-toggle="tooltip" data-bs-placement="top" title="pdf">
                                    <img src="~/assets/img/icons/pdf.svg" alt="img" />
                                </a>
                            </li>
                            <li>
                                <a data-bs-toggle="tooltip" data-bs-placement="top" title="excel">
                                    <img src="~/assets/img/icons/excel.svg" alt="img" />
                                </a>
                            </li>
                            <li>
                                <a data-bs-toggle="tooltip" data-bs-placement="top" title="print">
                                    <img src="~/assets/img/icons/printer.svg" alt="img" />
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card" id="filter_inputs">
                    <div class="card-body pb-0">
                        <div class="row">

                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    <select id="ddlCategory" name="SupplierId" class="select form-control">
                                        <option value="">-- Danh mục sản phẩm --</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    <select id="ddlDiscountType" name="DiscountType" class="select form-control">
                                        <option value="">-- Loại giảm giá --</option>
                                        <option value="Percentage">Theo phần trăm (%)</option>
                                        <option value="FixedAmount">Số tiền cố định</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg col-sm-6 col-12">
                                <div class="form-group">
                                    <select id="ddlCustomerGroup" name="CustomerGroup" class="select form-control">
                                        <option value="">-- Tất cả khách hàng --</option>
                                        <option value="VIP">Khách VIP</option>
                                        <option value="Member">Thành viên</option>
                                        <option value="Normal">Khách thường</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-4 col-sm-6 col-12">
                                <div class="form-group">
                                    <div class="input-group">
                                        <input type="date" id="txtFromDate" name="FromDate" class="form-control" title="Từ ngày">
                                        <span class="input-group-text">đến</span>
                                        <input type="date" id="txtToDate" name="ToDate" class="form-control" title="Đến ngày">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-1 col-sm-6 col-12">
                                <div class="form-group">
                                    <button type="button" id="btnFilter" class="btn btn-filters ms-auto">
                                        <img src="~/assets/img/icons/search-whites.svg" alt="img" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="tblPromotions" class="table datanew w-100 table-hover">
                        <thead>
                            <tr>
                                <th width="5%">
                                    <label class="checkboxs">
                                        <input type="checkbox" id="select-all" />
                                        <span class="checkmarks"></span>
                                    </label>
                                </th>
                                <th width="25%">Tên chương trình</th>
                                <th width="15%">Giảm giá</th>
                                <th width="20%">Phạm vi áp dụng</th>
                                <th width="15%">Thời gian</th>
                                <th width="5%" class="text-center">Ưu tiên</th>
                                <th width="5%" class="text-center">Trạng thái</th>
                                <th width="10%" class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalInput" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thông tin khuyến mãi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="PromotionId" value="0" />

                <div class="row">
                    <div class="col-12">
                        <div class="form-group mb-3">
                            <label class="fw-bold">Tên chương trình <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Name" placeholder="Ví dụ: Sale tết 2026..." />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label>Loại giảm giá</label>
                            <select class="form-select" id="DiscountType">
                                <option value="Amount">Số tiền (VNĐ)</option>
                                <option value="Percent">Phần trăm (%)</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label>Giá trị giảm <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="DiscountValue" placeholder="0" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label>Nhóm khách hàng</label>
                            <select class="form-select" id="CustomerType">
                                <option value="">-- Tất cả khách hàng --</option>
                                <option value="VIP">Khách VIP</option>
                                <option value="Member">Thành viên</option>
                                <option value="Normal">Khách thường</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label>
                                Danh mục áp dụng
                            </label>
                            <select id="CategoryId" class="select form-control">
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label>Ngày bắt đầu</label>
                            <input type="datetime-local" class="form-control" id="StartDate" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label>Ngày kết thúc</label>
                            <input type="datetime-local" class="form-control" id="EndDate" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label>Độ ưu tiên (Cao xếp trên)</label>
                            <input type="number" class="form-control" id="Priority" value="1" />
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-center mt-3">
                        <div class="form-check form-switch ms-2">
                            <input class="form-check-input" type="checkbox" id="IsActive" checked>
                            <label class="form-check-label fw-bold" for="IsActive">Kích hoạt</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary" id="btnSave">Lưu lại</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let tbl;

        function toInputDate(jsonDateString) {
            if (!jsonDateString) return '';
            let milliseconds;
            if (typeof jsonDateString === 'string' && jsonDateString.includes('/Date')) {
                const match = jsonDateString.match(/\/Date\( *([+-]?\d+) *\)\/?/);
                if (!match) return '';
                milliseconds = parseInt(match[1], 10);
            } else {
                milliseconds = new Date(jsonDateString).getTime();
            }
            if (isNaN(milliseconds) || (milliseconds < 0 && milliseconds < -62000000000000)) return '';

            const date = new Date(milliseconds);
            const pad = (n) => String(n).padStart(2, '0');
            return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
        }

        $(function () {
            // -- 1. Nạp danh mục sản phẩm ngay khi trang load --
            loadCategories();

            // -- Helpers --
            const formatCurrency = (val) => new Intl.NumberFormat('vi-VN').format(val);

            const formatDate = (d) => {
                if (!d) return '';
                const dateVal = typeof d === 'string' && d.includes('/Date')
                    ? parseInt(d.match(/\d+/)[0])
                    : new Date(d).getTime();
                return new Date(dateVal).toLocaleDateString('vi-VN');
            };

            // -- DataTable --
            if ($.fn.DataTable.isDataTable('#tblPromotions')) $('#tblPromotions').DataTable().destroy();

            $.extend(true, $.fn.dataTable.defaults, {
                dom: 't<"bottom_controls"lp>',
                language: {
                    search: "",
                    searchPlaceholder: "Search...",
                    info: "",
                    infoEmpty: "",
                    infoFiltered: "",
                },
            });


            tbl = $('#tblPromotions').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: '/Admin/Promotion/GetAllPromotion',
                    type: 'GET',
                    dataSrc: 'data'
                },
                columns: [
                    {
                        data: 'PromotionId', className: 'text-center', orderable: false,
                        render: (data) => `
                                <label class="checkboxs">
                                    <input type="checkbox" class="row-select" value="${data}" data-id="${data}" />
                                    <span class="checkmarks"></span>
                                </label>`
                    },
                    { data: 'Name', render: (d) => `<span class="fw-bold text-dark">${d}</span>` },
                    {
                        data: null,
                        render: (d) => d.DiscountType === 'Percent'
                            ? `<span class="badge bg-info text-white">-${d.DiscountValue}%</span>`
                            : `<span class="text-primary fw-bold">-${formatCurrency(d.DiscountValue)} đ</span>`
                    },
                    {
                        data: null,
                        render: (d) => {
                            let cat = d.CategoryId ? `Danh mục: <b>${d.CategoryName || d.CategoryId}</b>` : 'Toàn bộ cửa hàng';
                            let cus = d.CustomerType ? `Khách: ${d.CustomerType}` : 'Mọi khách hàng';
                            return `<small class="d-block text-muted">${cat}</small><small class="d-block text-muted">${cus}</small>`;
                        }
                    },
                    { data: null, render: (d) => `<small>${formatDate(d.StartDate)} - ${formatDate(d.EndDate)}</small>` },
                    { data: 'Priority', className: 'text-center' },
                    {
                        data: 'IsActive', className: 'text-center',
                        render: (d) => d ? '<span class="status-indicator active"></span>' : '<span class="status-indicator inactive"></span>'
                    },
                    {
                        data: null, className: 'text-end', orderable: false,
                        render: (d) => {
                            const safeJson = JSON.stringify(d).replace(/'/g, "&apos;").replace(/"/g, "&quot;");
                            return `
                                    <a class="me-3 btn-view" href="javascript:void(0);" data-obj='${safeJson}'><img src="/assets/img/icons/eye.svg"></a>
                                    <a class="me-3 btn-edit" href="javascript:void(0);" data-obj='${safeJson}'><img src="/assets/img/icons/edit.svg"></a>
                                    <a class="btn-delete" href="javascript:void(0);" data-id="${d.PromotionId}"><img src="/assets/img/icons/delete.svg"></a>`;
                        }
                    }
                ],
                order: [[5, 'desc']]
            });

            // -- Events --
            $('#btnAdd').click(() => {
                resetForm();
                toggleModal(false);
                $('#modalTitle').text('Thêm khuyến mãi mới');
                $('#modalInput').modal('show');
            });

            $(document).on('click', '.btn-view', function () {
                const d = $(this).data('obj');
                fillForm(d);
                toggleModal(true); // Readonly
                $('#modalTitle').text('Chi tiết chương trình');
                $('#modalInput').modal('show');
            });

            $(document).on('click', '.btn-edit', function () {
                const d = $(this).data('obj');
                fillForm(d);
                toggleModal(false); // Editable
                $('#modalTitle').text('Cập nhật khuyến mãi');
                $('#modalInput').modal('show');
            });

            $('#btnSave').click(async () => {
                const dto = {
                    PromotionId: $('#PromotionId').val(),
                    Name: $('#Name').val()?.trim(),
                    DiscountType: $('#DiscountType').val(),
                    DiscountValue: $('#DiscountValue').val(),
                    CategoryId: $('#CategoryId').val() || null,
                    CustomerType: $('#CustomerType').val() || null,
                    StartDate: $('#StartDate').val(),
                    EndDate: $('#EndDate').val(),
                    Priority: $('#Priority').val(),
                    IsActive: $('#IsActive').is(':checked'),
                };

                if (!dto.Name) return Swal.fire('Lỗi', 'Vui lòng nhập tên chương trình', 'warning');

                Swal.showLoading();
                try {
                    const url = dto.PromotionId != 0 ? '/Admin/Promotion/UpdatePromotion' : '/Admin/Promotion/CreatePromotion';
                    const res = await $.post(url, dto);
                    if (res.success) {
                        $('#modalInput').modal('hide');
                        tbl.ajax.reload(null, false);
                        Swal.fire({ icon: 'success', title: 'Đã lưu', timer: 1000, showConfirmButton: false });
                    } else {
                        Swal.fire('Lỗi', res.message || 'Lưu thất bại', 'error');
                    }
                } catch {
                    Swal.fire('Lỗi', 'Lỗi kết nối hệ thống', 'error');
                }
            });

            $(document).on('click', '.btn-delete', function () {
                const id = $(this).data('id');
                Swal.fire({
                    title: 'Xóa chương trình?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Xóa', cancelButtonText: 'Hủy'
                }).then(async (r) => {
                    if (r.isConfirmed) {
                        await $.post('/Admin/Promotion/DeletePromotion', { id: id });
                        tbl.ajax.reload(null, false);
                        Swal.fire({ icon: 'success', title: 'Đã xóa', timer: 1000, showConfirmButton: false });
                    }
                });
            });
        });

        // -- Hàm tách biệt --

        function loadCategories() {
            $.ajax({
                url: '/Admin/Product/GetAllProductCategory',
                type: 'GET',
                success: function (res) {
                    const $selects = $('#ddlCategory, #ddlCategoryFilter');

                    let options = '<option value="">-- Tất cả danh mục --</option>';

                    if (res.data && res.data.length > 0) {
                        options += res.data.map(item =>
                            `<option value="${item.CategoryId}">${item.Name}</option>`
                        ).join('');
                    }

                    $selects.html(options);
                },
                error: function () {
                    $('#ddlCategory, #ddlCategoryFilter').html('<option value="">Lỗi tải danh mục</option>');
                }
            });
        }
        function fillForm(d) {
            $('#PromotionId').val(d.PromotionId);
            $('#Name').val(d.Name);
            $('#DiscountType').val(d.DiscountType);
            $('#DiscountValue').val(d.DiscountValue);
            $('#CategoryId').val(d.CategoryId).trigger('change');

            $('#CustomerType').val(d.CustomerType).trigger('change');
            $('#StartDate').val(toInputDate(d.StartDate));
            $('#EndDate').val(toInputDate(d.EndDate));
            $('#Priority').val(d.Priority);
            $('#IsActive').prop('checked', d.IsActive);
        }

        function resetForm() {
            $('#PromotionId').val(0);
            $('#Name').val('');
            $('#DiscountValue').val('');
            $('#CategoryId').val('').trigger("change"); 
            $('#CustomerType').val('').trigger("change");
            $('#StartDate').val('');
            $('#EndDate').val('');
            $('#Priority').val(1);
            $('#IsActive').prop('checked', true);
        }

        function toggleModal(isReadOnly) {
            const $m = $('#modalInput');
            $m.find('input, select, textarea').prop('readonly', isReadOnly);
            $m.find('select, input[type="checkbox"]').prop('disabled', isReadOnly);
            isReadOnly ? $('#btnSave').hide() : $('#btnSave').show();
        }
    </script>
}

@section Styles {
    <style>
        .status-indicator {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

            .status-indicator.active {
                background-color: #28c76f;
                box-shadow: 0 0 5px #28c76f;
            }

            .status-indicator.inactive {
                background-color: #ea5455;
            }

        .dropdown-item {
            cursor: pointer;
        }
    </style>
}