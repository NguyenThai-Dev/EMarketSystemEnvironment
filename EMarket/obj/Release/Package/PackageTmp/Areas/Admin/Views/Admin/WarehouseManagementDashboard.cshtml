@{
    ViewBag.Title = "Warehouse Command Center";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content container-fluid">

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 mt-3">
            <div>
                <h3 class="fw-bold text-dark display-6" style="font-size: 1.75rem;">
                    <i class="fas fa-warehouse me-2 text-muted opacity-50"></i>Trung Tâm Kho Vận
                </h3>
                <span class="text-muted fs-7">Giám sát hiệu suất vận hành theo thời gian thực</span>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-2">
                <div class="row g-2 align-items-center">

                    <div class="col-lg-8">
                        <div class="d-flex flex-wrap gap-2 align-items-center">

                            <div class="input-group input-group-sm w-auto" style="min-width: 200px;">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-building text-muted"></i></span>
                                <select id="branchSelect" class="form-select border-0 bg-light fw-bold" style="cursor: pointer;">
                                    <option value="">-- Tất cả Chi Nhánh --</option>
                                </select>
                            </div>

                            <div class="d-none d-md-block text-muted opacity-25"><i class="fas fa-chevron-right"></i></div>

                            <div class="input-group input-group-sm w-auto" style="min-width: 200px;">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-dolly text-muted"></i></span>
                                <select id="warehouseSelect" class="form-select border-0 bg-light fw-bold text-dark" style="cursor: pointer;">
                                    <option value="">-- Tất cả Kho --</option>
                                </select>
                            </div>

                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="d-flex justify-content-lg-end">
                            <div class="input-group input-group-sm w-auto">
                                <span class="input-group-text bg-white border-0 fw-bold text-muted text-uppercase fs-7">Thời gian:</span>
                                <select id="timeRangeSelect" class="form-select border-0 bg-light fw-bold text-primary rounded-pill ps-3" style="cursor: pointer;">
                                    <option value="7" selected>7 ngày qua</option>
                                    <option value="15">15 ngày qua</option>
                                    <option value="30">30 ngày qua</option>
                                    <option value="90">90 ngày qua</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card card-hover gradient-money h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-white-50 fw-bold text-uppercase fs-7">Giá trị tồn kho</span>
                                <h3 id="whTotalValue" class="text-white mt-2 mb-0 fw-bold">0 ₫</h3>
                            </div>
                            <div class="icon-box bg-white bg-opacity-25 rounded-3 text-center">
                                <i class="fas fa-coins text-white fs-4 lh-base mt-2"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <span class="badge bg-white text-success bg-opacity-75"><i class="fas fa-box"></i> <span id="whTotalSku">0</span> SKUs</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card card-hover gradient-task h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-white-50 fw-bold text-uppercase fs-7">Đơn chờ xuất</span>
                                <h3 id="whPendingOrders" class="text-white mt-2 mb-0 fw-bold">0</h3>
                            </div>
                            <div class="icon-box bg-white bg-opacity-25 rounded-3 text-center">
                                <i class="fas fa-truck-loading text-white fs-4 lh-base mt-2"></i>
                            </div>
                        </div>
                        <div class="mt-3 text-white-50 fs-7">
                            Cần xử lý ngay trong ngày
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card card-hover gradient-alert h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-white-50 fw-bold text-uppercase fs-7">Sắp hết hàng</span>
                                <h3 id="whLowStock" class="text-white mt-2 mb-0 fw-bold">0</h3>
                            </div>
                            <div class="icon-box bg-white bg-opacity-25 rounded-3 text-center">
                                <i class="fas fa-exclamation-triangle text-white fs-4 lh-base mt-2"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <a href="@Url.Action("SupplierDebtAndPayment", "Supplier", new { area = "Admin" })" class="text-white fs-7 text-decoration-underline">Xem danh sách nhập hàng &rarr;</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-sm-6 col-12">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-2 d-flex align-items-center justify-content-between">
                        <div class="ps-3">
                            <span class="text-muted fw-bold text-uppercase fs-7">Sức chứa kho</span>
                            <h4 class="text-dark mt-1 mb-0 fw-bold" id="whCapacityText">0%</h4>
                            <small class="text-muted">Trạng thái: <span id="whCapacityStatus" class="fw-bold">Ổn định</span></small>
                        </div>
                        <div id="capacityChart" style="min-width: 100px;"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-lg-8 d-flex">
                <div class="card flex-fill w-100 shadow-sm border-0">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="card-title fw-bold">Biến động Hàng hóa</h5>
                        <small class="text-muted">So sánh Nhập (Inbound) và Xuất (Outbound)</small>
                    </div>
                    <div class="card-body">
                        <div id="stockMovementChart"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 d-flex">
                <div class="card flex-fill w-100 shadow-sm border-0">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <h5 class="card-title fw-bold">Phân bổ Tồn kho</h5>
                        <small class="text-muted">Theo danh mục sản phẩm</small>
                    </div>
                    <div class="card-body d-flex justify-content-center align-items-center">
                        <div id="categoryPieChart" class="w-100"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-lg-8">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header bg-white border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title fw-bold">Hoạt động kho gần đây</h5>
                    </div>
                    <div class="card-body px-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="tblMovements">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Sản phẩm</th>
                                        <th>Loại giao dịch</th>
                                        <th>Số lượng</th>
                                        <th>Người thực hiện</th>
                                        <th class="text-end pe-4">Thời gian</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card h-100 border-warning border-2 border-top-0 border-end-0 border-bottom-0 shadow-sm">
                    <div class="card-header bg-white border-0 pt-4 pb-0">
                        <div class="d-flex align-items-center">
                            <div class="bg-warning bg-opacity-10 p-2 rounded-circle me-3">
                                <i class="fas fa-bell text-warning"></i>
                            </div>
                            <div>
                                <h5 class="card-title fw-bold mb-0">Cần nhập hàng</h5>
                                <small class="text-danger">Tồn kho dưới mức tối thiểu</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush mt-3" id="listLowStock"></div>
                    </div>
                    <div class="card-footer bg-white border-0 text-center pb-3">
                        <button id="directedLink" class="btn btn-outline-warning btn-sm w-100 fw-bold">Tạo phiếu nhập tự động</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Styles {
    <style>
        /* CSS cho thanh Filter mới */
        .form-select:focus {
            box-shadow: none;
            border-color: #dee2e6;
            background-color: #fff;
        }

        /* Tùy chỉnh input group để nhìn liền mạch */
        .input-group-text {
            color: #6c757d;
        }

        /* Giữ nguyên các CSS cũ */
        .gradient-money {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            border: none;
        }

        .gradient-task {
            background: linear-gradient(135deg, #ff9966 0%, #ff5e62 100%);
            border: none;
        }

        .gradient-alert {
            background: linear-gradient(135deg, #cb2d3e 0%, #ef473a 100%);
            border: none;
        }

        .icon-box {
            width: 45px;
            height: 45px;
        }

        .fs-7 {
            font-size: 0.75rem;
        }

        /* 1. Nhập kho hoặc Khách trả hàng (Tăng kho - Màu xanh lá) */
        .badge-in, .badge-return {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }

        /* 2. Xuất kho hoặc Bán hàng (Giảm kho - Màu đỏ) */
        .badge-out, .badge-sale {
            background-color: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
        }

        /* 3. Điều chỉnh kho - Kiểm kê/Hao hụt (Thường dùng màu vàng/cam) */
        .badge-adjustment {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
        }

        /* 4. Điều chuyển kho nội bộ (Màu xanh dương hoặc tím) */
        .badge-internal {
            background-color: #cff4fc;
            color: #055160;
            border: 1px solid #b6effb;
        }

        /* Class chung để định dạng badge cho đẹp */
        .badge-stock {
            display: inline-block;
            padding: 0.35em 0.65em;
            font-size: 0.75em;
            font-weight: 700;
            line-height: 1;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 50rem; /* Bo tròn hoàn toàn */
            text-transform: uppercase;
        }

        .low-stock-item {
            transition: background 0.2s;
            border-left: 3px solid transparent;
        }

            .low-stock-item:hover {
                background-color: #fffcf5;
                border-left: 3px solid #ffc107;
            }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        // Global Chart instances
        let capacityChart, movementChart, categoryChart, currentUserBranchId = 0;

        $(document).ready(function () {

            // 1. Load Dropdowns trước, sau đó mới load Data
            initDashboard();

            // 2. Bắt sự kiện thay đổi Branch
            $('#branchSelect').on('change', function () {
                const branchId = $(this).val();

                // Load lại Warehouses theo Branch mới
                loadDropdowns(branchId, true); // true = chỉ reload warehouse

                // Load lại Dashboard data
                loadWarehouseData();
            });

            // 3. Bắt sự kiện thay đổi Warehouse
            $('#warehouseSelect').on('change', function () {
                loadWarehouseData();
            });

            // 4. Bắt sự kiện thay đổi Time Range
            $('#timeRangeSelect').on('change', function () {
                loadWarehouseData();
            });

            $('#directedLink').on('click', function () {
                window.location.href = '@Url.Action("SupplierDebtAndPayment", "Supplier", new { area = "Admin" })';
            });

        });

        // --- INIT FUNCTION ---
        async function initDashboard() {
            await getCurrentUserBranch();
            await loadDropdowns(currentUserBranchId, false);
            loadWarehouseData();
        }

        async function getCurrentUserBranch() {
            try {
                const resp = await $.ajax({
                    url: '/Admin/Login/GetCurrentUser',
                    type: 'GET'
                });

                if (resp.success) {
                    currentUserBranchId = resp.data.BranchId;
                }
            } catch (error) {
                console.error("Lỗi khi lấy thông tin user:", error);
            }
        }

        // --- LOAD DROPDOWNS (BRANCH & WAREHOUSE) ---
        async function loadDropdowns(branchId, onlyWarehouse = false) {
            try {
                const res = await $.ajax({
                    url: '/Admin/Admin/LoadDropdowns',
                    type: 'GET',
                    data: { branchId: branchId }
                });

                const branches = res.branches || [];
                const warehouses = res.warehouses || [];

                if (!onlyWarehouse) {
                    const $branchSelect = $('#branchSelect');
                    const currentVal = $branchSelect.val(); 

                    $branchSelect.empty();
                    $branchSelect.append('<option value="">-- Tất cả Chi Nhánh --</option>');

                    branches.forEach(b => {
                        $branchSelect.append(`<option value="${b.BranchId}">${b.Name}</option>`);
                    });

                    if (currentUserBranchId != 0) {
                        $branchSelect.val(currentUserBranchId);
                    }
                    else if (currentVal) {
                        $branchSelect.val(currentVal);
                    }
                }

                const $whSelect = $('#warehouseSelect');
                $whSelect.empty();
                $whSelect.append('<option value="">-- Tất cả Kho --</option>');

                warehouses.forEach(w => {
                    $whSelect.append(`<option value="${w.WarehouseId}">${w.Name}</option>`);
                });
            } catch (err) {
                console.error("Lỗi load dropdown:", err);
            }
        }

        // --- MAIN DATA LOADING ---
        async function loadWarehouseData() {
            try {
                // Lấy giá trị từ các bộ lọc
                const dayBacks = $('#timeRangeSelect').val();
                const branchId = $('#branchSelect').val();
                const warehouseId = $('#warehouseSelect').val();

                const res = await $.ajax({
                    url: '/Admin/Admin/GetWarehouseDashboard',
                    type: 'GET',
                    data: {
                        dayBacks: dayBacks,
                        branchId: branchId,      // Truyền thêm branchId
                        warehouseId: warehouseId // Truyền thêm warehouseId
                    }
                });

                if (!res.success) return;

                const realData = res.data;
                const currencyFormatter = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });

                // Mapping Data
                const kpi = {
                    totalValue: currencyFormatter.format(realData.Kpi.TotalInventoryValue),
                    totalSku: realData.Kpi.TotalSku,
                    pendingOrders: realData.Kpi.PendingOrders,
                    lowStock: realData.Kpi.LowStockCount,
                    capacity: Math.round(realData.Kpi.CapacityPercent)
                };

                const charts = {
                    movement: {
                        labels: realData.Charts.Movement.Labels,
                        inbound: realData.Charts.Movement.Inbound,
                        outbound: realData.Charts.Movement.Outbound
                    },
                    categories: {
                        labels: realData.Charts.Categories.Labels,
                        counts: realData.Charts.Categories.Counts
                    }
                };

                const lists = {
                    movements: realData.Lists.Movements.map(m => ({
                        product: m.Product, type: m.Type, qty: m.Qty, user: m.User, time: m.Time
                    })),
                    lowStock: realData.Lists.LowStock.map(l => ({
                        name: l.Name, current: l.Current, min: l.Min
                    }))
                };

                // Render UI
                renderWhKpi(kpi);
                renderMovementChart(charts.movement);
                renderCategoryChart(charts.categories);
                renderMovementTable(lists.movements);
                renderLowStockList(lists.lowStock);

            } catch (err) {
                console.error('Error loading warehouse data:', err);
            }
        }

        // --- RENDER FUNCTIONS (Same as before) ---
        function renderWhKpi(data) {
            $('#whTotalValue').text(data.totalValue);
            $('#whTotalSku').text(data.totalSku);
            $('#whPendingOrders').text(data.pendingOrders);
            $('#whLowStock').text(data.lowStock);
            $('#whCapacityText').text(data.capacity + '%');

            const statusEl = $('#whCapacityStatus');
            statusEl.removeClass('text-danger text-warning text-success');
            if (data.capacity > 90) { statusEl.text('Quá tải').addClass('text-danger'); }
            else if (data.capacity > 70) { statusEl.text('Cao').addClass('text-warning'); }
            else { statusEl.text('Tốt').addClass('text-success'); }

            var options = {
                series: [data.capacity],
                chart: { height: 120, type: 'radialBar' },
                plotOptions: {
                    radialBar: {
                        hollow: { size: '50%' },
                        dataLabels: { show: false },
                        track: { background: '#f2f2f2' }
                    }
                },
                colors: [data.capacity > 85 ? '#dc3545' : '#0d6efd'],
                stroke: { lineCap: 'round' },
            };
            if (capacityChart) capacityChart.destroy();
            capacityChart = new ApexCharts(document.querySelector("#capacityChart"), options);
            capacityChart.render();
        }

        function renderMovementChart(data) {
            var options = {
                series: [{ name: 'Nhập kho', type: 'column', data: data.inbound }, { name: 'Xuất kho', type: 'area', data: data.outbound }],
                chart: { height: 350, type: 'line', toolbar: { show: false } },
                stroke: { width: [0, 3], curve: 'smooth' },
                plotOptions: { bar: { columnWidth: '30%', borderRadius: 4 } },
                colors: ['#0d6efd', '#20c997'],
                labels: data.labels,
                xaxis: { type: 'category' },
                legend: { position: 'top' }
            };
            if (movementChart) movementChart.destroy();
            movementChart = new ApexCharts(document.querySelector("#stockMovementChart"), options);
            movementChart.render();
        }

        function renderCategoryChart(data) {
            var options = {
                series: data.counts,
                labels: data.labels,
                chart: { type: 'donut', height: 250 },
                legend: { position: 'bottom' },
                dataLabels: { enabled: false },
                colors: ['#6610f2', '#fd7e14', '#20c997', '#0dcaf0'],
                plotOptions: { pie: { donut: { size: '60%' } } }
            };
            if (categoryChart) categoryChart.destroy();
            categoryChart = new ApexCharts(document.querySelector("#categoryPieChart"), options);
            categoryChart.render();
        }

        function renderMovementTable(list) {
            const $tbody = $('#tblMovements tbody');
            $tbody.empty();
            if (!list || list.length === 0) { $tbody.append('<tr><td colspan="5" class="text-center text-muted">Không có dữ liệu</td></tr>'); return; }
            list.forEach(item => {
                // Cấu hình hiển thị cho từng loại giao dịch
                const config = {
                    'SALE': { class: 'badge-out', icon: 'fa-arrow-up', label: 'Xuất bán' },
                    'RETURN': { class: 'badge-in', icon: 'fa-arrow-down', label: 'Trả hàng' },
                    'ADJUSTMENT': { class: 'badge-adjustment', icon: 'fa-sync-alt', label: 'Kiểm kê' },
                    'INTERNAL': { class: 'badge-internal', icon: 'fa-exchange-alt', label: 'Chuyển kho' }
                };

                // Lấy config theo type (mặc định là OUT nếu không khớp)
                const typeKey = item.type.toUpperCase();
                const ui = config[typeKey] || { class: 'bg-secondary', icon: 'fa-question', label: item.type };

                let badgeHtml = `<span class="badge ${ui.class} border border-opacity-10">
                        <i class="fas ${ui.icon} me-1"></i>${ui.label}
                     </span>`;

                $tbody.append(`
        <tr>
            <td class="ps-4 fw-bold">${item.product}</td>
            <td>${badgeHtml}</td>
            <td class="fw-bold text-center">${item.qty > 0 ? '+' + item.qty : item.qty}</td>
            <td class="text-muted small">${item.user}</td>
            <td class="text-end pe-4 text-muted small">${item.time}</td>
        </tr>
    `);
            });
        }

        function renderLowStockList(list) {
            const $div = $('#listLowStock');
            $div.empty();
            if (!list || list.length === 0) { $div.append('<div class="text-center text-muted p-3">Tồn kho an toàn</div>'); return; }
            list.forEach(item => {
                let percent = Math.min((item.current / item.min) * 100, 100);
                let barColor = percent < 20 ? 'bg-danger' : 'bg-warning';
                $div.append(`<div class="list-group-item low-stock-item px-3 py-3 border-0 border-bottom"><div class="d-flex justify-content-between mb-1"><span class="fw-bold text-dark">${item.name}</span><small class="text-danger fw-bold">${item.current} / ${item.min}</small></div><div class="progress" style="height: 6px;"><div class="progress-bar ${barColor}" style="width: ${percent}%"></div></div></div>`);
            });
        }
    </script>
}