@model EMarket.Modules.SystemConfigModule.DTOs.SystemConfigViewModel
@{
    ViewBag.Title = "Cấu hình Hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-wrapper">
    <div class="content">
        <div class="page-header">
            <div class="page-title">
                <h4>Cấu hình Hệ thống</h4>
                <h6>Quản lý các tham số vận hành toàn hệ thống</h6>
            </div>
            <div class="page-btn">
                <button class="btn btn-submit" id="btnSaveAll">
                    <i data-feather="save" class="me-1"></i> Lưu thay đổi
                </button>
            </div>
        </div>

        <form id="frmConfig">

            <div class="row">
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">🌐 Thông tin chung & Tài chính</h5>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label>Base URL (Tên miền)</label>
                                <input type="text" class="form-control" name="App_Base_Url" value="@Model.AppBaseUrl">
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <div class="form-group">
                                        <label>Thuế VAT (%)</label>
                                        <input type="text" class="form-control" name="EMarket_VAT" value="@Model.VAT">
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-group">
                                        <label>Ngân hàng thụ hưởng</label>
                                        <input type="text" class="form-control" name="EMarket_Bank_ID" value="@Model.BankID" placeholder="VD: VCB, MB">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Số tài khoản nhận tiền</label>
                                <input type="text" class="form-control" name="EMarket_Bank_Num" value="@Model.BankNum">
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">💎 Chính sách Thành viên</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-6">
                                    <div class="form-group">
                                        <label>Giảm giá VIP (%)</label>
                                        <input type="number" class="form-control" name="VIP_Discount" value="@Model.VipDiscount">
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-group">
                                        <label>Giảm giá Member (%)</label>
                                        <input type="number" class="form-control" name="Member_Discount" value="@Model.MemberDiscount">
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-group">
                                        <label>Tỉ lệ đổi điểm khi thanh toán</label>
                                        <input type="number" class="form-control" name="EMarket_Point_Exchange_Rate" value="@Model.PointExchangeRate">
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-group">
                                        <label>Tỉ lệ nhận điểm khi mua hàng</label>
                                        <input type="number" class="form-control" name="EMarket_Point_Earned_Rate" value="@Model.PointEarnedRate">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="card-title">📧 Cấu hình Email</h5>
                            <div class="status-toggle d-flex justify-content-between align-items-center">
                                <input type="checkbox" id="email_toggle" class="check" name="Notify_Email_Enabled" value="true" @(Model.EmailEnabled ? "checked" : "")>
                                <label for="email_toggle" class="checktoggle">checkbox</label>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label>Mail Host (SMTP)</label>
                                <input type="text" class="form-control" name="Email_Username" value="@Model.MailHost">
                            </div>
                            <div class="form-group">
                                <label>Tên hiển thị (Display Name)</label>
                                <input type="text" class="form-control" name="Email_DisplayName" value="@Model.MailDisplayName">
                            </div>
                            <div class="form-group">
                                <label>Mật khẩu ứng dụng</label>
                                <div class="pass-group">
                                    <input type="password" class="form-control" name="Email_AppPassword" value="@Model.MailPassword">
                                    <span class="fas toggle-password fa-eye-slash"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="card-title">✈️ Telegram Notification</h5>
                            <div class="status-toggle d-flex justify-content-between align-items-center">
                                <input type="checkbox" id="tele_toggle" class="check" name="Notify_Telegram_Enabled" value="true" @(Model.TelegramEnabled ? "checked" : "")>
                                <label for="tele_toggle" class="checktoggle">checkbox</label>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label>Bot Token</label>
                                <div class="pass-group">
                                    <input type="password" class="form-control" name="Telegram_Bot_Token" value="@Model.TelegramToken">
                                    <span class="fas toggle-password fa-eye-slash"></span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Chat ID (Nhóm nhận tin)</label>
                                <input type="text" class="form-control" name="Telegram_Group_Id" value="@Model.TelegramChatId">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
    $(document).ready(function() {
        $(document).on('click', '.toggle-password', function () {
            const $card = $(this).closest('.card');
            const isEnabled = $card.find('.status-toggle input[type="checkbox"]').is(':checked');

            if (!isEnabled) return;

            const $icon = $(this);
            const $input = $icon.closest('.pass-group').find('input');

            const isPassword = $input.attr('type') === 'password';
            $input.attr('type', isPassword ? 'text' : 'password');
            $icon.toggleClass('fa-eye fa-eye-slash');
        });

        // Save All Configs
        $('#btnSaveAll').click(function() {
            Swal.fire({
                title: 'Lưu cấu hình?',
                text: "Các thay đổi sẽ có hiệu lực ngay lập tức!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ff9b44',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Lưu ngay'
            }).then((result) => {
                if (result.isConfirmed) {
                    saveConfigs();
                }
            });
        });

        function saveConfigs() {
            var configs = [];

            // Duyệt qua tất cả input trong form để gom dữ liệu
            $('#frmConfig input').each(function() {
                var key = $(this).attr('name');
                if(!key) return; // Bỏ qua input không có name (như token)

                var val = $(this).val();

                // Xử lý riêng cho Checkbox (Toggle)
                if($(this).attr('type') === 'checkbox') {
                    val = $(this).is(':checked') ? "true" : "false";
                }

                configs.push({ Key: key, Value: val });
            });

            $.ajax({
                url: '/Admin/SystemConfig/UpdateConfig',
                type: 'POST',
                data: {
                    configs: configs
                },
                success: function(res) {
                    if(res.success) {
                        Swal.fire('Thành công!', res.message, 'success');
                    } else {
                        Swal.fire('Lỗi!', res.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('Lỗi!', 'Không thể kết nối đến server.', 'error');
                }
            });
        }
    });
    </script>
}