          <EntitySet Name="v_AI_Customer_Analytics" EntityType="Self.v_AI_Customer_Analytics" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [v_AI_Customer_Analytics].[customer_id] AS [customer_id], 
    [v_AI_Customer_Analytics].[customer_type] AS [customer_type], 
    [v_AI_Customer_Analytics].[points_balance] AS [points_balance], 
    [v_AI_Customer_Analytics].[masked_name] AS [masked_name]
    FROM [dbo].[v_AI_Customer_Analytics] AS [v_AI_Customer_Analytics]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="v_AI_Master_Input" EntityType="Self.v_AI_Master_Input" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [v_AI_Master_Input].[ds] AS [ds], 
    [v_AI_Master_Input].[branch_id] AS [branch_id], 
    [v_AI_Master_Input].[product_id] AS [product_id], 
    [v_AI_Master_Input].[y] AS [y], 
    [v_AI_Master_Input].[product_name] AS [product_name], 
